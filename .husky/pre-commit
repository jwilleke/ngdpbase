npx lint-staged

# Docs coverage (#660) — fails only on hard errors:
#   - source file in src/{managers,plugins,providers}/ not listed in
#     docs/Developer-Documentation.md
#   - doc file's `code:` frontmatter points to a non-existent source file
# Warnings (missing doc pages, missing frontmatter) are reported but do
# not block the commit. See docs/DOCUMENTATION-STANDARDS.md.
npm run lint:docs --silent

# Docs index drift (#660) — Developer-Documentation.md is regenerated from
# frontmatter by `npm run docs:index`. If a doc was added/edited but the
# index wasn't regenerated, this check fails and tells the user to run
# the regenerator. Cheap (~200ms).
npm run docs:index:check --silent

# CSRF client-fetch guard (#727) — fails the commit if any client-surface
# file issues a state-changing fetch() without the CSRF token (#663
# middleware rejects those with an opaque text/plain 403). Genuine
# server-side fetches can opt out with `// csrf-guard-ignore`. Cheap.
npm run lint:csrf --silent

# Outbound HTTP boundary (#1139) — fails the commit if anything outside
# src/http/ opens a path to the network: a bare fetch(), an HTTP client
# library, a client symbol or call on http/https/net, or any use of dns.
# #1133 was an SSRF found because nothing declared where network access was
# allowed to originate; src/http/ closed that, and this keeps it closed.
# Matched on the symbol, never the path — listening (createServer) is inbound
# and allowed, so no file is ever exempt. Cheap.
npm run lint:http --silent
