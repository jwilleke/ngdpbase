# Environment Configuration Template
# Copy this file to .env and fill in your values
# Never commit .env - it should only exist locally

# Project Information
PROJECT_NAME="ngdpbase"
PROJECT_REPOSITORY="https://github.com/jwilleke/ngdpbase"

# Run-as user (#1693) — REQUIRED. The server refuses to start without these and
# never runs as root. Started as root (a container), it gives FAST_STORAGE to
# this user and switches to it; started as anyone else (bare metal, Compose
# `user:`, Kubernetes runAsUser), it must already be this user. On bare metal
# set them to your own ids: `id -u` and `id -g` (macOS: typically 501 and 20).
PUID=1000
PGID=1000

# Application
NODE_ENV=development
# Default port for ngdpbase (matches Docker/k8s configuration)
PORT=3000

# PM2 Process Management
# Maximum memory before PM2 restarts the process.
# Large wikis (14K+ pages) spike to ~3GB during search index rebuilds.
# Set higher if you see unexpected restarts in PM2 logs.
# PM2_MAX_MEMORY=4G

# Storage Locations
# Two-tier storage splits operational data from bulk content:
#
# FAST_STORAGE — operational data: sessions, logs, users, search-index, config, .env
#   Per-instance .env lives at ${FAST_STORAGE}/.env
#   Custom config lives at ${FAST_STORAGE}/config/app-custom-config.json
#
# SLOW_STORAGE — bulk content: pages, attachments, backups
#   Can be a NAS, cold-storage mount, or large cheap drive
#
# For single-drive setups, set both to the same path (or leave as ./data default).
# Config values reference these as ${FAST_STORAGE}/sessions, ${SLOW_STORAGE}/pages, etc.
#
# Default (single drive):
FAST_STORAGE=./data
SLOW_STORAGE=./data
#
# Multi-drive example:
# FAST_STORAGE=/mnt/ssd/wiki/data
# SLOW_STORAGE=/mnt/nas/wiki/data

# Session secret (#1194)
# Signs the session cookie; anyone holding it can forge a signed-in session.
# It MUST be defined in .env. You do not have to write it: on first boot with
# it unset, ngdpbase generates one and appends it to ${FAST_STORAGE}/.env
# (created 0600). Set it here only to manage it yourself. Placeholder values
# from older docs are refused at boot; rotating it signs every user out.
#   NGDPBASE_SESSION_SECRET=$(openssl rand -base64 32)
# NGDPBASE_SESSION_SECRET=

# Credentials key (#1524)
# Signs every row of the credentials store (passkeys, verified email addresses)
# so a row written around the app is rejected. Generated on first boot into
# ${FAST_STORAGE}/.env like the session secret; set it here only to manage it
# yourself. Keep a copy: without it every passkey and verified email stops
# working until they are trusted again.
#   NGDPBASE_CREDENTIALS_KEY=$(openssl rand -base64 32)
# NGDPBASE_CREDENTIALS_KEY=

# Database key (#1536)
# SQLCipher key for ngdpbase.database.file when the sqlite provider is on.
# Never a config key. Unset: the database opens unencrypted and says so.
# NGDPBASE_DATABASE_KEY=

# Settings owned by the environment (ngdpbase.config.env-keys)
# Each overrides its config key and shows read-only on the admin screen.
# NGDPBASE_PORT=3000                 # ngdpbase.server.port
# NGDPBASE_HOST=0.0.0.0              # ngdpbase.server.host
# NGDPBASE_HOSTNAME=wiki.example.com # ngdpbase.hostname
# NGDPBASE_APP_NAME=ngdpbase         # ngdpbase.application-name
# NGDPBASE_BASE_URL=https://wiki.example.com  # ngdpbase.application.base-url

# System principal (#631)
# The name the server acts under at boot and from timers — retention purges,
# scheduled reindexes, page seeding. It appears in the audit log as the actor
# of that work. It is an identity, not an account: no login, no password, and
# the name is reserved so nobody can register it. It holds the roles listed in
# ngdpbase.system.roles (admin by default), evaluated by policy like anyone.
# REQUIRED: an instance with this unset refuses to boot and names the key.
# The Docker image bakes NGDPBASE_SYSTEM_USER=system as ENV; set it here for
# a direct install, or override the image value with -e / env: in a manifest.
# Pick a name that reads as the machine, not a person.
# NGDPBASE_SYSTEM_USER=system

# Legacy alias (deprecated — use FAST_STORAGE)
# INSTANCE_DATA_FOLDER=./data

# Instance Config File
# Name of the config file to load from ${FAST_STORAGE}/config/
# Default: app-custom-config.json
# INSTANCE_CONFIG_FILE=app-custom-config.json

# ─── Admin bootstrap password (required on a NEW install) ────────────────────
#
# Read on every launch path — ./server.sh sources it, and the app itself loads
# it at startup (src/bootstrap-env.ts), so it works in containers too. On
# Kubernetes put the file at <FAST_STORAGE>/.env on the persistent volume; no
# Secret and no manifest change needed.
# Password for the 'admin' account, applied ONLY on the first boot that finds
# an empty user store. ngdpbase ships no default: it used to create
# admin/admin123 and print that on the login page, which meant any unattended
# install was reachable with a credential published in the repository.
#
# A fresh install with this unset refuses to start and names the key. An
# instance that already has an admin never reads it, so upgrading does not
# require setting it.
#
# Change the password after first login; the startup banner nags until you do.
# NGDPBASE_ADMIN_PASSWORD=

# Demo addon shared account — OPTIONAL, only when ngdpbase.addons.demo.enabled
# is true. The addon ships 'admin123' for the read-only 'admindemo' account and
# prints it on the Welcome page, so nothing needs setting here: enabling the
# addon is the whole setup. Override only if you run a demo whose login you do
# not publish.
# NGDPBASE_DEMO_ADMIN_PASSWORD=
