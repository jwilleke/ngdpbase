      "encrypt": false,
      "shareMaxDays": 15,
      "page-badge": {
        "color": "bg-info",
        "label": "Journal",
        "title": "Journal entry"
      }
    },
    "capture": {
      "label": "capture",
      "description": "Pages made by the capture bookmarklet",
      "default": false,
      "source": "site",
      "enabled": false,
      "storageLocation": {
        "defaultstore": "pages/",
