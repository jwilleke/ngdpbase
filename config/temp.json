        "title": "Add-on page"
      }
    },
    "user-profile": {
      "label": "user-profile",
      "description": "User profile pages",
      "default": false,
      "source": "site",
      "enabled": false,
      "storageLocation": {
        "defaultstore": "pages/"
      },
      "page-badge": {
        "color": "bg-success",
        "label": "Profile",
        "title": "User profile page"
      }
    },
    "phr": {
      "label": "PHR",
      "description": "Personal health Records and files",
      "default": false,
