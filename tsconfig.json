{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* JavaScript Support - Allow JS files during migration */
    "allowJs": true,
    "checkJs": false,

    /* Emit - Compile src/ to dist/ with proper structure */
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": false,
    "importHelpers": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking - STRICT MODE ENABLED */
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Completeness */
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,

    /* Advanced */
    "resolveJsonModule": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/plugins/**/*.ts",
    "scripts/migrate-br-to-ncm.ts",
    "scripts/reset-admin-password.ts",
    "scripts/seed-e2e-test-data.ts",
    "scripts/migrate-user-pages-category.ts",
    "scripts/migrate-page-created.ts",
    "scripts/migrate-page-acl-to-frontmatter.ts",
    "scripts/migrate-private-field.ts",
    "scripts/migrate-vocabulary-slice1.ts",
    "scripts/migrate-vocabulary-store.ts",
    "scripts/reconcile-attachment-mentions.ts",
    "scripts/check-docs-coverage.ts",
    "scripts/migrate-docs-frontmatter.ts",
    "scripts/fix-doc-descriptions.ts",
    "scripts/generate-docs-index.ts",
    "scripts/check-csrf-fetch.ts",
    "scripts/create-addon.ts",
    "scripts/fix-page-markdown.ts",
    "scripts/audit-coverage.ts",
    "scripts/backfill-page-author.ts",
    "scripts/backfill-person-memberof.ts",
    "scripts/backfill-roles-from-users.ts",
    "scripts/check-addon-boundary.ts",
    "scripts/check-addon-load.ts",
    "scripts/check-context-discipline.ts",
    "scripts/check-http-boundary.ts",
    "scripts/check-lockfile-audit.ts",
    "scripts/check-page-door.ts",
    "scripts/check-permission-gates.ts",
    "scripts/check-permission-subject.ts",
    "scripts/generate-audit-docs.ts",
    "scripts/generate-permission-types.ts",
    "scripts/migrate-users-to-persons.ts",
    "scripts/repair-jspwiki-frontmatter.ts",
    "scripts/repair-required-pages-history.ts",
    "scripts/restart-audit-chain.ts",
    "scripts/strip-user-roles.ts",
    "scripts/verify-audit-chain.ts",
    "mcp-server.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.js",
    "**/*.test.ts",
    "**/__tests__/**"
  ],
  "references": [
    { "path": "./tsconfig.test.json" }
  ],
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext"
    }
  }
}
