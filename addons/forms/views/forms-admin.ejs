<%- include('header', { title: 'Forms Admin', currentUser }) %>

<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12 d-flex align-items-center justify-content-between mb-2">
      <h2 class="mb-0"><i class="fas fa-wpforms me-2"></i>Forms</h2>
      <a href="/addons/forms/builder/new" class="btn btn-success btn-sm">
        <i class="fas fa-plus me-1"></i>New Form
      </a>
    </div>
    <div class="col-12">
      <p class="text-muted">Manage form definitions and view submissions.</p>
    </div>
  </div>

  <% var flash = typeof query !== 'undefined' && query ? query.flash : undefined; %>
  <% if (flash === 'saved') { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-1"></i>Form definition saved.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } else if (flash === 'synced') { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-sync-alt me-1"></i>Form updated to the version its add-on ships.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } else if (flash === 'sync-edited') { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
      <i class="fas fa-lock me-1"></i>Not updated: this form was edited on this site. Use <strong>Replace my edits</strong> to take the shipped version anyway.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } else if (flash === 'deleted') { %>
    <div class="alert alert-info alert-dismissible fade show" role="alert">
      <i class="fas fa-trash me-1"></i>Form definition deleted.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (forms.length === 0) { %>
    <div class="alert alert-info">
      No form definitions found. Click <strong>New Form</strong> to create one.
    </div>
  <% } else { %>
    <div class="row">
      <% forms.forEach(function(form) { %>
        <div class="col-md-4 mb-4">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h5 class="card-title"><%= form.title %></h5>
              <p class="text-muted small mb-1"><code><%= form.id %></code></p>
              <% if (form.description) { %>
                <p class="card-text small"><%= form.description %></p>
              <% } %>
              <div class="d-flex gap-2 flex-wrap mt-2">
                <span class="badge bg-secondary"><%= form.fields.length %> fields</span>
                <span class="badge bg-<%= form.submissionCount > 0 ? 'primary' : 'light text-dark' %>">
                  <%= form.submissionCount %> submission<%= form.submissionCount !== 1 ? 's' : '' %>
                </span>
                <% if (form.handler) { %>
                  <span class="badge bg-info text-dark">handler: <%= form.handler %></span>
                <% } %>
                <% if (form.proxySubmission) { %>
                  <span class="badge bg-warning text-dark">proxy</span>
                <% } %>
                <% var shipped = form.shippedState; %>
                <% if (shipped) { %>
                  <span class="badge bg-light text-dark border">from <%= shipped.addon %></span>
                  <% if (shipped.status === 'outdated') { %>
                    <span class="badge bg-warning text-dark" data-shipped-status="outdated">update available</span>
                  <% } else if (shipped.status === 'locally-modified') { %>
                    <span class="badge bg-info text-dark" data-shipped-status="edited" title="Edited on this site: an update does not replace it unless you choose to">edited here<%= shipped.shippedChanged ? ' · update available' : '' %></span>
                  <% } else { %>
                    <span class="badge bg-light text-dark border" data-shipped-status="current">up to date</span>
                  <% } %>
                <% } %>
              </div>
            </div>
            <div class="card-footer bg-transparent d-flex gap-2 flex-wrap">
              <a href="/addons/forms/<%= encodeURIComponent(form.id) %>/submissions" class="btn btn-sm btn-outline-primary">
                View Submissions
              </a>
              <a href="/addons/forms/builder/<%= encodeURIComponent(form.id) %>" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-edit me-1"></i>Edit
              </a>
              <% if (shipped && shipped.status === 'outdated') { %>
                <form method="POST" action="/addons/forms/<%= encodeURIComponent(form.id) %>/sync" style="display:inline"
                  <% if (!shipped.stamped) { %>data-confirm="Update &quot;<%= form.title %>&quot; to the version <%= shipped.addon %> ships?&#10;&#10;This copy was saved before edits were tracked, so any change made to it in the form builder is replaced."<% } %>>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-primary" data-action="sync">
                    <i class="fas fa-sync-alt me-1"></i>Sync
                  </button>
                </form>
              <% } else if (shipped && shipped.status === 'locally-modified') { %>
                <form method="POST" action="/addons/forms/<%= encodeURIComponent(form.id) %>/sync" style="display:inline"
                  data-confirm="Replace the edits made to &quot;<%= form.title %>&quot; on this site with the version <%= shipped.addon %> ships?&#10;&#10;Those edits are lost.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="overwrite" value="1">
                  <button type="submit" class="btn btn-sm btn-outline-danger" data-action="overwrite">
                    <i class="fas fa-sync-alt me-1"></i>Replace my edits
                  </button>
                </form>
              <% } %>
              <form method="POST" action="/addons/forms/builder/<%= encodeURIComponent(form.id) %>/delete" style="display:inline"
                data-confirm="Delete form &quot;<%= form.id %>&quot;?&#10;&#10;Deletion is blocked if submissions exist.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <i class="fas fa-trash me-1"></i>Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script nonce="<%= locals.cspNonce %>">
// A form with data-confirm asks before it submits (a listener, not an inline handler: #1706).
document.addEventListener('submit', function (e) {
  var form = e.target.closest('form[data-confirm]');
  if (form && !confirm(form.dataset.confirm)) e.preventDefault();
});
</script>

<%- include('footer') %>
