<%- include('header', { title: 'Forms Admin', currentUser }) %>

<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12 d-flex align-items-center justify-content-between mb-2">
      <h2 class="mb-0"><i class="fas fa-wpforms me-2"></i>Forms</h2>
      <a href="/addons/forms/builder/new" class="btn btn-success btn-sm">
        <i class="fas fa-plus me-1"></i>New Form
      </a>
    </div>
    <div class="col-12">
      <p class="text-muted">Manage form definitions and view submissions.</p>
    </div>
  </div>

  <% var flash = typeof query !== 'undefined' && query ? query.flash : undefined; %>
  <% if (flash === 'saved') { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-1"></i>Form definition saved.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } else if (flash === 'deleted') { %>
    <div class="alert alert-info alert-dismissible fade show" role="alert">
      <i class="fas fa-trash me-1"></i>Form definition deleted.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } else if (flash === 'cleared') { %>
    <div class="alert alert-info alert-dismissible fade show" role="alert" data-testid="flash-cleared">
      <i class="fas fa-eraser me-1"></i>Cleared <%= query.count %> submission<%= query.count !== '1' ? 's' : '' %> of <code><%= query.form %></code>.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } else if (flash === 'not-cleared') { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert" data-testid="flash-not-cleared">
      <i class="fas fa-exclamation-triangle me-1"></i>Nothing was cleared: type the form id, <code><%= query.form %></code>, exactly to confirm.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (forms.length === 0) { %>
    <div class="alert alert-info">
      No form definitions found. Click <strong>New Form</strong> to create one.
    </div>
  <% } else { %>
    <div class="row">
      <% forms.forEach(function(form) { %>
        <div class="col-md-4 mb-4">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h5 class="card-title"><%= form.title %></h5>
              <p class="text-muted small mb-1"><code><%= form.id %></code></p>
              <% if (form.description) { %>
                <p class="card-text small"><%= form.description %></p>
              <% } %>
              <div class="d-flex gap-2 flex-wrap mt-2">
                <span class="badge bg-secondary"><%= form.fields.length %> fields</span>
                <span class="badge bg-<%= form.submissionCount > 0 ? 'primary' : 'light text-dark' %>">
                  <%= form.submissionCount %> submission<%= form.submissionCount !== 1 ? 's' : '' %>
                </span>
                <% if (form.handler) { %>
                  <span class="badge bg-info text-dark">handler: <%= form.handler %></span>
                <% } %>
                <% if (form.proxySubmission) { %>
                  <span class="badge bg-warning text-dark">proxy</span>
                <% } %>
              </div>
              <% if (form.providedBy && form.orphanedFrom) { %>
                <%# #1973: its add-on did not load, or no longer ships it; it may be deleted, not edited. %>
                <p class="small text-warning-emphasis mt-2 mb-0" data-testid="no-longer-provided">
                  <i class="fas fa-puzzle-piece me-1"></i>No longer provided by <a href="/admin/addons"><%= form.orphanedFrom %></a> (last written by version <%= form.providedBy.version %>). It can be deleted, not edited.
                </p>
              <% } else if (form.providedBy) { %>
                <%# #1973: an add-on's form is read-only here; the add-on itself is described on Admin -> Add-ons. %>
                <p class="small text-muted mt-2 mb-0" data-testid="provided-by">
                  <i class="fas fa-puzzle-piece me-1"></i>Provided by <a href="/admin/addons"><%= form.providedBy.addon %></a> <%= form.providedBy.version %>; it updates this form.
                </p>
              <% } %>
              <% if (form.submissionCount > 0) { %>
                <%# #1973: a form with submissions cannot be deleted until they are cleared. %>
                <details class="mt-2" data-testid="clear-submissions">
                  <summary class="small text-danger">Clear submissions</summary>
                  <form method="POST" action="/addons/forms/<%= encodeURIComponent(form.id) %>/submissions/clear" class="border rounded p-2 mt-2">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <p class="small mb-2">Removes all <strong><%= form.submissionCount %></strong> stored submission<%= form.submissionCount !== 1 ? 's' : '' %> of <strong><%= form.title %></strong>. This cannot be undone. The form itself is kept.</p>
                    <p class="small mb-2"><a href="/addons/forms/<%= encodeURIComponent(form.id) %>/export.csv" data-testid="export-csv"><i class="fas fa-download me-1"></i>Download them as CSV</a> first to keep a copy.</p>
                    <label for="clear-<%= form.id %>" class="form-label small">Type the form id, <strong><%= form.id %></strong>, to confirm</label>
                    <input type="text" class="form-control form-control-sm clear-confirm mb-2" id="clear-<%= form.id %>" name="confirm" autocomplete="off" required data-expected="<%= form.id %>" data-submit="clear-submit-<%= form.id %>">
                    <button type="submit" class="btn btn-sm btn-danger" id="clear-submit-<%= form.id %>" disabled>
                      <i class="fas fa-eraser me-1"></i>Clear <%= form.submissionCount %> submission<%= form.submissionCount !== 1 ? 's' : '' %>
                    </button>
                  </form>
                </details>
              <% } %>
            </div>
            <div class="card-footer bg-transparent d-flex gap-2 flex-wrap">
              <a href="/addons/forms/<%= encodeURIComponent(form.id) %>/submissions" class="btn btn-sm btn-outline-primary">
                View Submissions
              </a>
              <% if (!form.providedBy) { %>
              <a href="/addons/forms/builder/<%= encodeURIComponent(form.id) %>" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-edit me-1"></i>Edit
              </a>
              <% } %>
              <% if (!form.providedBy || form.orphanedFrom) { %>
              <form method="POST" action="/addons/forms/builder/<%= encodeURIComponent(form.id) %>/delete" style="display:inline"
                data-confirm="Delete form &quot;<%= form.id %>&quot;?&#10;&#10;Deletion is blocked if submissions exist.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <i class="fas fa-trash me-1"></i>Delete
                </button>
              </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script nonce="<%= locals.cspNonce %>">
// A form with data-confirm asks before it submits (a listener, not an inline
// handler: #1706).
document.addEventListener('click', function (e) {
  var button = e.target.closest('button[type="submit"]');
  var asks = button && (button.closest('[data-confirm]'));
  if (asks && !confirm(asks.dataset.confirm)) e.preventDefault();
});
// #1973: Clear submissions stays disabled until the form id is typed, as a site restore asks for the site name.
document.querySelectorAll('input.clear-confirm').forEach(function (input) {
  var button = document.getElementById(input.dataset.submit);
  if (!button) return;
  var update = function () { button.disabled = input.value.trim() !== input.dataset.expected; };
  input.addEventListener('input', update);
  update();
});
</script>

<%- include('footer') %>
