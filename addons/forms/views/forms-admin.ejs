<%- include('header', { title: 'Forms Admin', currentUser }) %>

<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12 d-flex align-items-center justify-content-between mb-2">
      <h2 class="mb-0"><i class="fas fa-wpforms me-2"></i>Forms</h2>
      <a href="/addons/forms/builder/new" class="btn btn-success btn-sm">
        <i class="fas fa-plus me-1"></i>New Form
      </a>
    </div>
    <div class="col-12">
      <p class="text-muted">Manage form definitions and view submissions.</p>
    </div>
  </div>

  <% var flash = typeof query !== 'undefined' && query ? query.flash : undefined; %>
  <% if (flash === 'saved') { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-1"></i>Form definition saved.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } else if (flash === 'synced') { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-sync-alt me-1"></i>Form updated to the version its add-on ships.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } else if (flash === 'sync-edited') { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
      <i class="fas fa-lock me-1"></i>Not updated: this form was edited on this site. Use <strong>Force Sync</strong> to take the shipped version anyway.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } else if (flash === 'deleted') { %>
    <div class="alert alert-info alert-dismissible fade show" role="alert">
      <i class="fas fa-trash me-1"></i>Form definition deleted.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% var shippedRows = typeof shippedForms !== 'undefined' ? shippedForms : []; %>
  <% if (typeof shippedCounts !== 'undefined' && shippedCounts.required > 0) { %>
    <div class="alert alert-danger" role="alert" data-testid="shipped-required">
      <i class="fas fa-exclamation-triangle me-1"></i><strong><%= shippedCounts.required %> shipped form<%= shippedCounts.required !== 1 ? 's need an update their add-on requires' : ' needs an update its add-on requires' %> to work.</strong> Sync <%= shippedCounts.required !== 1 ? 'them' : 'it' %> below.
    </div>
  <% } %>

  <% if (shippedRows.length > 0) { %>
    <%# #1918: shipped forms look and sync as Admin -> Required Pages' add-on pages do, through core's shared partials. %>
    <div class="card mb-4" id="shippedForms">
      <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-puzzle-piece me-2"></i>Shipped Forms</h5>
        <small class="text-muted">Forms shipped with enabled add-ons —
          <%- include('_sync-counts', { syncCounts: shippedCounts }) %>
        </small>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr><th>Title</th><th>Add-on</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% shippedRows.forEach(function(row) { %>
                <tr data-form-id="<%= row.id %>" data-status="<%= row.status %>">
                  <td><strong><%= row.title %></strong><br><small class="text-muted font-monospace"><%= row.id %></small></td>
                  <td><span class="badge bg-secondary"><%= row.addon %></span></td>
                  <td><%- include('_sync-status', { syncItem: row }) %></td>
                  <td>
                    <% if (row.status !== 'current') { %>
                      <%- include('_sync-button', { syncItem: {
                        userModified: row.userModified,
                        name: row.title,
                        forceNote: 'Those edits are lost: a form keeps no version history.',
                        confirm: row.stamped ? undefined : 'Update "' + row.title + '" to the version ' + row.addon + ' ships?\n\nThis copy was saved before edits were tracked, so any change made to it in the form builder is replaced.',
                        action: '/addons/forms/' + encodeURIComponent(row.id) + '/sync',
                        csrfToken: csrfToken
                      } }) %>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

  <% if (forms.length === 0) { %>
    <div class="alert alert-info">
      No form definitions found. Click <strong>New Form</strong> to create one.
    </div>
  <% } else { %>
    <div class="row">
      <% forms.forEach(function(form) { %>
        <div class="col-md-4 mb-4">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h5 class="card-title"><%= form.title %></h5>
              <p class="text-muted small mb-1"><code><%= form.id %></code></p>
              <% if (form.description) { %>
                <p class="card-text small"><%= form.description %></p>
              <% } %>
              <div class="d-flex gap-2 flex-wrap mt-2">
                <span class="badge bg-secondary"><%= form.fields.length %> fields</span>
                <span class="badge bg-<%= form.submissionCount > 0 ? 'primary' : 'light text-dark' %>">
                  <%= form.submissionCount %> submission<%= form.submissionCount !== 1 ? 's' : '' %>
                </span>
                <% if (form.handler) { %>
                  <span class="badge bg-info text-dark">handler: <%= form.handler %></span>
                <% } %>
                <% if (form.proxySubmission) { %>
                  <span class="badge bg-warning text-dark">proxy</span>
                <% } %>
                <% if (form.shippedState) { %>
                  <a class="badge bg-light text-dark border text-decoration-none" href="#shippedForms">from <%= form.shippedState.addon %></a>
                <% } %>
              </div>
            </div>
            <div class="card-footer bg-transparent d-flex gap-2 flex-wrap">
              <a href="/addons/forms/<%= encodeURIComponent(form.id) %>/submissions" class="btn btn-sm btn-outline-primary">
                View Submissions
              </a>
              <a href="/addons/forms/builder/<%= encodeURIComponent(form.id) %>" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-edit me-1"></i>Edit
              </a>
              <form method="POST" action="/addons/forms/builder/<%= encodeURIComponent(form.id) %>/delete" style="display:inline"
                data-confirm="Delete form &quot;<%= form.id %>&quot;?&#10;&#10;Deletion is blocked if submissions exist.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <i class="fas fa-trash me-1"></i>Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script nonce="<%= locals.cspNonce %>">
// A form or button with data-confirm asks before it submits (a listener, not
// an inline handler: #1706). Core's _sync-button puts it on the button (#1918).
document.addEventListener('click', function (e) {
  var button = e.target.closest('button[type="submit"]');
  var asks = button && (button.closest('[data-confirm]'));
  if (asks && !confirm(asks.dataset.confirm)) e.preventDefault();
});
</script>

<%- include('footer') %>
