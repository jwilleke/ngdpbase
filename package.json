{
  "name": "ngdpbase",
  "version": "5.41.0",
  "description": "JSPWiki-style wiki with advanced search capabilities",
  "author": "",
  "license": "Apache-2.0",
  "scripts": {
    "start": "NODE_ENV=production node dist/src/app.js",
    "start:dev": "NODE_ENV=development node dist/src/app.js",
    "start:prod": "NODE_ENV=production node dist/src/app.js",
    "dev": "NODE_ENV=development node dist/src/app.js",
    "mcp": "node dist/mcp-server.js",
    "build": "tsc && npm run build:addons",
    "build:addons": "cd addons/forms && npm install --silent && npx tsc -p tsconfig.json && cd ../calendar && npm install --silent && npx tsc -p tsconfig.json && cd ../elasticsearch && npm install --silent && npx tsc -p tsconfig.json && cd ../journal && npm install --silent && npx tsc -p tsconfig.json && cd ../feeds && npm install --silent && npx tsc -p tsconfig.json && cd ../demo && npx tsc -p tsconfig.json",
    "build:types-package": "tsx scripts/build-types-package.ts",
    "build:media-date-package": "tsx scripts/build-media-date-package.ts",
    "create:addon": "tsx scripts/create-addon.ts",
    "audit:verify": "tsx scripts/verify-audit-chain.ts",
    "audit:restart-chain": "tsx scripts/restart-audit-chain.ts",
    "sweep:test-pages": "tsx scripts/sweep-test-pages.ts",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/ngdpbase-types/tsconfig.json && npm run typecheck:addons",
    "typecheck:addons": "for c in addons/*/tsconfig.json; do tsc --noEmit -p \"$c\" || exit 1; done",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:ci": "NODE_ENV=test vitest run --coverage",
    "test:changed": "NODE_ENV=test vitest run --changed",
    "test:integration": "NODE_ENV=test vitest run --reporter=verbose integration.test",
    "test:unit": "NODE_ENV=test vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:baseline": "./scripts/baseline-profile.sh",
    "test:baseline:cold": "./scripts/baseline-profile.sh --cold-start",
    "test:baseline:compare": "./scripts/baseline-profile.sh --compare",
    "test:baseline:addondiff": "./scripts/baseline-profile.sh --addon-diff",
    "smoke": "./scripts/smoke-test.sh",
    "prepare": "husky || echo 'Husky not installed'",
    "version": "echo $npm_package_version",
    "version:show": "tsx src/utils/version.ts",
    "version:patch": "tsx src/utils/version.ts patch",
    "version:minor": "tsx src/utils/version.ts minor",
    "version:major": "tsx src/utils/version.ts major",
    "version:help": "tsx src/utils/version.ts help",
    "migrate:versioning": "tsx scripts/migrate-to-versioning.ts",
    "migrate:versioning:dry": "tsx scripts/migrate-to-versioning.ts --dry-run",
    "migrate:versioning:verbose": "tsx scripts/migrate-to-versioning.ts --verbose",
    "migrate:private": "tsx scripts/migrate-private-field.ts",
    "migrate:private:dry": "tsx scripts/migrate-private-field.ts --dry-run",
    "migrate:vocabulary": "tsx scripts/migrate-vocabulary-slice1.ts",
    "migrate:vocabulary-store": "tsx scripts/migrate-vocabulary-store.ts",
    "migrate:vocabulary-store:dry": "tsx scripts/migrate-vocabulary-store.ts --dry-run",
    "reconcile:mentions": "tsx scripts/reconcile-attachment-mentions.ts",
    "reconcile:mentions:dry": "tsx scripts/reconcile-attachment-mentions.ts --dry-run",
    "files:migration:dry": "tsx scripts/files-migration-dry-run.ts",
    "migrate:vocabulary:dry": "tsx scripts/migrate-vocabulary-slice1.ts --dry-run",
    "migrate:user-pages-category": "tsx scripts/migrate-user-pages-category.ts",
    "migrate:user-pages-category:dry": "tsx scripts/migrate-user-pages-category.ts --dry-run",
    "migrate:page-created": "tsx scripts/migrate-page-created.ts",
    "migrate:page-created:apply": "tsx scripts/migrate-page-created.ts --apply",
    "migrate:page-acl": "tsx scripts/migrate-page-acl-to-frontmatter.ts",
    "migrate:page-acl:dry": "tsx scripts/migrate-page-acl-to-frontmatter.ts --dry-run",
    "repair:frontmatter": "tsx scripts/repair-jspwiki-frontmatter.ts",
    "repair:frontmatter:dry": "tsx scripts/repair-jspwiki-frontmatter.ts --dry-run",
    "maintain:versioning": "tsx scripts/maintain-versions.ts",
    "maintain:cleanup": "tsx scripts/maintain-versions.ts --cleanup",
    "maintain:compress": "tsx scripts/maintain-versions.ts --compress",
    "maintain:analyze": "tsx scripts/maintain-versions.ts --analyze",
    "maintain:full": "tsx scripts/maintain-versions.ts --full",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:html": "typedoc --plugin none --out docs/api/html",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:docs": "tsx scripts/check-docs-coverage.ts",
    "lint:csrf": "tsx scripts/check-csrf-fetch.ts",
    "lint:http": "tsx scripts/check-http-boundary.ts",
    "lint:permission-subject": "tsx scripts/check-permission-subject.ts",
    "lint:gates": "tsx scripts/check-permission-gates.ts",
    "lint:context": "tsx scripts/check-context-discipline.ts",
    "lint:page-door": "tsx scripts/check-page-door.ts",
    "lint:audit-attribution": "tsx scripts/check-audit-attribution.ts",
    "generate:permissions": "tsx scripts/generate-permission-types.ts",
    "lint:permissions": "tsx scripts/generate-permission-types.ts --check",
    "lint:addons": "tsx scripts/check-addon-boundary.ts",
    "lint:audit-deps": "tsx scripts/check-lockfile-audit.ts",
    "lint:sensitive": "tsx scripts/check-sensitive-values.ts",
    "lint:backup": "tsx scripts/check-backup-boundary.ts",
    "check:addon-load": "tsx scripts/check-addon-load.ts",
    "docs:index": "tsx scripts/generate-docs-index.ts",
    "docs:index:check": "tsx scripts/generate-docs-index.ts --check",
    "docs:audit": "tsx scripts/generate-audit-docs.ts",
    "docs:audit:check": "tsx scripts/generate-audit-docs.ts --check",
    "lint": "npm run lint:code && npm run lint:md && npm run lint:docs && npm run lint:csrf && npm run lint:http && npm run lint:permission-subject && npm run lint:gates && npm run lint:context && npm run lint:page-door && npm run lint:audit-attribution && npm run lint:permissions && npm run lint:addons && npm run lint:backup && npm run lint:sensitive && npm run lint:audit-deps && npm run lint:audit && npm run docs:audit:check",
    "lint:code": "eslint \"src/**/*.ts\" \"addons/**/*.ts\" \"packages/*/*.ts\" \"packages/*/__tests__/**/*.ts\"",
    "lint:fix": "npm run lint:code:fix && npm run lint:md:fix",
    "lint:code:fix": "eslint \"src/**/*.ts\" \"addons/**/*.ts\" \"packages/*/*.ts\" \"packages/*/__tests__/**/*.ts\" --fix",
    "lint:staged": "lint-staged",
    "lint:ci": "npm run lint:code && npm run lint:md && npm run lint:docs && npm run lint:csrf && npm run lint:http && npm run lint:permission-subject && npm run lint:gates && npm run lint:context && npm run lint:page-door && npm run lint:audit-attribution && npm run lint:permissions && npm run lint:addons && npm run lint:backup && npm run lint:sensitive && npm run lint:audit && npm run docs:audit:check",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist .tsbuildinfo && find src -name '*.js' -not -path '*/__tests__/*' -delete && find src -name '*.js.map' -not -path '*/__tests__/*' -delete",
    "prebuild": "npm run clean",
    "audit:coverage": "tsx scripts/audit-coverage.ts",
    "lint:audit": "tsx scripts/audit-coverage.ts --check"
  },
