
<%- include('header', { pageName: pageName }) %>

<% if (typeof warningMessage !== 'undefined' && warningMessage) { %>
<div class="alert alert-warning alert-dismissible fade show mx-3 mt-3" role="alert">
    <i class="fas fa-exclamation-triangle me-2"></i><%= warningMessage %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>

<%# Slice 6a of #760 (#765) — JSON-LD structured-data block. Replaces the
    previous microdata (`itemscope itemtype=...`) used here per Decision 9 of
    #755 (2026-05-20): "Structured-data is JSON-LD only, not HTML microdata.
    Supersedes #149." The mapper lives in `src/utils/buildPageJsonLd.ts`;
    `viewPage()` populates `pageJsonLd` on the template payload. JSON.stringify
    handles `<` / `>` / `"` escaping inside the script body, so an attacker-
    controlled metadata.title cannot break out. %>
<% if (typeof pageJsonLdScript !== 'undefined' && pageJsonLdScript) { %>
<script type="application/ld+json"><%- pageJsonLdScript %></script>
<% } %>

<%# #795 — extension slot for addon-defined HTML rendered before the page
    body. Empty by default; addon view templates that include this partial
    can pass `extraBodyPreContent` as a pre-rendered HTML string. Sister
    slot `extraBodyPostContent` below. Metabar / sidebar slots from the
    issue body live in header.ejs and are deferred to a follow-up. %>
<%- (typeof extraBodyPreContent !== 'undefined' ? extraBodyPreContent : '') %>

<%# #1105 — arrived here by a former title. `renamedFrom` is the value stored in
    this page's own frontmatter, already matched against the `?from=` parameter
    server-side, so it is safe to render and cannot be forged by the query string.
    The 301 is cached by the browser, so this notice persists on every use of the
    stale bookmark — that is deliberate: it is the only nudge the reader ever gets
    to re-bookmark. %>
<% if (typeof renamedFrom !== 'undefined' && renamedFrom) { %>
  <div class="alert alert-info d-flex align-items-center mb-4" role="status">
    <i class="fas fa-right-left me-2" aria-hidden="true"></i>
    <div>
      You followed a link to <strong><%= renamedFrom %></strong>, which was renamed to
      <strong><%= pageName %></strong>. Please update your bookmark.
    </div>
  </div>
  <script>
    // Drop ?from= from the address bar so re-bookmarking captures the canonical
    // URL. The notice has already rendered; this only tidies what the user sees.
    try {
      const url = new URL(window.location.href);
      if (url.searchParams.has('from')) {
        url.searchParams.delete('from');
        window.history.replaceState({}, '', url.pathname + url.search + url.hash);
      }
    } catch { /* address bar cosmetics only — never break the page for this */ }
  </script>
<% } %>

<!-- Page content -->
<article class="markdown-body mb-4">
  <%- content %>
</article>

<%- (typeof extraBodyPostContent !== 'undefined' ? extraBodyPostContent : '') %>

<% if (typeof sectionEditingEnabled !== 'undefined' && sectionEditingEnabled) { %>
<style>
.section-edit-link {
    opacity: 0;
    margin-left: 0.4em;
    font-size: 0.7em;
    vertical-align: middle;
    color: var(--link-color, #0d6efd);
    text-decoration: none;
    transition: opacity 0.15s;
}
.markdown-body h1:hover .section-edit-link,
.markdown-body h2:hover .section-edit-link,
.markdown-body h3:hover .section-edit-link,
.markdown-body h4:hover .section-edit-link,
.markdown-body h5:hover .section-edit-link,
.markdown-body h6:hover .section-edit-link { opacity: 1; }
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var body = document.querySelector('.markdown-body');
    if (!body) return;
    // #748: headings inside an InsertPlugin (.insert-plugin) block are
    // transcluded from another page — they are NOT sections of THIS page's
    // markdown. Decorating them gave a bogus "edit this section" pencil and
    // shifted every real ?section=i index after an Insert (the server's
    // ?section=N counts host-markdown headings only). Filter them out so the
    // client index mirrors the server's host-only section numbering.
    var headings = Array.prototype.filter.call(
        body.querySelectorAll('h1, h2, h3, h4, h5, h6'),
        function (h) { return !h.closest('.insert-plugin'); }
    );
    headings.forEach(function (h, i) {
        var a = document.createElement('a');
        a.href = '/edit/<%= encodeURIComponent(pageName) %>?section=' + i;
        a.className = 'section-edit-link';
        a.title = 'Edit this section';
        a.innerHTML = '<i class="fas fa-pencil-alt"></i>';
        h.appendChild(a);
    });
});
</script>
<% } %>

<!-- Page tags: auto-tags (ES systemKeywords) + user-keywords -->
<%
  var _autoTags = typeof autoTaggedKeywords !== 'undefined' ? autoTaggedKeywords : [];
  var _userKws  = (metadata && metadata['user-keywords']) ? metadata['user-keywords'] : [];
  var _hasAnyTag = _autoTags.length > 0 || _userKws.length > 0;
%>
<% if (_hasAnyTag) { %>
<div class="page-tags mb-3 px-1">
  <% if (_autoTags.length > 0) { %>
    <span class="text-muted small me-1" title="Auto-tagged system keywords"><i class="fas fa-tag"></i></span>
    <% _autoTags.forEach(function(kw) { %>
      <a href="/search?types=page&amp;systemKeywords=<%= encodeURIComponent(kw) %>" class="badge text-bg-secondary text-decoration-none me-1" title="Auto-tagged — find pages with this system keyword"><%= kw %></a>
    <% }); %>
  <% } %>
  <% if (_userKws.length > 0) { %>
    <% if (_autoTags.length > 0) { %><span class="text-muted small mx-1">|</span><% } %>
    <span class="text-muted small me-1" title="User keywords"><i class="fas fa-tags"></i></span>
    <% _userKws.forEach(function(kw) { %>
      <a href="/search?types=page&amp;keywords=<%= encodeURIComponent(kw) %>" class="badge text-bg-info text-decoration-none me-1" title="User keyword — find pages with this keyword"><%= kw %></a>
    <% }); %>
  <% } %>
</div>
<% } %>

<!-- Page tab section (Comments, Referring Pages, etc.) — Template:PageTabs (#551) -->
<% if (typeof tabSection !== 'undefined' && tabSection) { %>
<%- tabSection %>
<% } %>

<!-- More Information section (similar to JSPWiki) -->
<% if (referringPages && referringPages.length > 0) { %>
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-sitemap"></i> More Information
        </h5>
    </div>
    <div class="card-body">
        <p class="text-muted">There might be more information for this subject on one of the following:</p>
        <ul class="list-unstyled">
            <% referringPages.forEach(page => { %>
                <li class="mb-1">
                    <i class="fas fa-link"></i>
                    <a href="/view/<%= page %>"><%= page %></a>
                </li>
            <% }); %>
        </ul>
    </div>
</div>
<% } %>

<script>
function deletePage(pageName) {
    if (confirm('Are you sure you want to delete this page?')) {
        // #727: state-changing request must carry the CSRF token (#663
        // app-wide middleware). csrfFetch injects X-CSRF-Token.
        (window.csrfFetch || fetch)(`/delete/${encodeURIComponent(pageName)}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            }
        }).then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.href = data.redirect || '/';
            } else {
                alert('Error deleting page: ' + (data.error || 'Unknown error'));
            }
        }).catch(error => {
            alert('Error deleting page: ' + error.message);
        });
    }
}
</script>

<%- include('footer') %>
