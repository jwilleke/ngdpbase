<%- include('header', { pageName: 'Compare Versions: ' + pageName }) %>

<div class="container mt-4">
  <div class="card">
    <div class="card-header">
      <h4><i class="fas fa-exchange-alt"></i> Comparing Versions: <%= pageName %></h4>
      <p class="mb-0 text-muted">
        <a href="<%= pageUrl(pageName) %>">
          <i class="fas fa-arrow-left"></i> Back to Page
        </a>
        |
        <a href="<%= pageUrl(pageName, 'history') %>">
          <i class="fas fa-history"></i> View History
        </a>
      </p>
    </div>
    <div class="card-body">
      <!-- Version Info -->
      <div class="row mb-4">
        <div class="col-md-6">
          <div class="card border-danger">
            <div class="card-header bg-danger text-white">
              <h5 class="mb-0">
                <i class="fas fa-minus-circle"></i> Version <%= version1.version %>
              </h5>
            </div>
            <div class="card-body">
              <p><strong>Date:</strong> <%= new Date(version1.dateCreated).toLocaleString() %></p>
              <p><strong>Author:</strong> <%= version1.author %></p>
              <p><strong>Change:</strong> <%= version1.changeType %></p>
              <p class="mb-0"><strong>Comment:</strong> <%= version1.comment || '-' %></p>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card border-success">
            <div class="card-header bg-success text-white">
              <h5 class="mb-0">
                <i class="fas fa-plus-circle"></i> Version <%= version2.version %>
              </h5>
            </div>
            <div class="card-body">
              <p><strong>Date:</strong> <%= new Date(version2.dateCreated).toLocaleString() %></p>
              <p><strong>Author:</strong> <%= version2.author %></p>
              <p><strong>Change:</strong> <%= version2.changeType %></p>
              <p class="mb-0"><strong>Comment:</strong> <%= version2.comment || '-' %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Diff Statistics -->
      <div class="alert alert-info">
        <h5><i class="fas fa-chart-bar"></i> Change Summary</h5>
        <div class="row">
          <div class="col-md-4">
            <strong class="text-success"><i class="fas fa-plus"></i> Additions:</strong> <%= stats.additions %>
          </div>
          <div class="col-md-4">
            <strong class="text-danger"><i class="fas fa-minus"></i> Deletions:</strong> <%= stats.deletions %>
          </div>
          <div class="col-md-4">
            <strong class="text-muted"><i class="fas fa-equals"></i> Unchanged:</strong> <%= stats.unchanged %>
          </div>
        </div>
      </div>

      <% if (locals.tooLarge) { %>
      <div class="alert alert-warning" id="diffTooLarge">
        This change is too large to show line by line. Version <%= version1.version %> is <%= tooLarge.oldBytes %> characters and version <%= version2.version %> is <%= tooLarge.newBytes %> characters.
      </div>
      <% } else if (stats.additions === 0 && stats.deletions === 0) { %>
      <div class="alert alert-secondary" id="diffNoChanges">
        No changes to the text.
      </div>
      <% } else { %>
      <!-- View Mode Selector -->
      <div class="btn-group mb-3" role="group">
        <button type="button" class="btn btn-primary active" id="btnUnified" onclick="showView('unified')">
          <i class="fas fa-align-left"></i> Unified View
        </button>
        <button type="button" class="btn btn-outline-primary" id="btnSideBySide" onclick="showView('sidebyside')">
          <i class="fas fa-columns"></i> Side-by-Side
        </button>
      </div>

      <!-- Unified Diff View -->
      <div id="unifiedView" class="diff-container">
        <div class="diff-pre" id="unifiedDiff">Loading...</div>
      </div>

      <!-- Side-by-Side Diff View -->
      <div id="sideBySideView" class="diff-container" style="display: none;">
        <div class="sbs" id="sbsGrid">
          <div class="card sbs-pane">
            <div class="card-header bg-danger text-white">
              <h6 class="mb-0">Version <%= version1.version %> (Old)</h6>
            </div>
            <div class="diff-pre mb-0" id="oldVersion">Loading...</div>
          </div>
          <div class="card sbs-pane">
            <div class="card-header bg-success text-white">
              <h6 class="mb-0">Version <%= version2.version %> (New)</h6>
            </div>
            <div class="diff-pre mb-0" id="newVersion">Loading...</div>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>

<style>
.diff-container {
  max-width: 100%;
  overflow-x: auto;
}

.diff-pre {
  background-color: var(--code-bg);
  border: 1px solid var(--border-color);
  border-radius: 4px;
  padding: 15px;
  font-family: 'Courier New', Courier, monospace;
  font-size: 13px;
  line-height: 1.5;
  white-space: pre-wrap;
  word-wrap: break-word;
  color: var(--text-primary);
}

.diff-line-added {
  background-color: var(--alert-success-bg);
  color: var(--alert-success-text);
  padding: 2px 5px;
  display: block;
  min-height: calc(1.5em + 4px);
}

.diff-line-deleted {
  background-color: var(--alert-danger-bg);
  color: var(--alert-danger-text);
  padding: 2px 5px;
  display: block;
  min-height: calc(1.5em + 4px);
}

.diff-line-unchanged {
  padding: 2px 5px;
  display: block;
  min-height: calc(1.5em + 4px);
  color: var(--text-primary);
}

/* Dark mode: the shared alert tokens leave removed text at 4.1:1 on a grey
   background, so the diff carries its own colours. */
[data-bs-theme="dark"] .diff-line-added { background-color: #123d24; color: #7ee787; }
[data-bs-theme="dark"] .diff-line-deleted { background-color: #4a1a1f; color: #ff9b94; }
[data-bs-theme="dark"] .diff-line-added .diff-line-marker,
[data-bs-theme="dark"] .diff-line-deleted .diff-line-marker { color: inherit; }
@media (prefers-color-scheme: dark) {
  :root:not([data-bs-theme]) .diff-line-added { background-color: #123d24; color: #7ee787; }
  :root:not([data-bs-theme]) .diff-line-deleted { background-color: #4a1a1f; color: #ff9b94; }
  :root:not([data-bs-theme]) .diff-line-added .diff-line-marker,
  :root:not([data-bs-theme]) .diff-line-deleted .diff-line-marker { color: inherit; }
}

/* Side by side (#2352): each pane is a subgrid over one shared set of row
   tracks, so a pair of lines is as tall as the taller of the two and the panes
   stay level when a line wraps on one side. Below 768px the panes stack. */
.sbs { display: grid; grid-template-columns: 1fr 1fr; column-gap: 1.5rem; row-gap: 1.5rem; }
.sbs-pane { grid-row: 1 / span calc(var(--sbs-rows, 1) + 1); display: grid; grid-template-rows: subgrid; row-gap: 0; }
.sbs-pane .diff-pre { grid-row: 2 / span var(--sbs-rows, 1); display: grid; grid-template-rows: subgrid; row-gap: 0; align-content: start; border: 0; border-radius: 0; }
.sbs-pane .diff-pre > span { min-width: 0; }
@media (max-width: 767.98px) {
  .sbs, .sbs-pane, .sbs-pane .diff-pre { display: block; }
  .sbs-pane { margin-bottom: 1rem; }
}

/* Filler: stands in for a line the other side has. It takes its height from the
   paired row (the grid stretches it); its ::before is a zero-width text line so
   an unpaired filler is as tall as a text row, whatever the padding. */
.diff-line-filler {
  display: block;
  padding: 2px 5px;
  user-select: none;
  background-color: var(--code-bg);
  background-image: repeating-linear-gradient(135deg, transparent 0 5px, var(--diff-filler-line, #6c757d) 5px 6px);
}
[data-bs-theme="dark"] .diff-line-filler { --diff-filler-line: #8b949e; }
@media (prefers-color-scheme: dark) { :root:not([data-bs-theme]) .diff-line-filler { --diff-filler-line: #8b949e; } }
.diff-line-filler::before { content: ''; display: inline-block; width: 0; }

.diff-line-marker {
  display: inline-block;
  width: 30px;
  text-align: center;
  font-weight: bold;
  color: var(--text-secondary);
}
</style>

<script nonce="<%= locals.cspNonce %>">
// Store diff data
const diffData = <%- jsonForScript(diff) %>;

// Render diff based on view mode
function showView(mode) {
  const unified = document.getElementById('unifiedView');
  const sideBySide = document.getElementById('sideBySideView');
  const btnUnified = document.getElementById('btnUnified');
  const btnSideBySide = document.getElementById('btnSideBySide');

  if (mode === 'unified') {
    unified.style.display = 'block';
    sideBySide.style.display = 'none';
    btnUnified.classList.add('active');
    btnUnified.classList.remove('btn-outline-primary');
    btnUnified.classList.add('btn-primary');
    btnSideBySide.classList.remove('active');
    btnSideBySide.classList.add('btn-outline-primary');
    btnSideBySide.classList.remove('btn-primary');
  } else {
    unified.style.display = 'none';
    sideBySide.style.display = 'block';
    btnSideBySide.classList.add('active');
    btnSideBySide.classList.remove('btn-outline-primary');
    btnSideBySide.classList.add('btn-primary');
    btnUnified.classList.remove('active');
    btnUnified.classList.add('btn-outline-primary');
    btnUnified.classList.remove('btn-primary');
  }
}

// Render unified diff
function renderUnifiedDiff() {
  const container = document.getElementById('unifiedDiff');
  let html = '';

  diffData.forEach(part => {
    const [type, text] = part;

    if (type === -1) {
      // Deletion
      html += `<span class="diff-line-deleted"><span class="diff-line-marker">-</span>${escapeHtml(text)}</span>`;
    } else if (type === 1) {
      // Addition
      html += `<span class="diff-line-added"><span class="diff-line-marker">+</span>${escapeHtml(text)}</span>`;
    } else {
      // Unchanged
      html += `<span class="diff-line-unchanged"><span class="diff-line-marker"> </span>${escapeHtml(text)}</span>`;
    }
  });

  container.innerHTML = html;
}

// Pair the lines of one changed block (a run of removed and added lines) row
// by row; the shorter side gets filler rows (#2352).
function pairSideBySide(parts) {
  const rows = [];
  let removed = [];
  let added = [];
  const flush = () => {
    const n = Math.max(removed.length, added.length);
    for (let i = 0; i < n; i++) {
      rows.push({ oldText: i < removed.length ? removed[i] : null, newText: i < added.length ? added[i] : null, changed: true });
    }
    removed = [];
    added = [];
  };
  parts.forEach(([type, text]) => {
    if (type === -1) removed.push(text);
    else if (type === 1) added.push(text);
    else {
      flush();
      rows.push({ oldText: text, newText: text, changed: false });
    }
  });
  flush();
  return rows;
}

// Render side-by-side diff
function renderSideBySideDiff() {
  const oldContainer = document.getElementById('oldVersion');
  const newContainer = document.getElementById('newVersion');
  const side = (text, cls) => text === null
    ? '<span class="diff-line-filler" aria-hidden="true"></span>'
    : `<span class="${cls}">${escapeHtml(text)}</span>`;

  const rows = pairSideBySide(diffData);
  let oldHtml = '';
  let newHtml = '';
  rows.forEach(row => {
    oldHtml += side(row.oldText, row.changed ? 'diff-line-deleted' : 'diff-line-unchanged');
    newHtml += side(row.newText, row.changed ? 'diff-line-added' : 'diff-line-unchanged');
  });

  oldContainer.innerHTML = oldHtml;
  newContainer.innerHTML = newHtml;
  document.getElementById('sbsGrid').style.setProperty('--sbs-rows', String(rows.length));
}

// Escape HTML for display
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// Initialize diffs on page load
document.addEventListener('DOMContentLoaded', function() {
  if (!document.getElementById('unifiedDiff')) return;
  renderUnifiedDiff();
  renderSideBySideDiff();
});
</script>

<%- include('footer') %>
