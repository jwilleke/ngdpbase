<%- include('header', { pageName: '' }) %>

<%# #2125 — shared folders. Two views in one template. With `folder` null: GET /shared, the folders
    the viewer may open (`folders`, names; SharedFolderManager.foldersReadableBy, asked of the PDP).
    With `folder` set: GET /shared/<folder>, that folder's pages (`pages`: { title, url }, through the
    page door) and, when `mayFile` (shared-folder-file on it), a form for a new page. Nothing is shown
    about a folder the viewer may not open. No script of its own. %>

<div class="container py-4" data-testid="shared-folder-page">
    <% if (!folder) { %>
    <h1 class="h3 mb-3"><i class="fas fa-folder-open"></i> Shared folders <%- include('_help-icon', { slug: 'shared-folders', label: 'Shared folders' }) %></h1>
    <p class="text-muted">Folders the organization keeps, open to you.</p>
    <% if (folders.length === 0) { %>
        <p data-testid="shared-folders-empty">There is no shared folder open to you.</p>
    <% } else { %>
        <ul class="list-group" data-testid="shared-folders-list">
            <% folders.forEach(function (f) { %>
            <li class="list-group-item"><i class="fas fa-folder me-2"></i><a href="/shared/<%= encodeURIComponent(f) %>"><%= f %></a></li>
            <% }) %>
        </ul>
    <% } %>
    <% } else { %>
    <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/shared">Shared folders</a></li><li class="breadcrumb-item active" aria-current="page"><%= folder %></li></ol></nav>
    <h1 class="h3 mb-3"><i class="fas fa-folder-open"></i> <%= folder %> <%- include('_help-icon', { slug: 'shared-folders', label: 'Shared folders' }) %></h1>
    <% if (mayFile) { %>
    <form method="GET" action="/shared/<%= encodeURIComponent(folder) %>" class="row g-2 mb-3" data-testid="shared-folder-new">
        <div class="col-auto"><input type="text" name="new" class="form-control form-control-sm" placeholder="New page title" required aria-label="New page title"></div>
        <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New page</button></div>
    </form>
    <% } %>
    <% if (pages.length === 0) { %>
        <p data-testid="shared-folder-empty">This folder has no pages yet.</p>
    <% } else { %>
        <ul class="list-group" data-testid="shared-folder-pages">
            <% pages.forEach(function (p) { %>
            <li class="list-group-item"><a href="<%= p.url %>"><%= p.title %></a></li>
            <% }) %>
        </ul>
    <% } %>
    <% } %>
</div>

<%- include('footer') %>
