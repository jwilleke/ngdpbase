<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="refresh" content="10">
  <title>System Maintenance - ngdpbase</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .maintenance-container {
      max-width: 600px;
      background: white;
      border-radius: 15px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
      overflow: hidden;
    }
    .maintenance-header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 2rem;
      text-align: center;
    }
    .maintenance-body {
      padding: 2rem;
    }
    .maintenance-icon {
      font-size: 4rem;
      margin-bottom: 1rem;
      opacity: 0.9;
    }
    .progress-bar {
      height: 8px;
      border-radius: 4px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="maintenance-container">
      <div class="maintenance-header">
        <div class="maintenance-icon">🔧</div>
        <h1 class="h3 mb-0">System Maintenance</h1>
        <p class="mb-0 opacity-75">We'll be back soon!</p>
      </div>

      <div class="maintenance-body">
        <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) { %>
          <% notifications.forEach(notification => { %>
            <div class="alert alert-<%= notification.level === 'warning' ? 'warning' : notification.level === 'error' ? 'danger' : notification.level === 'success' ? 'success' : 'info' %> border-0 mb-3">
              <h6 class="alert-heading mb-2"><%= notification.title %></h6>
              <p class="mb-0"><%= notification.message %></p>
              <small class="text-muted">
                <%= new Date(notification.createdAt).toLocaleString() %>
              </small>
            </div>
          <% }); %>
        <% } %>

        <%#
          #1432: one gate closes the instance for several reasons, and this page
          is all of them. The heading used to read "We are currently performing
          maintenance" whatever the reason, so a holiday closure announced
          itself as maintenance. `reason` says which one; `message` is always
          the operator's own wording for that reason.
        %>
        <%
          const closureReason = (typeof reason !== 'undefined' && reason) ? reason : 'maintenance';
          const closureHeadings = {
            maintenance: 'We are currently performing maintenance',
            schedule: 'The site is closed right now',
            holiday: 'The site is closed for a holiday',
            misconfigured: 'The site is temporarily unavailable',
            starting: 'The site is starting up'
          };
        %>
        <div class="alert alert-warning border-0" data-closure-reason="<%= closureReason %>">
          <h5 class="alert-heading mb-3"><%= closureHeadings[closureReason] || closureHeadings.maintenance %></h5>
          <p class="mb-3"><%= message %></p>

          <% if (typeof estimatedDuration !== 'undefined' && estimatedDuration) { %>
            <div class="mb-3">
              <strong>Estimated completion:</strong> <%= estimatedDuration %>
            </div>
            <div class="progress mb-3">
              <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning"
                   role="progressbar" style="width: 100%"></div>
            </div>
          <% } %>

          <% if (typeof allowAdmins !== 'undefined' && allowAdmins && isAdmin) { %>
            <div class="alert alert-info mt-3">
              <strong>Admin Access:</strong> You have administrative privileges and can access the system during maintenance.
              <br>
              <a href="/admin" class="btn btn-sm btn-primary mt-2">Go to Admin Panel</a>
            </div>
          <% } %>
        </div>

        <div class="text-center">
          <button class="btn btn-primary me-2" onclick="window.location.reload()">
            <i class="fas fa-refresh me-1"></i>Try Again
          </button>
          <button class="btn btn-outline-secondary" onclick="window.history.back()">
            <i class="fas fa-arrow-left me-1"></i>Go Back
          </button>
        </div>

        <div class="text-center mt-4 text-muted small">
          <p>If you need immediate assistance, please contact your system administrator.</p>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>