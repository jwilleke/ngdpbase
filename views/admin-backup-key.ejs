<%- include('header', { pageName: 'Backup key' }) %>

<div class="container mt-4" style="max-width:760px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-key"></i> Backup key</h1>
        <a href="/admin/backup" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Backup</a>
    </div>

    <div class="alert alert-warning">
        <p class="mb-2"><strong>Copy this key somewhere safe that is not this server</strong>: your password manager, or written on paper and kept somewhere safe. Anyone with the key and a backup file can read that backup.</p>
        <p class="mb-0">To restore on a new server, put it in that server's <code>.env</code> as <code>NGDPBASE_BACKUP_KEY</code> <strong>before it first starts</strong> (or replace the key that server made for itself, then restart).</p>
    </div>

    <label for="backup-key-value" class="form-label">NGDPBASE_BACKUP_KEY</label>
    <input type="text" class="form-control font-monospace mb-2" id="backup-key-value" value="<%= key %>" readonly autocomplete="off" spellcheck="false">
    <p class="small text-muted">Fingerprint: <code id="backup-key-fingerprint"><%= fingerprint %></code></p>

    <form method="POST" action="/admin/backup/key/saved" id="backup-key-confirm" class="mt-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="fingerprint" value="<%= fingerprint %>">
        <button type="submit" class="btn btn-success"<%- lockedUnless('config-manage') %>><i class="fas fa-check"></i> I have saved this key off the server</button>
    </form>
</div>

<%- include('footer') %>
