<%- include('header', { pageName: '' }) %>
<%# #1523 / #1532 — the page the emailed link opens, on any device. Opening it changes
    nothing (mail scanners open links); the buttons decide: a green Approve and a
    red Deny (operator, 2026-10-02). What it says is AuthManager.approvalDetails. %>
<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card mt-5">
        <div class="card-header text-center"><h4 class="mb-0">Approve a sign-in</h4></div>
        <div class="card-body">
          <% if (outcome === 'approved') { %>
            <div class="alert alert-success mb-0">Approved. Go back to the window where you signed in; it continues by itself.</div>
          <% } else if (outcome === 'refused') { %>
            <div class="alert alert-warning mb-0">Denied. That sign-in will not complete. Someone may know your password: change it now.</div>
          <% } else if (!details) { %>
            <div class="alert alert-secondary mb-0">This link has expired or was already used.</div>
          <% } else { %>
            <p>A sign-in request for <strong><%= details.site %></strong> was sent at <strong><%= details.when %></strong><% if (details.device) { %> from <%= details.device %><% } %>.</p>
            <ul class="small text-muted">
              <li>Account: <%= details.username %></li>
              <% if (details.ip) { %><li>Address: <%= details.ip %></li><% } %>
              <% if (!details.device && details.userAgent) { %><li>Browser: <%= details.userAgent %></li><% } %>
            </ul>
            <p>Was this you? Approve only if it was you, just now.</p>
            <div class="d-flex gap-2">
              <form method="POST" action="/login/approve" class="flex-fill">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="t" value="<%= token %>">
                <input type="hidden" name="decision" value="approve">
                <button type="submit" class="btn btn-success w-100">Approve</button>
              </form>
              <form method="POST" action="/login/approve" class="flex-fill">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="t" value="<%= token %>">
                <input type="hidden" name="decision" value="deny">
                <button type="submit" class="btn btn-danger w-100">Deny</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('footer') %>
