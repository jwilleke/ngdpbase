<%- include('header', { pageName: '' }) %>

<div class="container mt-4">
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> <%= successMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> <%= errorMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <div class="row">
        <div class="col-12 d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h1><i class="fas fa-cogs"></i> Admin Dashboard</h1>
                <p class="lead">Welcome to the administration panel, <%= currentUser.displayName %>!</p>
            </div>
            <div class="text-end">
                <span class="badge bg-secondary fs-6" id="version-badge">v<%= stats.version %></span>
                <div id="update-check-result" class="mt-1 small"></div>
            </div>
        </div>
    </div>

    <!-- Row 1: Three management panels -->
    <div class="row mt-4">

        <!-- User Management -->
        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-users-cog"></i> User Management
                        <a href="/view/user-roles-and-permissions" class="ms-1 text-muted" title="Documentation" target="_blank"><i class="fas fa-question-circle fa-sm"></i></a>
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/users" class="btn btn-info btn-sm">
                                <i class="fas fa-users"></i> Manage Users
                            </a>
                            <a href="/view/manage-users" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/roles" class="btn btn-secondary btn-sm">
                                <i class="fas fa-shield-alt"></i> Roles
                            </a>
                            <a href="/view/roles" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/organizations" class="btn btn-secondary btn-sm">
                                <i class="fas fa-building"></i> Organizations
                            </a>
                            <a href="/view/organizations" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Administrative Tools -->
        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-tools"></i> Administrative Tools
                        <a href="/view/administrative-tools" class="ms-1 text-muted" title="Documentation" target="_blank"><i class="fas fa-question-circle fa-sm"></i></a>
                    </h5>
                </div>
                <div class="card-body">
                    <% if (currentUser.roles.includes('admin')) { %>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="d-inline-flex align-items-center gap-1">
                            <button class="btn btn-outline-danger btn-sm" onclick="confirmRestart()">
                                <i class="fas fa-sync-alt"></i> Restart
                            </button>
                            <a href="/view/server-management" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/backup" class="btn btn-outline-info btn-sm">
                                <i class="fas fa-database"></i> Backup
                            </a>
                            <a href="/view/backup" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/logs" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-file-alt"></i> Logs
                            </a>
                            <a href="/view/logs" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <button class="btn btn-outline-success btn-sm" onclick="clearCache()">
                                <i class="fas fa-broom"></i> Clear Cache
                            </button>
                            <a href="/view/clear-cache" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/view/app-health" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-heartbeat"></i> App Health
                            </a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/export" class="btn btn-success btn-sm">
                                <i class="fas fa-download"></i> Export Data
                            </a>
                            <a href="/view/export-data" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <form method="POST" action="/admin/maintenance/toggle" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <% if (maintenanceMode) { %>
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Disable maintenance mode? Users will be able to access the system again.')">
                                        <i class="fas fa-play"></i> Disable Maintenance
                                    </button>
                                <% } else { %>
                                    <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('Enable maintenance mode? This will restrict access for regular users.')">
                                        <i class="fas fa-pause"></i> Enable Maintenance
                                    </button>
                                <% } %>
                            </form>
                            <a href="/view/maintenance-mode" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                    </div>
                    <% if (maintenanceMode) { %>
                        <div class="mt-2">
                            <small class="text-danger">
                                <i class="fas fa-exclamation-triangle"></i> Maintenance mode is currently <strong>ACTIVE</strong>
                            </small>
                        </div>
                    <% } %>
                    <% } else { %>
                        <p class="text-muted">Admin role required for these tools.</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- System Settings -->
        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-cog"></i> System Settings
                        <a href="/view/configuration-system" class="ms-1 text-muted" title="Documentation" target="_blank"><i class="fas fa-question-circle fa-sm"></i></a>
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/keywords" class="btn btn-secondary btn-sm">
                                <i class="fas fa-tags"></i> Keywords
                            </a>
                            <a href="/view/keywords-and-categories" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/configuration" class="btn btn-secondary btn-sm">
                                <i class="fas fa-sliders-h"></i> Configuration
                            </a>
                            <a href="/view/configuration-system" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/variables" class="btn btn-secondary btn-sm">
                                <i class="fas fa-code"></i> Variables
                            </a>
                            <a href="/view/system-variables" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/attachments" class="btn btn-secondary btn-sm">
                                <i class="fas fa-paperclip"></i> Attachments
                            </a>
                            <a href="/view/attachments" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/interwiki" class="btn btn-secondary btn-sm">
                                <i class="fas fa-external-link-alt"></i> InterWiki
                            </a>
                            <a href="/view/interwiki" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/settings" class="btn btn-secondary btn-sm">
                                <i class="fas fa-cogs"></i> Settings
                            </a>
                            <a href="/view/system-settings" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Row 2: Add-ons -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-body py-2">
                    <details>
                        <summary class="d-flex align-items-center gap-2" style="cursor: pointer;">
                            <i class="fas fa-puzzle-piece"></i>
                            <strong>Add-ons</strong>
                            <span class="badge bg-secondary ms-auto"><%= addonsSummary ? addonsSummary.total : 0 %></span>
                        </summary>
                        <div class="mt-3">
                            <% if (addonsSummary && addonsSummary.total > 0) { %>
                                <div class="d-flex gap-3 mb-2">
                                    <span><i class="fas fa-circle text-success me-1"></i><strong><%= addonsSummary.loaded %></strong> loaded</span>
                                    <span><i class="fas fa-circle text-danger me-1"></i><strong><%= addonsSummary.errored %></strong> errored</span>
                                    <span><i class="fas fa-circle text-secondary me-1"></i><strong><%= addonsSummary.disabled %></strong> disabled</span>
                                </div>
                                <% if (addonsSummary.errored > 0) { %>
                                    <div class="mb-2">
                                        <small class="text-danger"><i class="fas fa-exclamation-triangle"></i> <%= addonsSummary.errored %> add-on(s) have errors</small>
                                    </div>
                                <% } %>
                            <% } else { %>
                                <p class="text-muted mb-2">No add-ons loaded.</p>
                            <% } %>
                            <a href="/admin/addons" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-puzzle-piece"></i> Manage Add-ons
                            </a>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2b: Per-addon cards (registered via AddonsManager.registerDashboardCard) -->
    <% if (typeof addonCards !== 'undefined' && addonCards && addonCards.length > 0) { %>
    <div class="row">
      <% addonCards.forEach(function(card) { %>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="card h-100">
          <div class="card-header">
            <h5 class="mb-0"><i class="<%= card.icon %> me-2"></i><%= card.title %></h5>
          </div>
          <div class="card-body">
            <% if (card.statusDetails && card.statusDetails.message) { %>
              <p class="text-muted small mb-3"><%= card.statusDetails.message %></p>
            <% } %>
            <a href="<%= card.adminUrl %>" class="btn btn-sm btn-outline-primary">
              <i class="fas fa-cog me-1"></i>Manage <%= card.title %>
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>

    <!-- Row 3: Page Management & Media Management -->
    <div class="row">

        <!-- Page Management -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-file-alt"></i> Page Management
                        <a href="/view/page-management" class="ms-1 text-muted" title="Documentation" target="_blank"><i class="fas fa-question-circle fa-sm"></i></a>
                    </h5>
                    <% if (typeof requiredPagesSyncNeeded !== 'undefined' && requiredPagesSyncNeeded > 0) { %>
                        <span class="badge bg-warning text-dark">
                            <i class="fas fa-exclamation-triangle me-1"></i><%= requiredPagesSyncNeeded %> need attention
                        </span>
                    <% } %>
                </div>
                <div class="card-body">
                    <% if (currentUser.roles.includes('admin')) { %>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="d-inline-flex align-items-center gap-1">
                            <button class="btn btn-outline-primary btn-sm" onclick="reindexPages()">
                                <i class="fas fa-sync"></i> Reindex Pages
                            </button>
                            <a href="/view/reindex-pages" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <button class="btn btn-warning btn-sm" onclick="rebuildPages()">
                                <i class="fas fa-database"></i> Rebuild Pages
                            </button>
                            <a href="/view/rebuild-pages" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/import" class="btn btn-info btn-sm">
                                <i class="fas fa-file-import"></i> Import Pages
                            </a>
                            <a href="/view/import-pages" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/convert" class="btn btn-outline-info btn-sm">
                                <i class="fas fa-wand-magic-sparkles"></i> Convert to NCM
                            </a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/required-pages" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-lock me-1"></i> Required Pages
                                <% if (typeof requiredPagesSyncNeeded !== 'undefined' && requiredPagesSyncNeeded > 0) { %>
                                    <span class="badge bg-warning text-dark ms-1"><%= requiredPagesSyncNeeded %></span>
                                <% } %>
                            </a>
                            <a href="/view/required-pages" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>
                    </div>
                    <% if (requiredPages && requiredPages.length > 0) { %>
                        <details>
                            <summary class="text-muted" style="cursor: pointer;">
                                <small><i class="fas fa-list me-1"></i>View <%= requiredPages.length %> installed required pages</small>
                            </summary>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                            <% requiredPages.forEach(page => { %>
                                <a href="/edit/<%= encodeURIComponent(page.name) %>" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-edit"></i> <%= page.name %>
                                    <% if (page.userModified) { %>
                                        <span class="badge bg-warning text-dark ms-1" title="Modified by admin">modified</span>
                                    <% } %>
                                </a>
                            <% }); %>
                            </div>
                        </details>
                    <% } %>
                    <% } else { %>
                        <p class="text-muted">Admin role required for these tools.</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Media Management — only shown when MediaManager is enabled -->
        <% if (capabilities && capabilities.media) { %>
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-photo-video"></i> Media Management
                        <a href="/view/media-management" class="ms-1 text-muted" title="Documentation" target="_blank"><i class="fas fa-question-circle fa-sm"></i></a>
                    </h5>
                </div>
                <div class="card-body">
                    <% if (currentUser.roles.includes('admin')) { %>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="d-inline-flex align-items-center gap-1">
                            <button id="dashboard-rescan-btn" class="btn btn-outline-secondary btn-sm" onclick="dashboardMediaRescan()">
                                <i class="fas fa-sync"></i> Reindex Media
                            </button>
                            <a href="/view/media" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <button id="dashboard-rebuild-btn" class="btn btn-warning btn-sm" onclick="dashboardMediaRebuild()">
                                <i class="fas fa-database"></i> Rebuild Media
                            </button>
                            <a href="/view/media" class="text-muted small" title="Documentation" target="_blank"><i class="fas fa-question-circle"></i></a>
                        </span>

                        <span class="d-inline-flex align-items-center gap-1">
                            <a href="/admin/media" class="btn btn-secondary btn-sm">
                                <i class="fas fa-photo-video"></i> Media Manager
                            </a>
                        </span>
                    </div>
                    <div id="dashboard-media-status" class="mt-2" style="display:none;"></div>
                    <% } else { %>
                        <p class="text-muted">Admin role required for these tools.</p>
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Metrics — only shown when MetricsManager is enabled -->
        <% if (capabilities && capabilities.metrics) { %>
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-body py-2">
                    <details>
                        <summary class="d-flex align-items-center gap-2" style="cursor: pointer;">
                            <i class="fas fa-chart-line"></i>
                            <strong>Metrics</strong>
                            <span class="badge bg-success ms-auto">active</span>
                        </summary>
                        <div class="mt-3">
                            <p class="text-muted small mb-2">Prometheus telemetry is active. Raw metrics are available at <a href="/metrics" target="_blank"><code>/metrics</code></a>. See <a href="/view/Using Metrics" target="_blank">Using Metrics</a> for configuration and query reference.</p>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="/metrics" target="_blank" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-terminal"></i> Raw Prometheus Data
                                </a>
                            </div>
                        </div>
                    </details>
                </div>
            </div>
        </div>
        <% } %>

    </div>

    <!-- Row 4: Recent Activity -->
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-body py-2">
                    <details>
                        <summary class="d-flex align-items-center gap-2" style="cursor: pointer;">
                            <i class="fas fa-history"></i>
                            <strong>Recent Activity</strong>
                            <span class="badge bg-secondary ms-auto"><%= recentActivity ? recentActivity.length : 0 %></span>
                        </summary>
                        <div class="mt-3">
                            <% if (recentActivity && recentActivity.length > 0) { %>
                                <% recentActivity.slice(0, 5).forEach(activity => { %>
                                    <div class="mb-2">
                                        <small class="text-muted"><%= activity.timestamp %></small><br>
                                        <%= activity.description %>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p class="text-muted">No recent activity to display.</p>
                            <% } %>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 4b: Session Manager (#776) — collapsible per-session list -->
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-body py-2">
                    <details id="session-manager-details">
                        <summary class="d-flex align-items-center gap-2" style="cursor: pointer;">
                            <i class="fas fa-id-badge"></i>
                            <strong>Session Manager</strong>
                            <span class="badge bg-secondary" id="session-manager-count">—</span>
                            <span class="text-muted small ms-auto">Click to expand &middot; one row per active session</span>
                        </summary>
                        <div class="mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted" id="session-manager-status">Loading…</small>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-warning" id="session-manager-clear-anon" title="Delete all anonymous (non-logged-in) sessions. Authenticated sessions and your own session are preserved. (#777)">
                                        <i class="fas fa-broom"></i> Clear anonymous
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="session-manager-refresh">
                                        <i class="fas fa-sync"></i> Refresh
                                    </button>
                                </div>
                            </div>
                            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-sm table-hover mb-0 small" id="session-manager-table">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>ID</th>
                                            <th class="session-sort" data-sort-key="username" style="cursor: pointer;" title="Click to sort by user — anonymous sessions sort to the end">User <span class="text-muted small">⇅</span></th>
                                            <th class="session-sort" data-sort-key="lastAccess" style="cursor: pointer;" title="Click to sort by last-access timestamp">Last Access <span class="text-muted small">⇅</span></th>
                                            <th class="session-sort" data-sort-key="expires" style="cursor: pointer;" title="Click to sort by cookie expiry">Expires <span class="text-muted small">⇅</span></th>
                                            <th class="session-sort" data-sort-key="isAuthenticated" style="cursor: pointer;" title="Authenticated — whether a logged-in user owns this session. Anonymous sessions are CSRF-token-only entries created on first visit and have no user.">Logged in? <span class="text-muted small">⇅</span></th>
                                            <th class="session-sort" data-sort-key="ip" style="cursor: pointer;" title="Client IP captured on first request. Older sessions created before IP-capture middleware shipped will be blank until next request.">IP <span class="text-muted small">⇅</span></th>
                                            <th title="Revoke this session — force-logout its owner. Your own row is marked and asks for an extra confirmation. (#787)">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="session-manager-rows">
                                        <tr><td colspan="7" class="text-center text-muted">Expand to load.</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function() {
        // #776: lazy-load the session list on first expand (don't pay the
        // potentially-large JSON serialisation cost on every admin page render).
        const details = document.getElementById('session-manager-details');
        if (!details) return;
        const tbody = document.getElementById('session-manager-rows');
        const countEl = document.getElementById('session-manager-count');
        const statusEl = document.getElementById('session-manager-status');
        const refreshBtn = document.getElementById('session-manager-refresh');
        let loaded = false;
        let currentSessions = [];     // latest fetched payload (raw, unsorted)
        let sortKey = null;           // current sort column key
        let sortDir = 1;              // 1 = asc, -1 = desc

        function fmtRel(iso) {
            if (!iso) return '—';
            const ms = Date.parse(iso);
            if (isNaN(ms)) return iso;
            const delta = ms - Date.now();
            const abs = Math.abs(delta);
            const past = delta < 0;
            const units = [
                [86400000, 'd'], [3600000, 'h'], [60000, 'm'], [1000, 's']
            ];
            for (const [size, label] of units) {
                if (abs >= size) {
                    const n = Math.round(abs / size);
                    return past ? n + label + ' ago' : 'in ' + n + label;
                }
            }
            return past ? 'just now' : 'imminent';
        }

        function escapeHtml(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function renderRows() {
            const sessions = sortedView(currentSessions);
            if (!sessions || sessions.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No sessions.</td></tr>';
                return;
            }
            tbody.innerHTML = sessions.map(function(s) {
                const idShort = s.id.length > 16 ? s.id.slice(0, 8) + '…' + s.id.slice(-4) : s.id;
                const userCell = s.username
                    ? '<span class="text-primary">' + escapeHtml(s.username) + '</span>'
                    : '<span class="text-muted fst-italic">(anon)</span>';
                const selfMark = s.isSelf ? ' <span class="badge bg-info text-dark ms-1" title="This is your own session">you</span>' : '';
                const expiredMark = s.expired ? ' <span class="badge bg-warning text-dark ms-1">expired</span>' : '';
                // Logged-in column: explicit text so the column meaning is self-evident
                // (was just an icon before — operators asked "what does this mean?" #776 follow-up).
                const authCell = s.isAuthenticated
                    ? '<span class="text-success fw-semibold">yes</span>'
                    : '<span class="text-muted">no</span>';
                // #787: Revoke button — encodes data attributes so the click handler can
                // safely look up the target without re-encoding in the onclick string.
                const revokeBtn = '<button type="button" class="btn btn-sm btn-link text-danger p-0 session-revoke-btn"'
                    + ' title="Revoke this session"'
                    + ' data-target-id="' + escapeHtml(s.id) + '"'
                    + ' data-target-user="' + escapeHtml(s.username || '') + '"'
                    + ' data-target-ip="' + escapeHtml(s.ip || '') + '"'
                    + ' data-target-self="' + (s.isSelf ? '1' : '0') + '"'
                    + '><i class="fas fa-times"></i></button>';
                return '<tr>'
                    + '<td><code class="small">' + escapeHtml(idShort) + '</code></td>'
                    + '<td>' + userCell + selfMark + '</td>'
                    + '<td>' + escapeHtml(fmtRel(s.lastAccess)) + '</td>'
                    + '<td>' + escapeHtml(fmtRel(s.expires)) + expiredMark + '</td>'
                    + '<td>' + authCell + '</td>'
                    + '<td>' + (s.ip ? '<code class="small">' + escapeHtml(s.ip) + '</code>' : '<span class="text-muted">—</span>') + '</td>'
                    + '<td>' + revokeBtn + '</td>'
                    + '</tr>';
            }).join('');
        }

        // Sort helpers: stable comparator that orders nullish values last regardless of direction.
        function compareForKey(a, b, key) {
            const av = a[key];
            const bv = b[key];
            const aNullish = av === null || av === undefined || av === '';
            const bNullish = bv === null || bv === undefined || bv === '';
            if (aNullish && bNullish) return 0;
            if (aNullish) return 1;   // nullish goes after non-nullish
            if (bNullish) return -1;
            if (typeof av === 'boolean' && typeof bv === 'boolean') return (av === bv) ? 0 : (av ? -1 : 1);
            // ISO timestamps and string-ipv4 sort lexicographically correctly enough for our purpose
            return av < bv ? -1 : av > bv ? 1 : 0;
        }
        function sortedView(sessions) {
            if (!sortKey) return sessions;
            const copy = sessions.slice();
            copy.sort(function(a, b) { return compareForKey(a, b, sortKey) * sortDir; });
            return copy;
        }

        async function load() {
            statusEl.textContent = 'Loading…';
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Loading…</td></tr>';
            try {
                const res = await fetch('/api/sessions/list', { credentials: 'same-origin' });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    statusEl.textContent = 'Error: ' + (err.error || ('HTTP ' + res.status));
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">' + escapeHtml(statusEl.textContent) + '</td></tr>';
                    return;
                }
                const data = await res.json();
                countEl.textContent = String(data.total);
                statusEl.textContent = data.total + ' session(s) loaded ' + fmtRel(new Date().toISOString());
                currentSessions = data.sessions || [];
                renderRows();
            } catch (e) {
                statusEl.textContent = 'Network error: ' + (e && e.message ? e.message : e);
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">' + escapeHtml(statusEl.textContent) + '</td></tr>';
            }
        }

        // Sortable headers — click toggles asc/desc on the clicked column.
        document.querySelectorAll('#session-manager-table th.session-sort').forEach(function(th) {
            th.addEventListener('click', function() {
                const key = th.getAttribute('data-sort-key');
                if (!key) return;
                if (sortKey === key) {
                    sortDir = -sortDir;
                } else {
                    sortKey = key;
                    sortDir = 1;
                }
                // Update arrow indicators
                document.querySelectorAll('#session-manager-table th.session-sort span').forEach(function(s) { s.textContent = '⇅'; });
                const arrowSpan = th.querySelector('span');
                if (arrowSpan) arrowSpan.textContent = sortDir > 0 ? '↑' : '↓';
                renderRows();
            });
        });

        details.addEventListener('toggle', function() {
            if (details.open && !loaded) {
                loaded = true;
                load();
            }
        });
        refreshBtn.addEventListener('click', load);

        // #777: clear anonymous sessions
        const clearAnonBtn = document.getElementById('session-manager-clear-anon');
        if (clearAnonBtn) {
            clearAnonBtn.addEventListener('click', async function() {
                const currentCount = (countEl.textContent || '').trim();
                const countHint = (currentCount && currentCount !== '—') ? ' (current total: ' + currentCount + ')' : '';
                if (!confirm('Delete all anonymous (non-logged-in) sessions' + countHint + '?\n\nAuthenticated sessions and your own session will be preserved.')) {
                    return;
                }
                clearAnonBtn.disabled = true;
                statusEl.textContent = 'Clearing…';
                try {
                    const res = await window.csrfFetch('/api/sessions/clear-anonymous', {
                        method: 'POST',
                        credentials: 'same-origin'
                    });
                    if (!res.ok) {
                        const err = await res.json().catch(() => ({}));
                        statusEl.textContent = 'Error: ' + (err.error || ('HTTP ' + res.status));
                        return;
                    }
                    const data = await res.json();
                    const sweepMsg = 'Cleared ' + data.removed + ' anonymous (kept ' + data.kept + ', removed ' + data.orphansRemoved + ' orphans).';
                    statusEl.textContent = sweepMsg;
                    // Reload the table to reflect the new state; load() overwrites
                    // statusEl with its own "N session(s) loaded" line, so re-apply
                    // our message after so the operator sees what just happened.
                    await load();
                    statusEl.textContent = sweepMsg;
                } catch (e) {
                    statusEl.textContent = 'Network error: ' + (e && e.message ? e.message : e);
                } finally {
                    clearAnonBtn.disabled = false;
                }
            });
        }

        // #787: per-row revoke. Click delegation on tbody so newly-rendered
        // rows (after a refresh) inherit the handler automatically.
        tbody.addEventListener('click', async function(evt) {
            const btn = evt.target.closest('.session-revoke-btn');
            if (!btn) return;
            const id = btn.getAttribute('data-target-id') || '';
            const user = btn.getAttribute('data-target-user') || '';
            const ip = btn.getAttribute('data-target-ip') || '';
            const isSelf = btn.getAttribute('data-target-self') === '1';
            if (!id) return;

            // Build a context-appropriate confirm message
            let prompt;
            if (isSelf) {
                prompt = 'This is YOUR OWN session. Revoking it will log you out immediately.\n\nContinue?';
            } else if (user) {
                prompt = 'Revoke session for ' + user + (ip ? ' @ ' + ip : '') + '?\n\nThey will be logged out.';
            } else {
                prompt = 'Revoke this anonymous session' + (ip ? ' from ' + ip : '') + '?';
            }
            if (!confirm(prompt)) return;

            btn.disabled = true;
            statusEl.textContent = 'Revoking…';
            try {
                const url = '/api/sessions/' + encodeURIComponent(id) + (isSelf ? '?confirm-self=1' : '');
                const res = await window.csrfFetch(url, { method: 'DELETE', credentials: 'same-origin' });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    statusEl.textContent = 'Revoke failed: ' + (err.error || ('HTTP ' + res.status));
                    btn.disabled = false;
                    return;
                }
                const data = await res.json();
                const shortId = (data.revokedId || id).slice(0, 8) + '…';
                const revokeMsg = 'Revoked session ' + shortId
                    + (data.revokedUsername ? ' (user=' + data.revokedUsername + ')' : ' (anonymous)')
                    + (data.selfRevoke ? ' — you have been logged out; refresh to land on /login' : '');
                statusEl.textContent = revokeMsg;
                if (!data.selfRevoke) {
                    await load();
                    // load() overwrites statusEl with its own "N session(s) loaded"
                    // line — restore our message so the operator sees what just
                    // happened instead of generic load output.
                    statusEl.textContent = revokeMsg;
                }
            } catch (e) {
                statusEl.textContent = 'Network error: ' + (e && e.message ? e.message : e);
                btn.disabled = false;
            }
        });
    })();
    </script>

    <!-- Row 5: System Notifications (bottom) -->
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-body py-2">
                    <details>
                        <summary class="d-flex align-items-center gap-2" style="cursor: pointer;">
                            <i class="fas fa-bell"></i>
                            <strong>System Notifications</strong>
                            <span class="badge bg-primary ms-auto"><%= notifications ? notifications.length : 0 %></span>
                        </summary>
                        <div class="mt-3">
                            <% if (notifications && notifications.length > 0) { %>
                                <% notifications.slice(0, 5).forEach(notification => { %>
                                    <div class="alert alert-<%= notification.level === 'warning' ? 'warning' : notification.level === 'error' ? 'danger' : notification.level === 'success' ? 'success' : 'info' %> border-0 mb-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="alert-heading mb-1"><%= notification.title %></h6>
                                                <p class="mb-1"><%= notification.message %></p>
                                                <small class="text-muted">
                                                    <i class="fas fa-clock"></i> <%= new Date(notification.createdAt).toLocaleString() %>
                                                    <% if (notification.type) { %>
                                                        <span class="badge bg-secondary ms-2"><%= notification.type %></span>
                                                    <% } %>
                                                </small>
                                            </div>
                                            <div class="ms-3">
                                                <form method="POST" action="/admin/notifications/<%= notification.id %>/dismiss" class="d-inline">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Dismiss notification">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>

                                <% if (totalNotificationCount > 5) { %>
                                    <div class="text-center mb-3">
                                        <a href="/admin/notifications" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-list"></i> View All Notifications (<%= totalNotificationCount %>)
                                        </a>
                                    </div>
                                <% } %>
                            <% } else { %>
                                <div class="text-center py-4">
                                    <i class="fas fa-bell-slash fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">No system notifications at this time.</p>
                                    <small class="text-muted">Notifications will appear here when system events occur.</small>
                                </div>
                            <% } %>
                            <div class="border-top pt-3 mt-3 d-flex justify-content-between">
                                <form method="POST" action="/admin/notifications/clear-all" class="d-inline">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Clear all notifications? This action cannot be undone.')">
                                        <i class="fas fa-trash"></i> Clear All
                                    </button>
                                </form>
                                <a href="/admin/notifications" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-cog"></i> Manage Notifications
                                </a>
                            </div>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
async function confirmRestart() {
    if (!confirm('Are you sure you want to restart the system? This will temporarily interrupt service.')) {
        return;
    }

    try {
        const response = await csrfFetch('/admin/restart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();

        if (result.success) {
            alert('System is restarting. The page will reload in a few seconds...');
            setTimeout(() => window.location.reload(), 5000);
        } else {
            alert('Error restarting system: ' + (result.error || 'Unknown error'));
        }
    } catch (error) {
        alert('Error restarting system: ' + error.message);
    }
}

async function clearCache() {
    if (!confirm('Are you sure you want to clear all cache data? This action cannot be undone.')) {
        return;
    }

    const button = document.querySelector('button[onclick="clearCache()"]');
    const originalHTML = button.innerHTML;

    try {
        button.disabled = true;
        button.textContent = 'Clearing...';

        const response = await csrfFetch('/api/admin/cache/clear', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();

        if (response.ok && result.success) {
            button.classList.remove('btn-outline-success');
            button.classList.add('btn-success');
            button.textContent = '✓ Cache Cleared';
            showMessage('All caches cleared successfully', 'success');
            setTimeout(() => {
                button.disabled = false;
                button.classList.remove('btn-success');
                button.classList.add('btn-outline-success');
                button.innerHTML = originalHTML;
            }, 3000);
        } else {
            throw new Error(result.error || 'Failed to clear cache');
        }
    } catch (error) {
        button.disabled = false;
        button.innerHTML = originalHTML;
        showMessage('Failed to clear cache: ' + error.message, 'error');
    }
}

async function reindexPages() {
    if (!confirm('Are you sure you want to reindex all pages? This will refresh the page cache and rebuild the search index.')) {
        return;
    }

    const button = document.querySelector('button[onclick="reindexPages()"]');
    const originalHTML = button.innerHTML;

    try {
        button.disabled = true;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Starting…';

        const csrfToken = document.querySelector('input[name="_csrf"]')?.value || '<%= csrfToken %>';

        const enqueueRes = await csrfFetch('/api/admin/jobs/pages.reindex/enqueue', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
        });
        const { runId } = await enqueueRes.json();
        if (!runId) throw new Error('Failed to start reindex job');

        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Reindexing…';

        // Poll until complete
        const run = await pollJobStatus(runId);
        if (run.status === 'completed') {
            button.classList.remove('btn-outline-primary');
            button.classList.add('btn-primary');
            button.innerHTML = '<i class="fas fa-check"></i> Reindexed';
            showMessage(`Reindex complete — ${run.result?.summary || ''}`, 'success');
            setTimeout(() => {
                button.disabled = false;
                button.classList.remove('btn-primary');
                button.classList.add('btn-outline-primary');
                button.innerHTML = originalHTML;
            }, 3000);
        } else {
            throw new Error(run.result?.error || 'Reindex failed');
        }
    } catch (error) {
        button.disabled = false;
        button.innerHTML = originalHTML;
        showMessage('Failed to reindex: ' + error.message, 'error');
    }
}

// #724: full rebuild from disk. Unlike Reindex (rebuilds the search
// structure from the persisted document cache), Rebuild clears that cache
// and re-scans every page from disk, so entries for deleted pages ("ghosts"
// still showing in search/listings) are dropped. Heavier than Reindex.
async function rebuildPages() {
    if (!confirm('Rebuild the page search index from disk?\n\nThis clears the persisted search cache and re-scans every page. Use it when deleted pages still appear in search/listings (Reindex cannot remove those). Slower than Reindex.')) {
        return;
    }

    const button = document.querySelector('button[onclick="rebuildPages()"]');
    const originalHTML = button.innerHTML;

    try {
        button.disabled = true;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Starting…';

        const csrfToken = document.querySelector('input[name="_csrf"]')?.value || '<%= csrfToken %>';

        const enqueueRes = await csrfFetch('/api/admin/jobs/pages.rebuild/enqueue', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
        });
        const { runId } = await enqueueRes.json();
        if (!runId) throw new Error('Failed to start rebuild job');

        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Rebuilding…';

        const run = await pollJobStatus(runId);
        if (run.status === 'completed') {
            button.classList.remove('btn-warning');
            button.classList.add('btn-success');
            button.innerHTML = '<i class="fas fa-check"></i> Rebuilt';
            showMessage(`Rebuild complete — ${run.result?.summary || ''}`, 'success');
            setTimeout(() => {
                button.disabled = false;
                button.classList.remove('btn-success');
                button.classList.add('btn-warning');
                button.innerHTML = originalHTML;
            }, 3000);
        } else {
            throw new Error(run.result?.error || 'Rebuild failed');
        }
    } catch (error) {
        button.disabled = false;
        button.innerHTML = originalHTML;
        showMessage('Failed to rebuild: ' + error.message, 'error');
    }
}

/** Poll /api/admin/jobs/:runId/status until status is completed or failed. */
async function pollJobStatus(runId, intervalMs = 1500, maxWaitMs = 600000) {
    const deadline = Date.now() + maxWaitMs;
    while (Date.now() < deadline) {
        await new Promise(r => setTimeout(r, intervalMs));
        const res = await csrfFetch(`/api/admin/jobs/${runId}/status`);
        if (!res.ok) throw new Error('Status check failed');
        const run = await res.json();
        if (run.status === 'completed' || run.status === 'failed') return run;
    }
    throw new Error('Job timed out');
}

function showMessage(message, type) {
    let messageEl = document.querySelector('#admin-message');
    if (!messageEl) {
        messageEl = document.createElement('div');
        messageEl.id = 'admin-message';
        messageEl.style.cssText = 'position:fixed;top:80px;right:20px;z-index:9999;min-width:350px;max-width:500px;box-shadow:0 4px 6px rgba(0,0,0,0.1)';
        document.body.appendChild(messageEl);
    }

    const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
    const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';

    messageEl.innerHTML = `
        <div class="card">
            <div class="card-header ${bgClass} text-white">
                <h6 class="mb-0"><i class="fas ${icon}"></i> ${type === 'success' ? 'Success' : 'Error'}</h6>
            </div>
            <div class="card-body">${message}</div>
        </div>`;
    messageEl.style.display = 'block';
    messageEl.style.opacity = '0';
    messageEl.style.transition = 'opacity 0.3s ease-in-out';
    setTimeout(() => messageEl.style.opacity = '1', 10);
    setTimeout(() => {
        messageEl.style.opacity = '0';
        setTimeout(() => messageEl.style.display = 'none', 300);
    }, 5000);
}

async function dashboardMediaRescan() {
    const btn = document.getElementById('dashboard-rescan-btn');
    const status = document.getElementById('dashboard-media-status');
    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Scanning…';
    status.style.display = 'none';
    try {
        const csrfToken = document.querySelector('input[name="_csrf"]')?.value || '<%= csrfToken %>';
        const enqueueRes = await csrfFetch('/api/admin/jobs/media.rescan/enqueue', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
        });
        const { runId } = await enqueueRes.json();
        if (!runId) throw new Error('Failed to start rescan job');
        const run = await pollJobStatus(runId);
        status.className = run.status === 'completed' ? 'alert alert-success' : 'alert alert-danger';
        status.innerHTML = run.status === 'completed'
            ? `<i class="fas fa-check-circle"></i> ${run.result?.summary || 'Reindex complete'}`
            : `<i class="fas fa-exclamation-triangle"></i> ${run.result?.error || 'Scan failed'}`;
        status.style.display = 'block';
    } catch (e) {
        status.className = 'alert alert-danger';
        status.innerHTML = `<i class="fas fa-exclamation-triangle"></i> ${e.message || 'Request failed'}`;
        status.style.display = 'block';
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalHTML;
    }
}

async function dashboardMediaRebuild() {
    if (!confirm('Delete the existing media index and rebuild from scratch? This may take several minutes.')) return;
    const btn = document.getElementById('dashboard-rebuild-btn');
    const status = document.getElementById('dashboard-media-status');
    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Rebuilding…';
    status.style.display = 'none';
    try {
        const csrfToken = document.querySelector('input[name="_csrf"]')?.value || '<%= csrfToken %>';
        const enqueueRes = await csrfFetch('/api/admin/jobs/media.rebuild/enqueue', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken }
        });
        const { runId } = await enqueueRes.json();
        if (!runId) throw new Error('Failed to start rebuild job');
        const run = await pollJobStatus(runId, 1500, 3600000);
        status.className = run.status === 'completed' ? 'alert alert-success' : 'alert alert-danger';
        status.innerHTML = run.status === 'completed'
            ? `<i class="fas fa-check-circle"></i> ${run.result?.summary || 'Rebuild complete'}`
            : `<i class="fas fa-exclamation-triangle"></i> ${run.result?.error || 'Rebuild failed'}`;
        status.style.display = 'block';
    } catch (e) {
        status.className = 'alert alert-danger';
        status.innerHTML = `<i class="fas fa-exclamation-triangle"></i> ${e.message || 'Request failed'}`;
        status.style.display = 'block';
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalHTML;
    }
}

// Check for updates on page load (non-blocking)
(async function() {
    try {
        const resp = await csrfFetch('/api/check-updates');
        if (!resp.ok) return;
        const data = await resp.json();
        const el = document.getElementById('update-check-result');
        if (!el) return;
        if (data.updateAvailable && data.latestVersion) {
            el.innerHTML = `<a href="${data.releaseUrl || '#'}" target="_blank" class="badge bg-warning text-dark text-decoration-none">
                <i class="fas fa-arrow-up"></i> v${data.latestVersion} available</a>`;
        } else if (data.latestVersion) {
            el.innerHTML = '<span class="text-muted"><i class="fas fa-check"></i> Up to date</span>';
        }
    } catch {
        // Silently ignore — network may be offline
    }
})();
</script>

<%- include('footer') %>
