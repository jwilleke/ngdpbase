<%# #2470: one status card, so far used only by the admin Backup page (other pages can take it up). A collapsible card whose
    header line is views/_card-summary.ejs (icon, name, grey note, badge on the right, help
    link, and a chevron that turns when the card is open). The `state` local is one of three
    (styled in themes/core.css; there is no green and no grey):
      plain (no colour, all is well, collapsed), amber (degraded, open), red (failed, open).
    A page where every card is collapsed means all is well.
    Include it twice, because EJS has no slots: with part 'start' it opens the card, the card's
    content follows, and with part 'end' it closes it.
    Locals for 'start': id, icon (a Font Awesome name), title, state, badge, and optionally hint
    (the grey note, in words), hintTime (an ISO time shown after the hint in the viewer's own
    time zone) and helpSlug (a help link to that wiki page). %>
<% if (locals.part === 'start') {
    // A misspelt state opens the card as amber: it must never hide a card that may need the admin.
    const tone = ['plain', 'amber', 'red'].includes(locals.state) ? locals.state : 'amber';
%>
<div class="card mb-4 status-card status-card-<%= tone %>" id="<%= locals.id %>" data-status="<%= tone %>">
    <div class="card-body py-2">
        <details<%= tone !== 'plain' ? ' open' : '' %>>
            <%- include('_card-summary', { icon: locals.icon + ' fa-fw', chevron: true, title: locals.title, hint: locals.hint, hintTime: locals.hintTime, badge: locals.badge, badgeClass: 'status-badge-' + tone, helpSlug: locals.helpSlug }) %>
            <div class="mt-3">
<% } else { %>
            </div>
        </details>
    </div>
</div>
<% } %>
