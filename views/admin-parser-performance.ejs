<%- include('header', { title: 'Page building speed' }) %>

<%
  // #2468: numbers as the reader sees them. Milliseconds to one decimal; a 0-to-1 ratio as a percent to one decimal.
  const ms = (v) => (Math.round(v * 10) / 10).toFixed(1);
  // Counts with thousands separators ("30,120"), the same on every site whatever its locale.
  const n = (v) => Number(v).toLocaleString('en-US');
  const pct = (v) => (Math.round(v * 1000) / 10).toFixed(1) + '%';
  const limitPct = (v) => String(Math.round(v * 1000) / 10);
  const windows = [
    ['hour', '1 hour'],
    ['day', '24 hours'],
    ['week', '7 days'],
    ['month', '30 days']
  ];
  const measures = [
    {
      key: 'parse',
      title: 'Page build time (ms)',
      note: 'Pages not already stored. Limit: ' + report.limits.parseTime + ' ms. Slower is too slow.',
      fmt: ms
    },
    {
      key: 'hit',
      title: 'Pages from stored copies (%)',
      note: 'Below ' + limitPct(report.limits.cacheHitRatio) + ' is too low, so the Slowest rows show the lowest values.',
      fmt: pct,
      // A low share is the bad end, so its Slowest rows take the lowest checks, not the highest.
      fields: { p95: 'p5', max: 'min' }
    },
    {
      key: 'err',
      title: 'Pages that failed to build (%)',
      note: 'Above ' + limitPct(report.limits.errorRate) + ' is too high.',
      fmt: pct
    }
  ];
  // "1 in 20" is one unit: it never wraps, so "20" cannot be left alone on a second line.
  const rows = [
    ['Typical', 'p50'],
    ['Slowest <span class="text-nowrap">1 in 20</span>', 'p95'],
    ['Slowest', 'max'],
    ['Average', 'mean']
  ];
  const fieldFor = (measure, field) => (measure.fields && measure.fields[field]) || field;
  const hasData = (key) => windows.some(([window]) => report.rollup[window][key]);
  const anyData = measures.some((measure) => hasData(measure.key));
  // A table whose count of checks with its number differs from the period's total says so on a row of its own.
  const countsDiffer = (key) => windows.some(([window]) => report.rollup[window][key] && report.rollup[window][key].count !== report.checks[window]);
  const hasLegacy = ['parse', 'hit', 'err'].some((k) => report.legacy[k]);
%>

<style>
  /* On a phone the four period columns have to fit without sideways scrolling. */
  @media (max-width: 420px) {
    .perf-table { font-size: 0.8rem; }
    .perf-table th, .perf-table td { padding-left: 0.2rem; padding-right: 0.2rem; }
  }
</style>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h2 mb-0 me-3"><i class="fas fa-gauge-high"></i> Page building speed</h1>
        <a href="/admin" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
      </div>

      <p>How quickly the site turns page text into what you read.</p>

      <details class="mb-4">
        <summary>What Typical, Slowest 1 in 20 and Slowest mean</summary>
        <p class="mt-2 mb-0">
          The site checks once a minute while pages are being viewed.
          Typical is the middle value. Slowest 1 in 20 is the value that 19 of 20 checks stayed under.
          Slowest is the worst check. For Pages from stored copies, a low share is the bad end,
          so there Slowest 1 in 20 and Slowest are the lowest values.
        </p>
      </details>

      <% if (!report.recording) { %>
        <div class="alert alert-warning" role="alert">
          <i class="fas fa-exclamation-triangle"></i>
          Page checks are not being saved because the site has no folder it can write them to.
          In Admin → Configuration, set <code class="text-reset">ngdpbase.<wbr>markup.<wbr>performance.<wbr>history.<wbr>dir</code> to a folder the site can write to, then restart.
        </div>
      <% } else if (!anyData) { %>
        <p class="text-muted">No checks recorded yet. They appear within a minute of pages being viewed.</p>
      <% } %>

      <% if (report.recording && anyData) { %>
      <% measures.forEach((measure) => { %>
        <div class="card mb-4" data-testid="parser-performance-<%= measure.key %>">
          <div class="card-header">
            <h5 class="mb-0"><%= measure.title %></h5>
          </div>
          <div class="card-body px-2 px-sm-3">
            <p class="text-muted"><%= measure.note %></p>
            <% if (!hasData(measure.key)) { %>
              <p class="mb-0">No checks recorded yet.</p>
            <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm small align-middle mb-0 perf-table">
                <thead>
                  <tr>
                    <th scope="col" class="fw-normal text-muted align-bottom">Checks</th>
                    <% windows.forEach(([window, label]) => { %>
                      <th scope="col" class="text-end">
                        <span class="text-nowrap"><%= label %></span>
                        <span class="d-block fw-normal text-muted small"><%= n(report.checks[window]) %><span class="visually-hidden"> checks</span></span>
                      </th>
                    <% }); %>
                  </tr>
                </thead>
                <tbody>
                  <% rows.forEach(([label, field], rowIndex) => { %>
                    <tr>
                      <th scope="row" class="fw-normal"><%- label %></th>
                      <% windows.forEach(([window]) => { %>
                        <% const s = report.rollup[window][measure.key]; %>
                        <% if (!s) { %>
                          <% if (rowIndex === 0) { %>
                            <td class="text-end text-muted small" rowspan="<%= rows.length %>">No checks in this period.</td>
                          <% } %>
                        <% } else { %>
                          <td class="text-end"><%= measure.fmt(s[fieldFor(measure, field)]) %></td>
                        <% } %>
                      <% }); %>
                    </tr>
                  <% }); %>
                  <% if (countsDiffer(measure.key)) { %>
                    <tr class="text-muted small">
                      <th scope="row" class="fw-normal">Checks with this number</th>
                      <% windows.forEach(([window]) => { %>
                        <% const s = report.rollup[window][measure.key]; %>
                        <td class="text-end"><%= s ? n(s.count) : '' %></td>
                      <% }); %>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
            <% } %>
          </div>
        </div>
      <% }); %>
      <% } %>

      <% if (hasLegacy) { %>
        <div class="card mb-4" data-testid="parser-performance-earlier">
          <div class="card-header">
            <h5 class="mb-0">Earlier warnings (only checks over the limit)</h5>
          </div>
          <div class="card-body px-2 px-sm-3">
            <p class="text-muted">
              Saved before this page existed, for checks over the limit only. Not a view of the whole site.
              The two percentages were totals since start-up: do not compare them with the tables above.
              For stored copies, the Slowest rows show the lowest values.
            </p>
            <div class="table-responsive">
              <table class="table table-sm small align-middle mb-0 perf-table">
                <thead>
                  <tr>
                    <th scope="col"></th>
                    <% measures.forEach((measure) => { %>
                      <th scope="col" class="text-end"><%= measure.title %></th>
                    <% }); %>
                  </tr>
                </thead>
                <tbody>
                  <% rows.concat([['Checks counted', 'count']]).forEach(([label, field]) => { %>
                    <tr>
                      <th scope="row" class="fw-normal"><%- label %></th>
                      <% measures.forEach((measure) => { %>
                        <% const s = report.legacy[measure.key]; %>
                        <td class="text-end">
                          <% if (!s) { %>
                            <span class="text-muted">&ndash;</span>
                          <% } else if (field === 'count') { %>
                            <%= n(s.count) %>
                          <% } else { %>
                            <%= measure.fmt(s[fieldFor(measure, field)]) %>
                          <% } %>
                        </td>
                      <% }); %>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('footer') %>
