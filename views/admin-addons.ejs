<%- include('header', { pageName: 'Add-ons' }) %>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-puzzle-piece"></i> Add-ons</h1>
        <a href="/admin" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <% if (!addons || addons.length === 0) { %>
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No add-ons discovered. Configure <code>ngdpbase.addons.path</code> to point to your add-ons directory.
        </div>
    <% } else { %>
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-exclamation-triangle"></i> <strong>Note:</strong> Enabling or disabling an add-on saves the configuration but requires a <strong>server restart</strong> to take effect.
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-list"></i> Discovered Add-ons (<%= addons.length %>)</h5>
                <div>
                    <span class="badge bg-success me-1"><%= addons.filter(a => a.loaded).length %> loaded</span>
                    <span class="badge bg-danger me-1"><%= addons.filter(a => a.error).length %> errored</span>
                    <span class="badge bg-secondary"><%= addons.filter(a => !a.enabled).length %> disabled</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Version</th>
                            <th>Description</th>
                            <th>Author</th>
                            <th>Dependencies</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% addons.forEach(addon => { %>
                        <tr>
                            <td>
                                <strong><%= addon.name %></strong>
                                <% if (addon.type === 'domain') { %>
                                    <span class="badge bg-primary ms-1" title="This addon is the primary site identity">DOMAIN</span>
                                <% } else if (addon.type === 'additive') { %>
                                    <span class="badge bg-secondary ms-1" title="This addon augments an existing wiki">ADDITIVE</span>
                                <% } %>
                            </td>
                            <td><code><%= addon.version || '—' %></code></td>
                            <td><% if (addon.description) { %><%= addon.description %><% } else { %><span class="text-muted">—</span><% } %></td>
                            <td><% if (addon.author) { %><%= addon.author %><% } else { %><span class="text-muted">—</span><% } %></td>
                            <td>
                                <% if (addon.dependencies && addon.dependencies.length > 0) { %>
                                    <% addon.dependencies.forEach(dep => { %>
                                        <span class="badge bg-secondary me-1"><%= dep %></span>
                                    <% }); %>
                                <% } else { %>
                                    <span class="text-muted">—</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (!addon.enabled) { %>
                                    <span class="badge bg-secondary">Disabled</span>
                                <% } else if (addon.loaded) { %>
                                    <span class="badge bg-success">Loaded</span>
                                <% } else if (addon.error) { %>
                                    <span class="badge bg-danger" title="<%= addon.error %>">Error</span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark">Not Loaded</span>
                                <% } %>
                            </td>
                            <td>
                                <form method="POST" action="/admin/addons/<%= encodeURIComponent(addon.name) %>/toggle" class="d-inline">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <% if (addon.enabled) { %>
                                        <input type="hidden" name="enabled" value="false">
                                        <button type="submit" class="btn btn-outline-warning btn-sm"<%- lockedUnless('config-manage') %>
                                            <%# #1414: an addon that owns private stores is warned, never refused. %>
                                            data-confirm="<%= 'Disable add-on "' + addon.name + '"? A restart is required for this to take effect.' + ((addon.disableWarnings && addon.disableWarnings.length) ? '\n\n' + addon.disableWarnings.join('\n') : '') %>"
                                            onclick="return confirm(this.dataset.confirm)">
                                            <i class="fas fa-pause"></i> Disable
                                        </button>
                                    <% } else { %>
                                        <input type="hidden" name="enabled" value="true">
                                        <button type="submit" class="btn btn-outline-success btn-sm"<%- lockedUnless('config-manage') %>
                                            onclick="return confirm('Enable add-on &quot;<%= addon.name %>&quot;? A restart is required for this to take effect.')">
                                            <i class="fas fa-play"></i> Enable
                                        </button>
                                    <% } %>
                                </form>
                                <% if (addon.hasTheme) { %>
                                    <form method="POST" action="/admin/addons/<%= encodeURIComponent(addon.name) %>/deploy-theme" class="d-inline ms-1">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn btn-outline-primary btn-sm"<%- lockedUnless('admin-system') %>
                                            title="Copy this add-on's theme/ into themes/<%= addon.name %>/ (overwrites; no restart needed)"
                                            <% if (addon.themeDeployed) { %>onclick="return confirm('Redeploy theme for &quot;<%= addon.name %>&quot;? This overwrites themes/<%= addon.name %>/ and discards any local theme edits.')"<% } %>>
                                            <i class="fas fa-palette"></i> <%= addon.themeDeployed ? 'Redeploy Theme' : 'Deploy Theme' %>
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                        <% if (addon.error) { %>
                        <tr>
                            <td colspan="7" class="border-top-0 pt-0">
                                <div class="alert alert-danger mb-0 py-1">
                                    <small><i class="fas fa-exclamation-triangle me-1"></i><strong>Error:</strong> <%= addon.error %></small>
                                </div>
                            </td>
                        </tr>
                        <% } %>
                        <% if (addon.details) { %>
                        <tr>
                            <td colspan="7" class="border-top-0 pt-0">
                                <details>
                                    <summary class="text-muted">
                                        <small><i class="fas fa-info-circle me-1"></i>Add-on details</small>
                                        <% if (addon.details.healthy === false) { %>
                                            <span class="badge bg-warning text-dark ms-2">unhealthy</span>
                                        <% } %>
                                    </summary>
                                    <div class="mt-2 ms-3">
                                        <% if (addon.details.message) { %>
                                            <div><small><strong>Message:</strong> <%= addon.details.message %></small></div>
                                        <% } %>
                                        <% if (addon.details.database) { %>
                                            <div><small><strong>Database:</strong> <code><%= addon.details.database %></code></small></div>
                                        <% } %>
                                        <% if (typeof addon.details.records !== 'undefined') { %>
                                            <div><small><strong>Records:</strong> <%= addon.details.records %></small></div>
                                        <% } %>
                                        <%
                                          const extraKeys = Object.keys(addon.details).filter(k => !['healthy','message','database','records'].includes(k));
                                        %>
                                        <% extraKeys.forEach(key => { %>
                                            <div><small><strong><%= key %>:</strong> <%= JSON.stringify(addon.details[key]) %></small></div>
                                        <% }); %>
                                    </div>
                                </details>
                            </td>
                        </tr>
                        <% } %>
                        <% if (addon.statusError) { %>
                        <tr>
                            <td colspan="7" class="border-top-0 pt-0">
                                <div class="alert alert-warning mb-0 py-1">
                                    <small><i class="fas fa-exclamation-circle me-1"></i><strong>Status error:</strong> <%= addon.statusError %></small>
                                </div>
                            </td>
                        </tr>
                        <% } %>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

    <%# #2100: add-ons installed from npm (ngdpbase.addons.install): pinned release, range, newest in range, Update. %>
    <% if (typeof installed !== 'undefined' && installed.length > 0) { %>
        <div class="card mt-4" id="installed-addons">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-download"></i> Installed from npm (<%= installed.length %>)</h5>
                <a href="/admin/addons#installed-addons" class="btn btn-outline-secondary btn-sm" title="Ask npm again for newer versions">
                    <i class="fas fa-sync"></i> Check
                </a>
            </div>
            <% if (installed.some(i => i.registryUnreachable)) { %>
                <div class="alert alert-warning m-3 mb-0" role="alert" id="registry-unreachable">
                    <i class="fas fa-exclamation-triangle"></i> npm couldn't be reached, so newer versions are not known right now. The site stays on the versions it has. Press Check to try again later.
                </div>
            <% } %>
            <div class="card-body pb-0">
                <p class="text-muted small mb-2">Restarting the site never updates an add-on; only Update does. An update is used from the next restart. <a href="/view/updating-add-ons">How updating works</a></p>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Add-on</th>
                            <th>Package</th>
                            <th>Installed</th>
                            <th>Allowed range</th>
                            <th>Newest in range</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% installed.forEach(item => { %>
                        <tr data-addon="<%= item.slug %>">
                            <td><strong><%= item.slug %></strong></td>
                            <td><% if (item.package) { %><code><%= item.package %></code><% } else { %><span class="text-muted">—</span><% } %></td>
                            <td><% if (item.pinned) { %><code><%= item.pinned %></code><% } else { %><span class="text-muted">—</span><% } %></td>
                            <td><% if (item.range) { %><code><%= item.range %></code><% } else { %><span class="text-muted">—</span><% } %></td>
                            <td>
                                <% if (item.newest) { %><code><%= item.newest %></code>
                                <% } else if (item.registryUnreachable) { %><span class="text-muted">unknown (npm unreachable)</span>
                                <% } else { %><span class="text-muted">—</span><% } %>
                            </td>
                            <td>
                                <% if (item.problem) { %>
                                    <span class="text-muted small"><%= item.problem %></span>
                                <% } else { %>
                                    <% if (item.pending) { %>
                                        <div class="small text-primary mb-1" data-pending="<%= item.pending %>"><i class="fas fa-redo"></i> Restart the site to use version <%= item.pending %></div>
                                    <% } %>
                                    <% if (item.available) { %>
                                        <form method="POST" action="/admin/addons/<%= encodeURIComponent(item.slug) %>/update" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="version" value="<%= item.available %>">
                                            <button type="submit" class="btn btn-outline-primary btn-sm"<%- lockedUnless('config-manage') %>
                                                data-confirm="<%= 'Update ' + item.slug + ' from ' + item.pinned + ' to ' + item.available + '? It is checked and downloaded now, and used from the next restart.' %>"
                                                onclick="return confirm(this.dataset.confirm)">
                                                <i class="fas fa-arrow-up"></i> Update to <%= item.available %>
                                            </button>
                                        </form>
                                    <% } %>
                                    <% if (item.needsCore) { %>
                                        <span class="badge bg-warning text-dark" title="<%= item.slug + ' ' + item.needsCore.version + ' needs a newer ngdpbase' %>"><%= item.needsCore.version %> needs ngdpbase ≥ <%= item.needsCore.minVersion %></span>
                                    <% } %>
                                    <% if (!item.available && !item.needsCore && !item.pending && !item.registryUnreachable) { %>
                                        <span class="badge bg-success">Up to date</span>
                                    <% } %>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

    <%# #1860: the databases add-ons declare, listed whether or not the add-on is on. %>
    <% if (typeof databases !== 'undefined' && databases.length > 0) { %>
        <div class="card mt-4" id="declared-databases">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-database"></i> Declared Databases (<%= databases.length %>)</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Database</th>
                            <th>Ledger</th>
                            <th>Declared by</th>
                            <th>Encryption</th>
                            <th>File</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% databases.forEach(db => { %>
                        <tr>
                            <td><strong><%= db.owner %></strong></td>
                            <td><code><%= db.ledgerTable %></code></td>
                            <td><%= db.declaredBy %></td>
                            <td>
                                <% if (db.encrypt === 'required') { %>
                                    <span class="badge bg-primary" title="Never opened without NGDPBASE_DATABASE_KEY">Required</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Optional</span>
                                <% } %>
                            </td>
                            <td><% if (db.file) { %><code><%= db.file %></code><% } else { %><span class="text-muted" title="ngdpbase.database.provider is none">No database configured</span><% } %></td>
                            <td>
                                <% if (db.open) { %>
                                    <span class="badge bg-success">Open</span>
                                <% } else if (!db.enabled) { %>
                                    <span class="badge bg-secondary">Add-on off</span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark">Not open</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

</div>

<%- include('footer') %>
