<%#
  Sync, or Force Sync for a copy edited on this site, for one shipped item
  (#1918): the row action of Admin -> Required Pages, shared by every admin
  screen that syncs shipped content. Force Sync always asks first; a plain
  Sync asks only when the caller passes `confirm`. No inline handler: the
  screen's own script acts on data-action and data-confirm.

  locals: syncItem, one object (an include also sees its parent's data, so a
  loose name could be picked up from the screen by accident), with:
    userModified  edited on this site: Force Sync, which replaces those edits
    name          the item's name, for the question Force Sync asks
    forceNote     optional: a line after that question (what happens to the edits)
    confirm       optional: a question a plain Sync asks first
    id            in-page mode: the item's id, sent with data-sync-id; the
                  screen's script syncs on a click (Required Pages)
    action        form mode: the URL a POST form sends to, with csrfToken; a
                  Force Sync sends overwrite=1 (the forms admin)
%>
<%
  var force = !!syncItem.userModified;
  var question = force
    ? 'Replace the edits made to "' + syncItem.name + '" on this site with the version that ships?' + (syncItem.forceNote ? '\n\n' + syncItem.forceNote : '')
    : syncItem.confirm;
%>
<% if (syncItem.action) { %>
<form method="POST" action="<%= syncItem.action %>" style="display:inline">
    <input type="hidden" name="_csrf" value="<%= syncItem.csrfToken %>">
    <% if (force) { %><input type="hidden" name="overwrite" value="1"><% } %>
    <button type="submit"
<% } else { %>
    <button type="button" data-sync-id="<%= syncItem.id %>" data-sync-name="<%= syncItem.name %>"
<% } %>
            class="btn btn-sm <%= force ? 'btn-outline-danger' : 'btn-outline-primary' %>"
            data-action="<%= force ? 'force-sync' : 'sync' %>"
            <% if (question) { %>data-confirm="<%= question %>"<% } %>
            <% if (force) { %>title="Edited on this site. Force Sync replaces those edits with the version that ships."<% } %>>
        <i class="fas fa-sync-alt"></i> <%= force ? 'Force Sync' : 'Sync' %>
    </button>
<% if (syncItem.action) { %>
</form>
<% } %>
