<%- include('header', { pageName: '' }) %>

<div class="container">
  <div class="row">
    <div class="col-12">
      <div class="card mt-4">
        <div class="card-header d-flex align-items-center justify-content-between">
          <h4 class="mb-0">
            <i class="fas <%= icon %>"></i> <%= title %>
            <span class="badge bg-secondary ms-2"><%= items.length %></span>
          </h4>
          <a href="/profile" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Profile
          </a>
        </div>
        <div class="card-body">
          <% if (typeof notice !== 'undefined' && notice) { %>
            <%# #1459: a restore refused because the title is taken says so, and
                says which — renaming the page silently would be worse. %>
            <div class="alert <%= notice === 'restored' || notice === 'purged' ? 'alert-success' : 'alert-warning' %>">
              <% if (notice === 'restored') { %>
                The page is back in its store, with its history.
              <% } else if (notice === 'purged') { %>
                The page, its history and its trash record are gone for good.
              <% } else if (notice.indexOf('title-conflict:') === 0) { %>
                That page cannot come back: the title <strong><%= notice.slice('title-conflict:'.length) %></strong> is in use in that store. Rename the page using it, then restore again.
              <% } else if (notice === 'file-missing') { %>
                The deleted page's file is no longer there, so it cannot be restored.
              <% } else { %>
                Nothing was changed.
              <% } %>
            </div>
          <% } %>
          <% if (!items || items.length === 0) { %>
            <p class="text-muted"><%= emptyMessage %></p>
          <% } else if (listKind === 'links') { %>
            <ul class="list-group">
              <% items.forEach(function(item) { %>
                <li class="list-group-item d-flex align-items-center justify-content-between">
                  <a href="<%= item.url %>" class="wikipage"><%= item.title %></a>
                  <% if (item.pinnedAt) { %>
                    <small class="text-muted">pinned <%= new Date(item.pinnedAt).toLocaleDateString() %></small>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } else if (listKind === 'takeout') { %>
            <%# #1387: the owner's own stores, and a download of each. The
                archive is DECRYPTED, so this says so once, plainly, and then
                gets out of the way — the person has chosen to take their data
                somewhere we cannot protect it, which is their right. %>
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle"></i>
              <strong>The download is not encrypted.</strong>
              It holds your pages and files as plain text, readable by anything on the
              device you save it to. Keeping it safe is yours to do from that point on.
            </div>
            <p class="text-muted">
              Each download holds your pages under their own titles, with their files.
              Page history and the contents of your trash are not included.
            </p>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Store</th>
                    <th style="width: 12%;">Pages</th>
                    <th style="width: 12%;">Files</th>
                    <th style="width: 14%;">Size</th>
                    <th style="width: 32%;">Download</th>
                  </tr>
                </thead>
                <tbody>
                  <% items.forEach(function(item) { %>
                    <tr>
                      <td><%= item.store %></td>
                      <% if (item.locked) { %>
                        <td colspan="3">
                          <span class="badge bg-secondary"><i class="fas fa-lock"></i> locked</span>
                          <small class="text-muted ms-2">Unlock this store to download it.</small>
                        </td>
                        <td></td>
                      <% } else { %>
                        <td><%= item.pageCount %></td>
                        <td><%= item.attachmentCount %></td>
                        <td>
                          <small class="text-muted">
                            <%= item.totalBytes < 1024 * 1024
                                ? (item.totalBytes / 1024).toFixed(1) + ' KB'
                                : (item.totalBytes / 1024 / 1024).toFixed(1) + ' MB' %>
                          </small>
                        </td>
                        <td>
                          <form method="POST" action="/my/takeout" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="store" value="<%= item.store %>">
                            <button type="submit" class="btn btn-sm btn-primary">
                              <i class="fas fa-download"></i> Everything
                            </button>
                          </form>
                          <% if (item.attachmentCount > 0) { %>
                            <form method="POST" action="/my/takeout" class="d-inline ms-1">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <input type="hidden" name="store" value="<%= item.store %>">
                              <input type="hidden" name="pagesOnly" value="true">
                              <button type="submit" class="btn btn-sm btn-outline-secondary"
                                      title="Your writing only, without the files">
                                <i class="fas fa-file-alt"></i> Pages only
                              </button>
                            </form>
                          <% } %>
                        </td>
                      <% } %>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else if (listKind === 'trash') { %>
            <%# #1459: the owner's own deleted private pages. Restore and
                permanent delete post back as ordinary forms with the session
                CSRF token — no fetch, so the page works without JS. %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Page</th>
                    <th style="width: 15%;">Store</th>
                    <th style="width: 20%;">Deleted</th>
                    <th style="width: 12%;">Removed in</th>
                    <th style="width: 20%;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% items.forEach(function(item) { %>
                    <tr>
                      <td><%= item.title %></td>
                      <td><small class="text-muted"><%= item.store %></small></td>
                      <td><small class="text-muted"><%= new Date(item.deletedAt).toLocaleString() %></small></td>
                      <td>
                        <% if (item.daysLeft === null) { %>
                          <small class="text-muted">kept</small>
                        <% } else if (item.daysLeft <= 0) { %>
                          <span class="badge bg-danger">due</span>
                        <% } else { %>
                          <small><%= item.daysLeft %> day<%= item.daysLeft === 1 ? '' : 's' %></small>
                        <% } %>
                      </td>
                      <td>
                        <form method="post" action="/my/trash/restore" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="store" value="<%= item.store %>">
                          <input type="hidden" name="uuid" value="<%= item.uuid %>">
                          <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-undo"></i> Restore
                          </button>
                        </form>
                        <form method="post" action="/my/trash/purge" class="d-inline"
                              onsubmit="return confirm('Delete this page for good? Its content and history cannot be brought back.');">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="store" value="<%= item.store %>">
                          <input type="hidden" name="uuid" value="<%= item.uuid %>">
                          <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-trash"></i> Delete for good
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else if (listKind === 'journal') { %>
            <ul class="list-group">
              <% items.forEach(function(item) { %>
                <li class="list-group-item">
                  <a href="<%= item.name ? pageUrl(item.name) : '/view/' + encodeURIComponent(item.uuid) %>" class="wikipage"><%= item.title %></a>
                  <small class="text-muted ms-2"><%= item.lastModified %></small>
                  <% if (item.preview) { %>
                    <div class="small text-muted mt-1"><%= item.preview %></div>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Page</th>
                    <th style="width: 25%;">Last Modified</th>
                    <th style="width: 15%;">Editor</th>
                    <th style="width: 12%;">Visibility</th>
                  </tr>
                </thead>
                <tbody>
                  <% items.forEach(function(item) { %>
                    <tr>
                      <td><a class="wikipage" href="<%= pageUrl(item.name || item.title) %>"><%= item.title %></a></td>
                      <td><small class="text-muted"><%= item.lastModified ? new Date(item.lastModified).toLocaleString() : '-' %></small></td>
                      <td><small><%= item.editor || '-' %></small></td>
                      <td>
                        <% if (item.isPrivate) { %>
                          <span class="badge bg-warning text-dark"><i class="fas fa-eye-slash"></i> Private</span>
                        <% } else { %>
                          <span class="badge bg-light text-dark">Public</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
          <% if (listKind === 'takeout' && typeof importStores !== 'undefined') { %>
            <%# #1472: a takeout handed back. Outside the list above, so someone
                arriving at a new site with no store yet can still bring one in.
                Posted with csrfFetch: the CSRF check runs before a multipart
                body is parsed, so a form field could not carry the token. %>
            <hr class="my-4">
            <h5><i class="fas fa-upload"></i> Import a download</h5>
            <p class="text-muted">
              Bring a download from this page — from this site or another — back into one of your stores.
              Pages already in the store are left as they are, so importing the same download twice changes nothing.
              History and trash are not in a download, so they do not come back.
            </p>
            <% if (importStores.length === 0) { %>
              <p class="text-muted">Unlock a store to import into it.</p>
            <% } else { %>
              <form id="takeoutImportForm" class="row g-2 align-items-end">
                <div class="col-sm-3">
                  <label for="takeoutImportStore" class="form-label">Into store</label>
                  <select id="takeoutImportStore" name="store" class="form-select form-select-sm">
                    <% importStores.forEach(function(s) { %>
                      <option value="<%= s %>"><%= s %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="col-sm-6">
                  <label for="takeoutImportFile" class="form-label">Download (.zip)</label>
                  <input id="takeoutImportFile" name="archive" type="file" accept=".zip,application/zip" class="form-control form-control-sm" required>
                </div>
                <div class="col-sm-3">
                  <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-upload"></i> Import</button>
                </div>
              </form>
              <div id="takeoutImportResult" class="mt-3" aria-live="polite"></div>
              <script>
                (function () {
                  var form = document.getElementById('takeoutImportForm');
                  var out = document.getElementById('takeoutImportResult');
                  var LABELS = {
                    'imported': 'Imported',
                    'unchanged': 'Already here, unchanged',
                    'changed-since-takeout': 'Changed since this download — your current page was kept',
                    'uuid-elsewhere': 'Already on this site elsewhere — not imported',
                    'failed': 'Could not be imported'
                  };
                  function line(text, cls) {
                    var p = document.createElement('div');
                    if (cls) p.className = cls;
                    p.textContent = text;
                    return p;
                  }
                  form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var button = form.querySelector('button');
                    button.disabled = true;
                    out.replaceChildren(line('Importing…', 'alert alert-info'));
                    try {
                      var res = await (window.csrfFetch || fetch)('/my/takeout/import', { method: 'POST', body: new FormData(form) });
                      var data = await res.json();
                      if (!data.success) {
                        out.replaceChildren(line(data.error || 'The import failed.', 'alert alert-danger'));
                        return;
                      }
                      var r = data.report;
                      var imported = r.pages.filter(function (p) { return p.outcome === 'imported'; }).length;
                      var summary = line(imported + ' page(s) imported, ' + r.files + ' file(s) stored, into ' + r.store + '.', 'alert alert-success');
                      var list = document.createElement('ul');
                      list.className = 'list-unstyled small';
                      r.pages.forEach(function (p) {
                        var li = document.createElement('li');
                        var text = p.title + ' — ' + (LABELS[p.outcome] || p.outcome);
                        if (p.outcome === 'imported' && p.importedAs && p.importedAs.split('/').pop() !== p.title) {
                          text += ' as “' + p.importedAs.split('/').pop() + '”';
                        }
                        if (p.where) text += ' (' + p.where + ')';
                        if (p.message) text += ': ' + p.message;
                        li.textContent = text;
                        list.appendChild(li);
                      });
                      r.unlinkedFiles.forEach(function (f) {
                        list.appendChild(line('File ' + f + ' — stored, but no page in this store links to it'));
                      });
                      r.fileErrors.forEach(function (f) {
                        list.appendChild(line('File ' + f.name + ' — could not be stored: ' + f.message));
                      });
                      out.replaceChildren(summary, list);
                    } catch (err) {
                      out.replaceChildren(line('The import failed: ' + err.message, 'alert alert-danger'));
                    } finally {
                      button.disabled = false;
                    }
                  });
                })();
              </script>
            <% } %>
          <% } %>
          <%# #1302: all five of the "my" lists render through this view, so one
              control here covers pages, journal entries and links alike. %>
          <% if (typeof paginationHtml !== 'undefined' && paginationHtml) { %>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <small class="text-muted"><%= items.length %> of <%= totalItems %></small>
              <%- paginationHtml %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('footer') %>
