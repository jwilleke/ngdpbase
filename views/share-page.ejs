<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">
</head>
<body class="bg-body">
<%# Standalone read-only share page view (#853). Known v1 caveat: links
    inside the rendered content point at normal /view/ URLs the anonymous
    visitor may not be able to open. %>
<div class="container mt-4 mb-5">
    <nav class="mb-3">
        <a href="/share/<%= token %>" class="text-decoration-none">
            <i class="fas fa-arrow-left"></i> <%= keyword %>
        </a>
    </nav>
    <h1><%= pageTitle %></h1>
    <hr>
    <div class="wiki-content">
        <%- html %>
    </div>
</div>
</body>
</html>
