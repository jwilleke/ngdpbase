<%- include('header', { pageName: 'Shared links' }) %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="fas fa-share-nodes"></i> Shared links <%- include('_help-icon', { slug: 'share-links', label: 'Shared links' }) %></h1>
    </div>

    <% if (createdId) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> Link made. Copy it from the list below and send it to whoever should see it.</div>
    <% } %>
    <% if (revoked) { %>
        <div class="alert alert-info"><i class="fas fa-ban"></i> Link stopped. It stopped working immediately.</div>
    <% } %>
    <% if (error === 'keyword') { %>
        <div class="alert alert-danger">Choose a tag to share.</div>
    <% } else if (error === 'ttl') { %>
        <div class="alert alert-danger">Choose how long the link lasts.</div>
    <% } else if (error === 'vault') { %>
        <div class="alert alert-danger">Choose one of your vaults.</div>
    <% } else if (error === 'days') { %>
        <div class="alert alert-danger">Choose a lifetime within that vault's limit.</div>
    <% } else if (error === 'pages') { %>
        <div class="alert alert-danger">Choose at least one page.</div>
    <% } else if (error === 'hours') { %>
        <div class="alert alert-danger">A link is extended by 1 to 24 hours at a time.</div>
    <% } %>

    <%- include('_vault-link-result') %>
    <% if (notice === 'revoked') { %>
        <div class="alert alert-info"><i class="fas fa-ban"></i> Link stopped. It stopped working immediately.</div>
    <% } else if (notice === 'extended') { %>
        <div class="alert alert-info"><i class="fas fa-clock"></i> Link extended.</div>
    <% } else if (notice === 'not-extended') { %>
        <div class="alert alert-warning">That link can no longer be extended: it has expired or was revoked.</div>
    <% } %>

    <% if (mayTag || mayVault) {
        const choice = shareChoice === 'tag' && mayTag ? 'tag' : shareChoice === 'vault' && mayVault ? 'vault' : (mayTag && !mayVault ? 'tag' : (mayVault && !mayTag ? 'vault' : ''));
    %>
    <details class="card mb-4" id="share-new" <%= (shareChoice || createdId || rows.length === 0) ? 'open' : '' %>>
        <summary class="card-body py-2"><strong>Share&hellip;</strong> <span class="text-muted small">Choose what to share.</span></summary>
        <div class="card-body pt-0">
            <% if (mayTag && mayVault) { %>
            <div class="btn-group mb-3" role="group" aria-label="What to share" data-share-chooser>
                <a class="btn btn-sm <%= choice === 'tag' ? 'btn-primary' : 'btn-outline-primary' %>" href="/my/shares?share=tag#share-new">Everything with a tag</a>
                <a class="btn btn-sm <%= choice === 'vault' ? 'btn-primary' : 'btn-outline-primary' %>" href="/my/shares?share=vault#share-new">Pages in a private area</a>
            </div>
            <% } %>
            <% if (choice === 'tag') { %>
            <h2 class="h6">Everything with a tag</h2>
            <p class="text-muted small mb-2">Shares every page and file with the tag, with anyone who has the link. Anything marked <code class="text-nowrap">owner-only</code> and private pages are never included.</p>
            <form method="post" action="/shares/create" class="row g-2 align-items-end mb-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-auto">
                    <label for="share-keyword" class="form-label small mb-0">Tag</label>
                    <input type="text" class="form-control form-control-sm" id="share-keyword" name="keyword" value="<%= tagPrefill %>" required>
                </div>
                <div class="col-auto">
                    <label for="share-ttl" class="form-label small mb-0">Lasts</label>
                    <select class="form-select form-select-sm" id="share-ttl" name="ttl">
                        <option value="24h">24 hours</option>
                        <option value="7d" selected>7 days</option>
                        <option value="30d">30 days</option>
                        <option value="never">Until cancelled</option>
                    </select>
                </div>
                <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-plus"></i> Make link</button></div>
            </form>
            <% } else if (choice === 'vault') { %>
            <details class="mb-3">
                <summary class="small">How shared links work</summary>
                <%- include('_vault-link-explanation') %>
            </details>
            <%- include('_vault-link-forms', { plainWholeVault: true }) %>
            <% } %>
        </div>
    </details>
    <% } %>

    <% if (rows.length === 0) { %>
        <div class="alert alert-info">
            <% if (mayTag || mayVault) { %>
                You haven't shared anything yet. Choose what to share above and press Make link.
            <% } else { %>
                You have no shared links, and you may not make any.
            <% } %>
        </div>
    <% } else {
        const statusText = function (row) { return row.status === 'page not available' ? 'Page no longer available' : row.status.charAt(0).toUpperCase() + row.status.slice(1); };
        const heading = function (row) { return row.label || pageTitles[row.id] || ''; };
        const endsText = function (row) { return row.status === 'active' ? 'Active, ' + (row.expiresAt ? 'ends ' + row.expiresAt.slice(0, 10) : 'until cancelled') : statusText(row); };
    %>
        <div class="table-responsive d-none d-md-block">
            <table id="sharedLinksTable" class="table table-sm align-middle shared-links d-none d-md-table">
                <thead><tr><th>What</th><th>Status</th><th>Expires</th><th>Made</th><th>Link</th><th>Actions</th></tr></thead>
                <tbody>
                <% rows.forEach(function (row) { %>
                    <% const dim = row.status === 'active' ? '' : ' class="text-muted"'; %>
                    <tr data-share-id="<%= row.id %>" data-status="<%= row.status %>">
                        <td<%- dim %>>
                            <% if (heading(row)) { %><strong><%= heading(row) %></strong><br><% } %>
                            <%= row.what %>
                        </td>
                        <td<%- dim %>><%= statusText(row) %></td>
                        <td class="text-nowrap<%= dim ? ' text-muted' : '' %>"><%= row.expiresAt ? row.expiresAt.slice(0, 10) : 'Until cancelled' %></td>
                        <td class="text-nowrap<%= dim ? ' text-muted' : '' %>" data-made><%= row.createdAt.slice(0, 10) %></td>
                        <td class="shared-link-cell<%= dim ? ' text-muted' : '' %>"><%- include('_shared-link-address', { row: row, addresses: addresses }) %></td>
                        <td class="text-nowrap<%= dim ? ' text-muted' : '' %>"><%- include('_shared-link-actions', { row: row }) %></td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
        </div>
        <div class="d-md-none">
            <% rows.forEach(function (row) { %>
                <div class="card mb-3" data-share-card="<%= row.id %>">
                    <div class="card-body">
                        <% if (heading(row)) { %><div><strong><%= heading(row) %></strong></div><% } %>
                        <div><%= row.what %></div>
                        <div class="small text-muted mb-2"><%= endsText(row) %>. Made <%= row.createdAt.slice(0, 10) %></div>
                        <% if (addresses[row.id] || row.status === 'active') { %>
                        <div class="mb-2"><%- include('_shared-link-address', { row: row, addresses: addresses }) %></div>
                        <% } %>
                        <%- include('_shared-link-actions', { row: row }) %>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<%- include('_vault-link-scripts') %>
<script nonce="<%= locals.cspNonce %>">
    // Copy: the browser clipboard when there is one, else select the address and copy it.
    document.addEventListener('click', function (event) {
        var button = event.target.closest ? event.target.closest('[data-copy-link]') : null;
        if (!button) return;
        var input = button.parentNode.querySelector('input');
        var help = button.parentNode.parentNode.querySelector('[data-copy-help]');
        var done = function () {
            if (help) help.hidden = true;
            button.innerHTML = '<i class="fas fa-check"></i>';
            setTimeout(function () { button.innerHTML = '<i class="fas fa-copy"></i>'; }, 2000);
        };
        // Nothing could copy: keep the address selected and say how to copy it by hand.
        var failed = function () {
            try { input.focus(); input.select(); } catch (e) { /* the address is still on the page */ }
            if (help) help.hidden = false;
        };
        var fallback = function () {
            var copied = false;
            try { input.select(); copied = !!(document.execCommand && document.execCommand('copy')); } catch (e) { copied = false; }
            if (copied) done(); else failed();
        };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(input.value).then(done, fallback);
        else fallback();
    });
</script>

<%- include('footer') %>
