<%- include('header', { pageName: 'Shared links' }) %>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="fas fa-share-nodes"></i> Shared links <%- include('_help-icon', { slug: 'share-links', label: 'Shared links' }) %></h1>
    </div>

    <% if (createdId) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> Link made. It appears in the list below.</div>
    <% } %>
    <% if (revoked) { %>
        <div class="alert alert-info"><i class="fas fa-ban"></i> Link stopped. It stopped working immediately.</div>
    <% } %>
    <% if (error === 'keyword') { %>
        <div class="alert alert-danger">Choose a tag to share.</div>
    <% } else if (error === 'ttl') { %>
        <div class="alert alert-danger">Choose how long the link lasts.</div>
    <% } %>

    <% if (mayTag || mayVault) { %>
    <details class="card mb-4" id="share-new" <%= shareChoice ? 'open' : '' %>>
        <summary class="card-body py-2"><strong>Share&hellip;</strong> <span class="text-muted small">Choose what to share.</span></summary>
        <div class="card-body pt-0">
            <% if (mayTag) { %>
            <h2 class="h6">Everything with a tag</h2>
            <p class="text-muted small mb-2">Shares every page and file with the tag, with anyone who has the link. Anything marked <code>owner-only</code> and private pages are never included.</p>
            <form method="post" action="/shares/create" class="row g-2 align-items-end mb-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-auto">
                    <label for="share-keyword" class="form-label small mb-0">Tag</label>
                    <input type="text" class="form-control form-control-sm" id="share-keyword" name="keyword" value="<%= tagPrefill %>" required>
                </div>
                <div class="col-auto">
                    <label for="share-ttl" class="form-label small mb-0">Lasts</label>
                    <select class="form-select form-select-sm" id="share-ttl" name="ttl">
                        <option value="24h">24 hours</option>
                        <option value="7d" selected>7 days</option>
                        <option value="30d">30 days</option>
                        <option value="never">Until cancelled</option>
                    </select>
                </div>
                <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-plus"></i> Make link</button></div>
            </form>
            <% } %>
            <% if (mayVault) { %>
            <h2 class="h6">Pages in a private area</h2>
            <p class="text-muted small mb-0">Choose pages, or a whole private area, on <a href="/my/vaults/links<%= pagePrefill ? '?page=' + encodeURIComponent(pagePrefill) : '' %>">the private area links page</a>.</p>
            <% } %>
        </div>
    </details>
    <% } %>

    <% if (rows.length === 0) { %>
        <div class="alert alert-info">
            <% if (mayTag || mayVault) { %>
                You haven't shared anything yet. A shared link lets someone read pages without signing in.
            <% } else { %>
                You have no shared links, and you may not make any.
            <% } %>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table id="sharedLinksTable" class="table table-sm align-middle">
                <thead><tr><th>What</th><th>Status</th><th>Expires</th><th>Actions</th></tr></thead>
                <tbody>
                <% rows.forEach(function (row) { %>
                    <tr data-share-id="<%= row.id %>" data-status="<%= row.status %>">
                        <td><%= row.what %></td>
                        <td><%= row.status === 'page not available' ? 'Page not available (404)' : row.status.charAt(0).toUpperCase() + row.status.slice(1) %></td>
                        <td><%= row.expiresAt ? row.expiresAt.slice(0, 10) : 'Until cancelled' %></td>
                        <td>
                            <% if (row.actions.indexOf('extend') !== -1 || row.actions.indexOf('visits') !== -1) { %>
                                <a class="btn btn-sm btn-outline-secondary" href="/my/vaults/links">Extend or see visits</a>
                            <% } %>
                            <% if (row.actions.indexOf('revoke') !== -1) { %>
                                <form method="post" action="<%= row.kind === 'tag' ? '/shares/' + row.id + '/revoke' : '/my/vaults/links/' + row.id + '/revoke' %>" class="d-inline">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-ban"></i> Revoke</button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<%- include('footer') %>
