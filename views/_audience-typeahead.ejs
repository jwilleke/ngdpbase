<%#
  Audience users typeahead (#710).

  Renders the username-typeahead widget that complements the role-checkbox
  dropdown above. Behaviour and contract documented in
  public/js/audience-typeahead.js.

  Locals expected:
    - pageData (optional) — existing page metadata; pageData.metadata.audience
      is split: role-name entries stay in the role-checkbox dropdown above,
      non-role entries are pre-rendered here as chips.
    - availableRoles — needed to identify which audience entries are roles
      vs usernames. Iterated via `.some(r => r.name === entry)`.
%>
<%
  var _existingAudience = (typeof pageData !== 'undefined' && pageData && pageData.metadata && Array.isArray(pageData.metadata.audience))
    ? pageData.metadata.audience : [];
  var _roleNames = (typeof availableRoles !== 'undefined' && Array.isArray(availableRoles))
    ? availableRoles.map(function (r) { return r.name; }) : [];
  var _userAudience = _existingAudience.filter(function (a) {
    return _roleNames.indexOf(a) === -1;
  });
%>
<div class="mt-3" data-audience-typeahead>
  <label class="form-label small fw-semibold mb-1" for="audienceUserSearch">
    Or add specific users:
  </label>
  <div class="d-flex flex-wrap mb-2" data-audience-chips>
    <% _userAudience.forEach(function (username) { %>
      <span class="badge bg-info-subtle text-dark border d-inline-flex align-items-center me-1 mb-1" style="font-weight:normal;">
        <i class="fas fa-user me-1" aria-hidden="true"></i>
        <span class="audience-chip-label"><%= username %></span>
        <input type="hidden" name="audience" value="<%= username %>">
        <button type="button" class="btn-close btn-close-sm ms-2 audience-user-remove" aria-label="Remove <%= username %> from audience"></button>
      </span>
    <% }); %>
  </div>
  <div class="position-relative">
    <input type="text" id="audienceUserSearch" class="form-control form-control-sm"
           data-audience-search
           placeholder="Type a username or name…" autocomplete="off">
    <ul class="list-group position-absolute w-100 d-none shadow-sm"
        data-audience-results
        style="z-index:1050; max-height:240px; overflow-y:auto; top:100%;"></ul>
  </div>
  <small class="text-muted d-block mt-1">Search users to grant individual view access. Roles above + users here combine into the page's audience list.</small>
</div>
<script src="/js/audience-typeahead.js" defer></script>
