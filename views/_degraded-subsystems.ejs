<%# #1155 — a manager that is configured, wanted and NOT working. Thirteen
    managers could reach this state and only auditing reported it, so a bad
    backup directory meant backups silently never ran while the dashboard
    looked healthy. Deliberately DISABLED managers are excluded upstream: a
    banner that warns about features somebody switched off is one nobody
    reads, and the real warning goes with it. Not dismissible, for the same
    reason as the audit banner on the dashboard.

    #1946 — two sections, by the `kind` the manager declared: `outage` is
    down, `attention` works but has something for an admin to do (save the
    backup key, fix a value). Telling an operator backups are "silently doing
    nothing" while they run is a false alarm. Each shows only with entries. %>
<%# #2348: an item is its reason alone. The internal manager name ("PolicyEvaluator") and the
    configuration key mean nothing to an administrator, so neither is shown. The state word
    ("degraded") is not either: the section's headline already says down or needs attention.
    Where the item came from a setting changed in Admin → Configuration, a plain link goes there. %>
<% function subsystemList(entries) { %>
    <ul class="small text-muted mt-1 mb-0">
        <% entries.forEach(function (m) { %>
            <li>
                <%= m.reason || 'No details were recorded.' %>
                <% if (m.configKey && String(m.configKey).indexOf('ngdpbase.') === 0) { %>
                    <br><a href="/admin/configuration">Change this in Admin &rarr; Configuration</a>
                <% } %>
            </li>
        <% }); %>
    </ul>
<% } %>
<% if (degradedManagers && degradedManagers.length > 0) { %>
    <div class="alert alert-warning d-flex align-items-start" role="alert" id="subsystems-down">
        <i class="fas fa-triangle-exclamation me-2 mt-1" aria-hidden="true"></i>
        <div>
            <strong><%= degradedManagers.length %> subsystem<%= degradedManagers.length === 1 ? ' is' : 's are' %> not working.</strong>
            Configured and wanted, but unavailable &mdash; the features they provide are silently doing nothing.
            <% subsystemList(degradedManagers); %>
        </div>
    </div>
<% } %>
<% if (attentionManagers && attentionManagers.length > 0) { %>
    <div class="alert alert-info d-flex align-items-start" role="status" id="subsystems-attention">
        <i class="fas fa-circle-info me-2 mt-1" aria-hidden="true"></i>
        <div>
            <strong>Working, but needs your attention.</strong>
            <%= attentionManagers.length === 1 ? 'This feature is running, but an administrator has something to do:' : 'These features are running, but each has something for an administrator to do:' %>
            <% subsystemList(attentionManagers); %>
        </div>
    </div>
<% } %>
