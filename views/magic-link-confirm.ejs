<%- include('header', { pageName: '' }) %>

<%
// #1019 — magic-link sign-in interstitial.
//
// Reached by GET /auth/magic-link/verify, which validates the token WITHOUT
// consuming it. The token is spent only when this form is POSTed, so a mail
// security scanner pre-fetching the link cannot burn it: the POST carries a
// per-session CSRF token the scanner has no way to obtain.
//
// Keep this page free of anything that auto-submits — no meta refresh, no
// scripted form.submit(). The deliberate click is the whole point.
%>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card mt-5">
                <div class="card-header text-center">
                    <h4>Sign in to <%= typeof applicationName !== 'undefined' ? applicationName : 'ngdpbase' %></h4>
                </div>
                <div class="card-body">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger">
                            <%= error %>
                        </div>
                    <% } %>

                    <p class="text-center mb-4">
                        Your link is valid. Click below to finish signing in as
                        <strong><%= username %></strong>.
                    </p>

                    <form action="/auth/magic-link/verify" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="token" value="<%= token %>">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-sign-in-alt"></i> Click to sign in
                        </button>
                    </form>

                    <p class="text-muted small text-center mt-3 mb-0">
                        This link can only be used once. If you did not request it, close this page
                        and it will expire on its own.
                    </p>

                    <hr>
                    <div class="text-center">
                        <p class="mb-0"><a href="/login">← Back to login</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
