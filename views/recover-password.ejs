<%- include('header', { pageName: '' }) %>
<%
  // #1452 — a forgotten password, reset with the 12 recovery words. For people
  // who created an encrypted private store and wrote the words down then. One
  // answer for every failure, so this page never says whether an account exists.
%>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card mt-4">
        <div class="card-header">
          <h4 class="mb-0"><i class="fas fa-key"></i> Reset your password with your recovery words</h4>
        </div>
        <div class="card-body">
          <% if (error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>
          <p>
            If you created an encrypted private store, you were given twelve recovery words. They let you set a new
            password when you have forgotten the old one. Your encrypted pages stay readable, and the same twelve
            words keep working afterwards.
          </p>
          <p class="text-muted small">
            No encrypted store, no recovery words: ask the site's administrator to reset your password instead.
          </p>
          <form method="POST" action="/recover-password" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label class="form-label" for="recoverUsername">Username</label>
              <input type="text" class="form-control" id="recoverUsername" name="username"
                     value="<%= username %>" autocomplete="username" required <%= username ? '' : 'autofocus' %>>
            </div>
            <div class="mb-3">
              <label class="form-label" for="recoverWords">Your 12 recovery words</label>
              <textarea class="form-control font-monospace" id="recoverWords" name="words" rows="3"
                        autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false"
                        required <%= username ? 'autofocus' : '' %>></textarea>
              <div class="form-text">In order, separated by spaces. Capitals and extra spaces do not matter.</div>
            </div>
            <div class="mb-3">
              <label class="form-label" for="recoverPassword">New password</label>
              <input type="password" class="form-control" id="recoverPassword" name="password"
                     autocomplete="new-password" minlength="<%= minPasswordLength %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label" for="recoverConfirm">New password again</label>
              <input type="password" class="form-control" id="recoverConfirm" name="confirmPassword"
                     autocomplete="new-password" minlength="<%= minPasswordLength %>" required>
            </div>
            <button type="submit" class="btn btn-primary">Set the new password</button>
            <a class="btn btn-link" href="/login">Back to sign in</a>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('footer') %>
