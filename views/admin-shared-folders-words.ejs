<%- include('header', { pageName: 'Shared folders: recovery words' }) %>
<%# #2124, #2144 (epic #1775 decision 4) — the organization's 12 shared-folders recovery words, made on Admin -> Backup
    (the first set, or a new set replacing it). Two steps, as the store door:
    - words: shown once, with Download as a file and Print (from the set still waiting; nothing is kept on the
      server once it is confirmed);
    - confirm: all 12 typed back and "I have saved them" ticked (WikiRoutes.adminSharedFoldersWordsSave); words that
      do not match save nothing and may be typed again while the set waits.
    Locals: step ('words' | 'confirm'), replacing (boolean), words (string[], words step), token, wordCount,
    recoveryWordsDocument (ConsentDocument or null), error (optional), csrfToken. %>
<% const _what = replacing ? 'new set of recovery words' : 'recovery words'; %>

<div class="container mt-4" style="max-width:760px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-key"></i> Shared folders: <%= replacing ? 'a new set of recovery words' : 'recovery words' %></h1>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" role="alert" id="shared-folders-words-error"><%= error %></div>
    <% } %>

    <% if (step === 'words') { %>
    <div class="alert alert-danger" role="alert" id="shared-folders-words-warning">
        <strong>Write these <%= words.length %> words down now, in order, or download or print them.</strong>
        They are shown only once, and only to you, and are not kept on this server. If this site's shared-folders key is ever lost, these words are the only
        way to open the organization's shared folders again. Keep them off this server and away from its backups,
        for example on paper with the organization's important papers.
        <% if (replacing) { %>Until you finish, the old words keep working; once you finish, they stop opening the folders.<% } %>
    </div>

    <%- include('_recovery-words-show', { words: words, listId: 'shared-folders-words', copyId: 'shared-folders-words-copy', downloadAction: '/admin/backup/shared-folders/words/download', printAction: '/admin/backup/shared-folders/words/print', exportFields: { token: token } }) %>

    <p>On the next page you will type all <%= words.length %> back. They will not be shown again, and cannot be downloaded or printed once you finish.</p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="/admin/backup/shared-folders/words/confirm" id="shared-folders-words-next">I have written them down</a>
        <form method="POST" action="/admin/backup/shared-folders/words/cancel" class="mb-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-link"<%- lockedUnless('admin-system') %>>Cancel (nothing is saved<%= replacing ? '; the old words stay' : '' %>)</button>
        </form>
    </div>

    <% } else { %>
    <p>Type the <%= wordCount %> <%= _what %>, in order. Nothing is saved until they match.</p>
    <form method="POST" action="/admin/backup/shared-folders/words/save" id="shared-folders-words-save" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="token" value="<%= token %>">
        <%- include('_recovery-words-typeback') %>
        <%- include('_recovery-words-consent', {
            recoveryWordsText: 'Each shared folder is locked with its own key, kept under this site\'s shared-folders key and under these words. If the shared-folders key is lost, an administrator can open the folders again only with these 12 words; without them the folders are lost for good.',
            recoveryWordsMore: 'Read more about the shared folders\' recovery words',
            recoveryWordsTick: 'I have saved these recovery words off this server and understand they are the only way back if the shared-folders key is lost'
        }) %>
        <button type="submit" class="btn btn-primary mt-3"<%- lockedUnless('admin-system') %>><i class="fas fa-check"></i> I have saved them — finish</button>
    </form>
    <form method="POST" action="/admin/backup/shared-folders/words/cancel" class="mt-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-link px-0"<%- lockedUnless('admin-system') %>>Start over: discard these words (nothing is saved<%= replacing ? '; the old words stay' : '' %>)</button>
    </form>
    <% } %>
</div>

<%- include('footer') %>
