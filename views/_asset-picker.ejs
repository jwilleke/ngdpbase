<%
/*
 * _asset-picker.ejs — shared Browse Assets / Search component
 *
 * Expected locals:
 *   assetPickerMode        : 'page' | 'modal'
 *   assetPickerInsert      : true | false   (show Insert button vs Copy button)
 *   assetPickerPageName    : string | undefined  (wiki page context for upload)
 *   assetPickerInitQuery   : string | undefined  (pre-populate query on load)
 *   assetPickerInitSource  : 'attachment' | 'media' | 'page' | 'user' | '' | undefined
 *                            (pre-select source filter)
 *   assetPickerInitMime    : 'image' | 'document' | 'other' | '' | undefined
 *                            (pre-select mime category filter, attachments only)
 *   assetPickerInitFilters : { category?: string[], keywords?: string[],
 *                              systemKeywords?: string[], searchIn?: string[] } | undefined
 *                            UI controls for these are tracked in #691; this slice (#696)
 *                            just threads them through to /api/assets/search so bookmarked
 *                            URLs like /search?category=foo continue returning filtered
 *                            results.
 */
var _apMode        = typeof assetPickerMode        !== 'undefined' ? assetPickerMode        : 'page';
var _apInsert      = typeof assetPickerInsert       !== 'undefined' ? assetPickerInsert       : false;
var _apPageName    = typeof assetPickerPageName     !== 'undefined' ? assetPickerPageName     : '';
var _apInitQuery   = typeof assetPickerInitQuery    !== 'undefined' ? assetPickerInitQuery    : '';
var _apInitSource  = typeof assetPickerInitSource   !== 'undefined' ? assetPickerInitSource   : '';
var _apInitMime    = typeof assetPickerInitMime     !== 'undefined' ? assetPickerInitMime     : '';
var _apInitFilters = typeof assetPickerInitFilters  !== 'undefined' && assetPickerInitFilters ? assetPickerInitFilters : {};
%>

<!-- Controls bar -->
<div class="row g-2 mb-2">
    <div class="col">
        <input type="text" id="ap-query" class="form-control"
               placeholder="Search by filename, description, year&hellip;"
               autocomplete="off">
    </div>
    <div class="col-auto">
        <select id="ap-source" class="form-select" title="Asset source">
            <option value="">All sources</option>
            <option value="attachment">Attachments only</option>
            <option value="media">Media library only</option>
            <option value="page">Pages</option>
            <option value="user">Users</option>
        </select>
    </div>
    <div class="col-auto" id="ap-mime-col">
        <select id="ap-mime" class="form-select" title="File type">
            <option value="">All formats</option>
            <option value="image">Images</option>
            <option value="document">Documents</option>
            <option value="other">Other</option>
        </select>
    </div>
    <%# Slice 1a (#744): sort moved out of this row into the compact icon
        results-toolbar below. #ap-sort stays as a hidden state-holder so all
        existing JS (value read, change listener, #692/#700 logic) is unchanged. %>
    <div id="ap-sort-col" hidden>
        <select id="ap-sort" title="Sort order">
            <option value="date-desc">Date &darr; (newest)</option>
            <option value="date-asc">Date &uarr; (oldest)</option>
            <option value="caption-asc">Name A&ndash;Z</option>
            <option value="caption-desc">Name Z&ndash;A</option>
        </select>
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="button" class="btn btn-primary" id="ap-search-btn">
            <i class="fas fa-search"></i> <span class="d-none d-sm-inline">Search</span>
        </button>
        <button type="button" class="btn btn-outline-secondary" id="ap-upload-btn" title="Upload Attachment">
            <i class="fas fa-upload"></i> <span class="d-none d-sm-inline">Upload</span>
        </button>
    </div>
</div>

<!-- Advanced filters row (date range, path prefix, hidden toggle) -->
<div class="row g-2 mb-3" id="ap-advanced-row">
    <div class="col-auto" id="ap-date-col">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
            <input type="date" id="ap-date-from" class="form-control form-control-sm" title="From date" style="max-width:140px;">
            <span class="input-group-text">&ndash;</span>
            <input type="date" id="ap-date-to" class="form-control form-control-sm" title="To date" style="max-width:140px;">
            <select id="ap-date-field" class="form-select form-select-sm" title="Date field" style="max-width:120px;">
                <option value="mtime">File date</option>
                <option value="exif_datetime">EXIF date</option>
            </select>
        </div>
    </div>
    <div class="col-auto" id="ap-path-col">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="fas fa-folder"></i></span>
            <input type="text" id="ap-path-prefix" class="form-control form-control-sm" placeholder="Path prefix&hellip;" style="max-width:160px;" autocomplete="off">
        </div>
    </div>
    <div class="col-auto d-flex align-items-center" id="ap-hidden-col">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="ap-include-hidden">
            <label class="form-check-label small" for="ap-include-hidden">Include archived</label>
        </div>
    </div>
    <div class="col-auto d-flex align-items-center" id="ap-fulltext-col" style="display:none;">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="ap-fulltext">
            <label class="form-check-label small" for="ap-fulltext" title="Off = match page titles only (default). On = also search page body/content.">Full text</label>
        </div>
    </div>
</div>

<!-- Layout: facet sidebar + results -->
<div class="d-flex gap-3">
    <!-- Facet sidebar -->
    <div id="ap-facets" class="flex-shrink-0" style="width:160px;display:none;"></div>

    <!-- Results grid -->
    <%# min-width:0 lets this flex child shrink when the 160px facet sidebar
        appears after a search — without it the row overflows the viewport
        to the right (classic flexbox min-width:auto trap). %>
    <div class="flex-grow-1" style="min-width:0;">
        <!-- #733: view-mode toggle at the top of the results (moved from the
             pagination footer). Same IDs — Slice 2 JS wiring is unchanged. -->
        <%# Slice 1a (#744): compact icon results-toolbar — sort dropdown-button
            co-located with the existing list/grid view toggle. %>
        <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="Sort order">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                        id="ap-sort-btn" data-bs-toggle="dropdown" aria-expanded="false" title="Sort order">
                    <i class="fas fa-sort-amount-down"></i>
                    <span class="d-none d-sm-inline ms-1" id="ap-sort-label">Date &darr; (newest)</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" id="ap-sort-menu" aria-labelledby="ap-sort-btn">
                    <li><button type="button" class="dropdown-item" data-sort="date-desc">Date &darr; (newest)</button></li>
                    <li><button type="button" class="dropdown-item" data-sort="date-asc">Date &uarr; (oldest)</button></li>
                    <li><button type="button" class="dropdown-item" data-sort="caption-asc">Name A&ndash;Z</button></li>
                    <li><button type="button" class="dropdown-item" data-sort="caption-desc">Name Z&ndash;A</button></li>
                </ul>
            </div>
            <div class="btn-group btn-group-sm" role="group" aria-label="Result view mode">
                <button type="button" class="btn btn-outline-secondary" id="ap-view-list" title="List view"><i class="fas fa-list"></i></button>
                <button type="button" class="btn btn-outline-secondary" id="ap-view-grid" title="Grid view"><i class="fas fa-th"></i></button>
            </div>
        </div>
        <div id="ap-results" class="row g-2<% if (_apMode === 'modal') { %> ap-modal-scroll<% } %>">
            <div class="col-12 text-center text-muted py-5" id="ap-placeholder">
                <i class="fas fa-search fa-2x mb-2 d-block"></i>
                Enter a search term or leave blank to browse all assets.
            </div>
        </div>
    </div>
</div>

<!-- Pagination footer -->
<div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">
    <small class="text-muted" id="ap-count"></small>
    <nav aria-label="Asset browser pagination">
        <ul class="pagination pagination-sm mb-0" id="ap-pagination"></ul>
    </nav>
</div>

<style>
/* #731: list view is the default for all result types; grid is one toggle away. */
.ap-list { display: flex; flex-direction: column; gap: .5rem; }
.ap-row { display: flex; align-items: flex-start; gap: .75rem; }
.ap-row-thumb { flex: 0 0 56px; width: 56px; height: 56px; display: flex;
    align-items: center; justify-content: center; overflow: hidden;
    border-radius: .25rem; background: var(--bs-tertiary-bg, #f1f3f5); }
.ap-row-thumb img { width: 56px; height: 56px; object-fit: cover; }
.ap-row-body { flex: 1 1 auto; min-width: 0; }
.ap-row-act { flex: 0 0 auto; }
</style>
<% if (_apMode === 'modal') { %>
<style>
.ap-modal-scroll { max-height: 55vh; overflow-y: auto; }
</style>
<% } %>

<script>
(function () {
    var AP_PAGE_SIZE = 48;
    var _apPage   = 0;      // zero-based page index
    var _apTotal  = 0;
    var _apItems  = [];     // current page results (for index-based insert/copy)
    var _apTimer  = null;
    var _apInsert = <%- _apInsert ? 'true' : 'false' %>;
    var _apPage_  = <%- JSON.stringify(_apPageName) %>;  // wiki page name for upload

    // DOM refs
    var qEl          = document.getElementById('ap-query');
    var srcEl        = document.getElementById('ap-source');
    var mimeEl       = document.getElementById('ap-mime');
    var sortEl       = document.getElementById('ap-sort');
    var dateFromEl   = document.getElementById('ap-date-from');
    var dateToEl     = document.getElementById('ap-date-to');
    var dateFieldEl  = document.getElementById('ap-date-field');
    var pathPrefixEl = document.getElementById('ap-path-prefix');
    var inclHiddenEl = document.getElementById('ap-include-hidden');
    var fulltextEl   = document.getElementById('ap-fulltext');
    var fulltextColEl = document.getElementById('ap-fulltext-col');
    var facetsEl     = document.getElementById('ap-facets');
    var resEl        = document.getElementById('ap-results');
    var cntEl        = document.getElementById('ap-count');
    var pagEl        = document.getElementById('ap-pagination');
    var listBtn      = document.getElementById('ap-view-list');
    var gridBtn      = document.getElementById('ap-view-grid');

    // #731: list is the default layout for ALL result types; grid stays one
    // toggle away. The choice is persisted per browser. Toggling re-renders
    // the current results in place — no refetch, no navigation.
    var AP_MODAL = <%- _apMode === 'modal' ? 'true' : 'false' %>;
    var _apView = (function () {
        try { return localStorage.getItem('ap-view') === 'grid' ? 'grid' : 'list'; }
        catch (e) { return 'list'; }
    })();
    function _apSetView(v) {
        _apView = (v === 'grid') ? 'grid' : 'list';
        try { localStorage.setItem('ap-view', _apView); } catch (e) { /* private mode */ }
        if (listBtn) listBtn.classList.toggle('active', _apView === 'list');
        if (gridBtn) gridBtn.classList.toggle('active', _apView === 'grid');
        _apRenderResults();
    }
    if (listBtn) listBtn.addEventListener('click', function () { _apSetView('list'); });
    if (gridBtn) gridBtn.addEventListener('click', function () { _apSetView('grid'); });

    // Slice 1a (#744): the compact sort dropdown drives the hidden #ap-sort
    // select. Selecting an item sets the select's value and dispatches its
    // native 'change' — the existing listener (below) runs the search. No
    // change to _apSearch or _apUpdateControls; #ap-sort stays authoritative.
    var sortBtnLabel = document.getElementById('ap-sort-label');
    var sortMenuItems = document.querySelectorAll('#ap-sort-menu .dropdown-item');
    function _apSyncSortBtn() {
        var v = sortEl.value;
        sortMenuItems.forEach(function (it) {
            it.classList.toggle('active', it.getAttribute('data-sort') === v);
        });
        var active = document.querySelector('#ap-sort-menu .dropdown-item[data-sort="' + v + '"]');
        if (sortBtnLabel && active) sortBtnLabel.textContent = active.textContent.trim();
    }
    sortMenuItems.forEach(function (it) {
        it.addEventListener('click', function () {
            var v = it.getAttribute('data-sort');
            if (v && v !== sortEl.value) {
                sortEl.value = v;
                sortEl.dispatchEvent(new Event('change'));
            }
            _apSyncSortBtn();
        });
    });

    // Wire controls
    qEl.addEventListener('input', function () {
        clearTimeout(_apTimer);
        _apTimer = setTimeout(function () { _apSearch(0); }, 350);
    });
    qEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { clearTimeout(_apTimer); _apSearch(0); }
    });
    srcEl.addEventListener('change',       function () { _apUpdateControls(); _apSearch(0); });
    mimeEl.addEventListener('change',      function () { _apSearch(0); });
    sortEl.addEventListener('change',      function () { _apSearch(0); });
    dateFromEl.addEventListener('change',  function () { _apSearch(0); });
    dateToEl.addEventListener('change',    function () { _apSearch(0); });
    dateFieldEl.addEventListener('change', function () { _apSearch(0); });
    pathPrefixEl.addEventListener('input', function () {
        clearTimeout(_apTimer);
        _apTimer = setTimeout(function () { _apSearch(0); }, 400);
    });
    inclHiddenEl.addEventListener('change', function () { _apSearch(0); });
    if (fulltextEl) fulltextEl.addEventListener('change', function () { _apSearch(0); });
    document.getElementById('ap-search-btn').addEventListener('click', function () { _apSearch(0); });
    document.getElementById('ap-upload-btn').addEventListener('click', function () {
        if (typeof window.showUploadAttachment === 'function') {
            window.showUploadAttachment(_apPage_ || null);
        }
    });

    // #692 — when source is page or user, file-type / sort / upload / the
    // advanced filter row don't apply. Disable + dim with a tooltip rather
    // than hide, so the layout doesn't jump and the user can see what
    // controls exist for other source types.
    var mimeColEl    = document.getElementById('ap-mime-col');
    var sortColEl    = document.getElementById('ap-sort-col');
    var uploadBtnEl  = document.getElementById('ap-upload-btn');
    var advancedRow  = document.getElementById('ap-advanced-row');
    function _apUpdateControls() {
        var isPageOrUser = srcEl.value === 'page' || srcEl.value === 'user';
        var sourceLabel = srcEl.value === 'page' ? 'pages' : srcEl.value === 'user' ? 'users' : 'this source';
        var notApplicable = 'Not applicable to ' + sourceLabel;
        function _apApply(wrapperEl, controls, defaultTitle) {
            if (wrapperEl) {
                wrapperEl.style.opacity = isPageOrUser ? '0.5' : '';
                wrapperEl.title = isPageOrUser ? notApplicable : (defaultTitle || '');
            }
            controls.forEach(function (el) {
                if (el) el.disabled = isPageOrUser;
            });
        }
        _apApply(mimeColEl, [mimeEl]);
        // Sort dropdown intentionally NOT disabled for pages/users — they
        // have sortable fields (lastModified / dateCreated / displayName).
        // Backend sort wiring for those source types is tracked in #700.
        // The wrapper IS the upload button; restore its original title when re-enabled.
        _apApply(uploadBtnEl, [uploadBtnEl], 'Upload Attachment');
        _apApply(advancedRow, [dateFromEl, dateToEl, dateFieldEl, pathPrefixEl, inclHiddenEl]);
        // #739: the Full-text toggle only applies to page search.
        if (fulltextColEl) fulltextColEl.style.display = (srcEl.value === 'page') ? '' : 'none';
    }
    _apUpdateControls();

    // Expose for modal wrapper to call on open
    window.apRunSearch = function () { _apSearch(0); };

    // ------------------------------------------------------------------ search

    async function _apSearch(page) {
        _apPage = page;
        var q       = qEl.value.trim();
        var src     = srcEl.value;
        var mime    = mimeEl.value;
        var sortVal = sortEl.value;
        var parts   = sortVal.split('-');
        var sortField = parts[0];
        var sortOrder = parts[1];

        resEl.innerHTML = '<div class="col-12 text-center py-5"><i class="fas fa-spinner fa-spin fa-2x text-muted"></i></div>';
        cntEl.textContent = '';
        pagEl.innerHTML = '';

        try {
            var params = new URLSearchParams({
                pageSize : String(AP_PAGE_SIZE),
                offset   : String(page * AP_PAGE_SIZE),
                sort     : sortField,
                order    : sortOrder
            });
            if (q)    params.set('q',            q);
            if (src)  params.set('types',         src);
            if (mime) params.set('mimeCategory',  mime);
            var dateFrom = dateFromEl ? dateFromEl.value : '';
            var dateTo   = dateToEl   ? dateToEl.value   : '';
            var dateField = dateFieldEl ? dateFieldEl.value : '';
            if (dateFrom) params.set('dateFrom', dateFrom);
            if (dateTo)   params.set('dateTo',   dateTo);
            if (dateField && dateField !== 'mtime') params.set('dateField', dateField);
            var pathPfx = pathPrefixEl ? pathPrefixEl.value.trim() : '';
            if (pathPfx) params.set('pathPrefix', pathPfx);
            if (inclHiddenEl && inclHiddenEl.checked) params.set('includeHidden', 'true');

            // #696: hidden page-source filters (category / keywords / etc.) seeded
            // from URL params on init. No UI controls today (#691); we forward
            // them on every search so bookmarked /search?category=foo URLs return
            // filtered results. Filters apply regardless of source dropdown — if
            // the user switches to Media, the page filters get ignored by the
            // backend (Media branch doesn't read them). Acceptable for v1.
            if (_apHiddenFilters) {
                ['category', 'keywords', 'systemKeywords', 'searchIn'].forEach(function (key) {
                    var vals = _apHiddenFilters[key];
                    if (Array.isArray(vals)) {
                        vals.forEach(function (v) { if (v) params.append(key, v); });
                    } else if (typeof vals === 'string' && vals) {
                        params.append(key, vals);
                    }
                });
            }

            // #739: for page search the Full-text checkbox is the authoritative
            // searchIn control. Unchecked → omit searchIn (server defaults to
            // TITLE). Checked → search all fields (title + body/content/etc.).
            if (src === 'page') {
                params.delete('searchIn');
                if (fulltextEl && fulltextEl.checked) params.set('searchIn', 'all');
            }

            var resp = await csrfFetch('/api/assets/search?' + params.toString());
            if (!resp.ok) throw new Error('Search failed (' + resp.status + ')');
            var data = await resp.json();

            _apRenderFacets(data.aggregations);

            if (!data.success || !data.results || !data.results.length) {
                _apItems = [];
                _apTotal = 0;
                resEl.innerHTML = '<div class="col-12 text-center text-muted py-5">No assets found.</div>';
                return;
            }

            _apItems = data.results;
            _apTotal = data.total || data.results.length;

            var totalPages  = Math.ceil(_apTotal / AP_PAGE_SIZE);
            var start       = page * AP_PAGE_SIZE + 1;
            var end         = Math.min(page * AP_PAGE_SIZE + data.results.length, _apTotal);

            cntEl.textContent = _apTotal.toLocaleString() + ' result' + (_apTotal !== 1 ? 's' : '') +
                (_apTotal > AP_PAGE_SIZE ? ' \u00b7 showing ' + start + '\u2013' + end : '');

            _apRenderResults();

            if (totalPages > 1) {
                WikiPagination.renderNav(pagEl, page + 1, totalPages, function (oneBased) {
                    resEl.scrollTop = 0;
                    _apSearch(oneBased - 1);
                });
            }

        } catch (err) {
            _apItems = [];
            resEl.innerHTML = '<div class="col-12 text-center text-danger py-4"><i class="fas fa-exclamation-triangle"></i> ' + _esc(err.message) + '</div>';
        }
    }

    // ------------------------------------------------------------------ facets

    function _apRenderFacets(aggs) {
        if (!facetsEl) return;
        if (!aggs || (!aggs.byMime && !aggs.byYear && !aggs.byFolder && !aggs.byExtension)) {
            facetsEl.style.display = 'none';
            facetsEl.innerHTML = '';
            return;
        }
        facetsEl.style.display = '';
        var html = '';
        if (aggs.byMime && aggs.byMime.length) {
            html += _apFacetGroup('Type', aggs.byMime.slice(0, 8), function (f) {
                mimeEl.value = '';
                if (mimeEl) mimeEl.value = '';
                if (mime) params && params.set ? '' : null;
                params = null; // reset — will be rebuilt on next search
                if (mimeEl) mimeEl.dispatchEvent(new Event('change'));
                if (mimeEl) mimeEl.value = '';
                return 'mime=' + encodeURIComponent(f.key);
            });
        }
        if (aggs.byYear && aggs.byYear.length) {
            html += _apFacetGroup('Year', aggs.byYear.slice(0, 10), null);
        }
        if (aggs.byExtension && aggs.byExtension.length) {
            html += _apFacetGroup('Extension', aggs.byExtension.slice(0, 8), null);
        }
        facetsEl.innerHTML = html;
        // Wire facet clicks
        facetsEl.querySelectorAll('[data-ap-facet-mime]').forEach(function (el) {
            el.addEventListener('click', function () {
                var v = el.getAttribute('data-ap-facet-mime');
                // Set hidden params for next search by appending to URL directly
                params = null;
                _apActiveFacet = { mime: v };
                _apSearch(0);
            });
        });
        facetsEl.querySelectorAll('[data-ap-facet-ext]').forEach(function (el) {
            el.addEventListener('click', function () {
                _apActiveFacet = { extension: el.getAttribute('data-ap-facet-ext') };
                _apSearch(0);
            });
        });
    }

    var _apActiveFacet = {};

    function _apFacetGroup(label, facets, _unused) {
        var rows = facets.map(function (f) {
            var attr = label === 'Type' ? 'data-ap-facet-mime="' + _esc(f.key) + '"'
                     : label === 'Extension' ? 'data-ap-facet-ext="' + _esc(f.key) + '"'
                     : '';
            return '<div class="d-flex justify-content-between small py-1 border-bottom" ' + attr +
                   (attr ? ' style="cursor:pointer;" class="ap-facet-row"' : '') + '>' +
                   '<span class="text-truncate me-1" style="max-width:110px;" title="' + _esc(f.key) + '">' + _esc(f.key) + '</span>' +
                   '<span class="badge bg-secondary">' + f.count.toLocaleString() + '</span></div>';
        }).join('');
        return '<div class="mb-3"><div class="small fw-bold text-muted mb-1 text-uppercase" style="font-size:.7rem;">' + _esc(label) + '</div>' + rows + '</div>';
    }

    // ------------------------------------------------------------------ card helpers

    function _apMimeIcon(mime) {
        if (!mime) return 'fa-paperclip';
        if (mime === 'application/pdf')                      return 'fa-file-pdf';
        if (mime.startsWith('image/'))                       return 'fa-file-image';
        if (mime.startsWith('video/'))                       return 'fa-file-video';
        if (mime.startsWith('audio/'))                       return 'fa-file-audio';
        if (mime.startsWith('text/'))                        return 'fa-file-alt';
        if (mime === 'application/zip' ||
            mime === 'application/x-zip-compressed' ||
            mime === 'application/x-tar' ||
            mime === 'application/gzip')                     return 'fa-file-archive';
        if (mime.includes('spreadsheet') ||
            mime.includes('excel') ||
            mime === 'text/csv')                             return 'fa-file-excel';
        if (mime.includes('presentation') ||
            mime.includes('powerpoint'))                     return 'fa-file-powerpoint';
        if (mime.includes('word') ||
            mime.includes('document'))                       return 'fa-file-word';
        return 'fa-file';
    }

    // #731: render the current page of results in the active view. Called
    // after a fetch AND on toggle (no refetch). Sets the container class so
    // grid keeps Bootstrap's row/col layout and list uses the flex stack.
    function _apRenderResults() {
        if (!_apItems || !_apItems.length) return;
        var modalCls = AP_MODAL ? ' ap-modal-scroll' : '';
        if (_apView === 'grid') {
            resEl.className = 'row g-2' + modalCls;
            resEl.innerHTML = _apItems.map(function (a, i) { return _apCard(a, i); }).join('');
        } else {
            resEl.className = 'ap-list' + modalCls;
            resEl.innerHTML = _apItems.map(function (a, i) { return _apRow(a, i); }).join('');
        }
    }

    // #731: one list row. Pages show title + excerpt + category/keyword
    // chips (chips are display-only in v1 — non-links can't break the modal;
    // interactive in-place filtering is a tracked follow-up). Image assets
    // get a thumbnail; video/other get a type icon (poster frames pend #722).
    function _apRow(asset, idx) {
        var isPage  = asset.providerId === 'page';
        var isUser  = asset.providerId === 'user';
        var isImage = !isPage && !isUser && asset.encodingFormat && asset.encodingFormat.startsWith('image/');
        var isMedia = asset.providerId === 'media-library';

        var thumbInner;
        if (isUser && asset.thumbnailUrl)         thumbInner = '<img src="' + _esc(asset.thumbnailUrl) + '" loading="lazy" alt="">';
        else if (isMedia && asset.thumbnailUrl)   thumbInner = '<img src="' + _esc(asset.thumbnailUrl) + '" loading="lazy" alt="">';
        else if (isImage && asset.url)            thumbInner = '<img src="' + _esc(asset.url) + '" loading="lazy" alt="">';
        else {
            var ic = isPage ? 'fa-file-alt' : isUser ? 'fa-user'
                : isMedia ? 'fa-photo-video' : _apMimeIcon(asset.encodingFormat);
            thumbInner = '<i class="fas ' + ic + ' fa-lg text-muted"></i>';
        }

        // Pages: name = title, description = excerpt (Slice 1). Other assets
        // keep the historical label = description||filename||id.
        var label = isPage ? (asset.name || asset.id) : (asset.description || asset.filename || asset.id);
        var titleHtml = asset.url
            ? '<a href="' + _esc(asset.url) + '" class="text-decoration-none fw-semibold text-truncate"' +
              ((isPage || isUser) ? '' : ' target="_blank" rel="noopener noreferrer"') + '>' + _esc(label) + '</a>'
            : '<span class="fw-semibold text-truncate">' + _esc(label) + '</span>';

        var badge = isPage ? '<span class="badge bg-primary">page</span>'
            : isUser ? '<span class="badge bg-success">user</span>'
            : isMedia ? '<span class="badge bg-info text-dark">media</span>'
            : '<span class="badge bg-secondary">attachment</span>';

        var md = asset.metadata || {};
        var cat = md.systemCategory
            ? '<span class="badge bg-light text-dark border me-1">' + _esc(md.systemCategory) + '</span>' : '';
        var kws = Array.isArray(asset.keywords)
            ? asset.keywords.slice(0, 6).map(function (k) {
                return '<span class="badge bg-light text-dark border me-1">' + _esc(k) + '</span>'; }).join('')
            : '';
        var chips = (cat || kws) ? '<div class="mt-1">' + cat + kws + '</div>' : '';

        var yearStr = asset.dateCreated ? String(new Date(asset.dateCreated).getFullYear()) : '';
        var lm = (typeof md.lastModified === 'string') ? md.lastModified.slice(0, 10) : '';
        var metaBits = [yearStr, lm].filter(Boolean).map(_esc).join(' · ');
        var meta = metaBits ? '<div class="mt-1"><small class="text-muted">' + metaBits + '</small></div>' : '';

        var excerpt = (isPage && asset.description && asset.description !== label)
            ? '<div class="small text-muted text-truncate">' + _esc(asset.description) + '</div>' : '';

        var actionBtn = _apInsert
            ? '<button type="button" class="btn btn-sm btn-primary" onclick="apAction(' + idx + ')" title="' + _esc(asset.insertSnippet) + '"><i class="fas fa-code"></i> Insert</button>'
            : '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="apAction(' + idx + ')" title="Copy wiki syntax"><i class="fas fa-copy"></i> Copy</button>';

        return '<div class="ap-row border rounded shadow-sm p-2">' +
            '<div class="ap-row-thumb">' + thumbInner + '</div>' +
            '<div class="ap-row-body">' +
                '<div class="d-flex align-items-center gap-2 flex-wrap">' + titleHtml + badge + '</div>' +
                chips + excerpt + meta +
            '</div>' +
            '<div class="ap-row-act align-self-center">' + actionBtn + '</div>' +
        '</div>';
    }

    function _apCard(asset, idx) {
        var isPage   = asset.providerId === 'page';
        var isUser   = asset.providerId === 'user';
        var isImage  = !isPage && !isUser && asset.encodingFormat && asset.encodingFormat.startsWith('image/');
        var isMedia  = asset.providerId === 'media-library';
        var thumb;

        // #698: every thumb branch lays out into the same 110px-tall box so
        // cards in a result row keep consistent height regardless of whether
        // the asset has an image thumbnail, a fallback icon, or an avatar.
        // The image branches use `height:110px` (was `max-height`) plus
        // `object-fit:cover`; icon branches use a flex-centered 110px div.
        var AP_THUMB_BOX = 'd-flex align-items-center justify-content-center" style="height:110px;';
        if (isPage) {
            thumb = '<div class="text-center text-primary ' + AP_THUMB_BOX + '"><i class="fas fa-file-alt fa-2x"></i></div>';
        } else if (isUser) {
            // #694: user card — avatar if present, fa-user fallback otherwise.
            thumb = asset.thumbnailUrl
                ? '<img src="' + _esc(asset.thumbnailUrl) + '" class="img-fluid rounded-circle mb-1" style="height:110px;width:110px;object-fit:cover;" loading="lazy" alt="">'
                : '<div class="text-center text-secondary ' + AP_THUMB_BOX + '"><i class="fas fa-user fa-2x"></i></div>';
        } else if (isMedia && asset.thumbnailUrl) {
            thumb = '<img src="' + _esc(asset.thumbnailUrl) + '" class="img-fluid rounded mb-1" style="height:110px;object-fit:cover;width:100%;" loading="lazy" alt="" itemprop="thumbnailUrl">';
        } else if (isImage && asset.url) {
            thumb = '<img src="' + _esc(asset.url) + '" class="img-fluid rounded mb-1" style="height:110px;object-fit:cover;width:100%;" loading="lazy" alt="" itemprop="url">';
        } else {
            var icon = isMedia ? 'fa-photo-video' : _apMimeIcon(asset.encodingFormat);
            thumb = '<div class="text-center text-muted ' + AP_THUMB_BOX + '"><i class="fas ' + icon + ' fa-2x"></i></div>';
        }

        // #606: wrap the thumbnail in a link to asset.url so clicking opens
        // it. Pages and users navigate same-tab (they're internal content);
        // assets open in a new tab so the browse view isn't displaced.
        if (asset.url) {
            var sameTab = isPage || isUser;
            var linkAttrs = sameTab
                ? 'class="text-decoration-none d-block"'
                : 'class="text-decoration-none d-block" target="_blank" rel="noopener noreferrer"';
            var linkTitle = ' title="Open ' + _esc(asset.filename || asset.description || asset.id) + '"';
            thumb = '<a href="' + _esc(asset.url) + '" ' + linkAttrs + linkTitle + '>' + thumb + '</a>';
        }

        var badge = isPage
            ? '<span class="badge bg-primary">page</span>'
            : isUser
                ? '<span class="badge bg-success">user</span>'
                : isMedia
                    ? '<span class="badge bg-info text-dark">media</span>'
                    : '<span class="badge bg-secondary">attachment</span>';
        var yearStr = asset.dateCreated ? String(new Date(asset.dateCreated).getFullYear()) : '';
        var year  = yearStr ? '<small class="text-muted me-1" itemprop="dateCreated">' + _esc(yearStr) + '</small>' : '';
        var name  = asset.description || asset.filename || asset.id;

        var actionBtn;
        if (_apInsert) {
            actionBtn = '<button type="button" class="btn btn-sm btn-primary w-100" onclick="apAction(' + idx + ')" title="' + _esc(asset.insertSnippet) + '">' +
                '<i class="fas fa-code"></i> Insert</button>';
        } else {
            actionBtn = '<button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="apAction(' + idx + ')" title="Copy wiki syntax">' +
                '<i class="fas fa-copy"></i> Copy</button>';
        }

        // User cards include the username small under the displayName so two
        // users with the same displayName can be told apart.
        var userHandle = (isUser && asset.metadata && asset.metadata.username && asset.metadata.username !== name)
            ? '<div class="small text-muted text-truncate">@' + _esc(asset.metadata.username) + '</div>'
            : '';

        return '<div class="col-6 col-md-3 col-lg-2">' +
            '<div class="card h-100 border-0 shadow-sm" itemscope itemtype="https://schema.org/MediaObject">' +
                '<div class="card-body p-2">' +
                    thumb +
                    '<div class="small text-truncate" title="' + _esc(name) + '" itemprop="name">' + _esc(name) + '</div>' +
                    userHandle +
                    '<div class="mt-1">' + year + badge + '</div>' +
                '</div>' +
                '<div class="card-footer p-1 text-center">' + actionBtn + '</div>' +
            '</div>' +
        '</div>';
    }

    // ------------------------------------------------------------------ action (insert or copy)

    window.apAction = function (idx) {
        var asset = _apItems[idx];
        if (!asset) return;

        if (_apInsert) {
            // Insert wiki markup at cursor in the editor textarea
            var ta = document.getElementById('content');
            if (ta) {
                var s = ta.selectionStart, e = ta.selectionEnd;
                ta.value = ta.value.substring(0, s) + asset.insertSnippet + ta.value.substring(e);
                ta.focus();
                ta.setSelectionRange(s + asset.insertSnippet.length, s + asset.insertSnippet.length);
                if (typeof updatePreview === 'function') updatePreview();
            }
<% if (_apMode === 'modal') { %>
            var modalEl = document.getElementById('assetPickerModal');
            if (modalEl) { var m = bootstrap.Modal.getInstance(modalEl); if (m) m.hide(); }
<% } %>
        } else {
            // Copy wiki syntax to clipboard
            _apCopy(asset.insertSnippet);
        }
    };

    // ------------------------------------------------------------------ clipboard

    function _apCopy(text) {
        function showCopyToast() {
            var toastEl = document.getElementById('ap-copy-toast');
            if (toastEl) { new bootstrap.Toast(toastEl, { delay: 1500 }).show(); }
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(showCopyToast).catch(function () { _apCopyFallback(text, showCopyToast); });
        } else {
            _apCopyFallback(text, showCopyToast);
        }
    }

    function _apCopyFallback(text, onSuccess) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0;';
        document.body.appendChild(ta);
        ta.focus(); ta.select();
        try { if (document.execCommand('copy') && onSuccess) onSuccess(); } catch (e) { /* silent */ }
        document.body.removeChild(ta);
    }

    // ------------------------------------------------------------------ keyboard + swipe

<% if (_apMode === 'page') { %>
    WikiPagination.attachKeyboard(
        function () { if (_apPage > 0) _apSearch(_apPage - 1); },
        function () { if (_apPage + 1 < Math.ceil(_apTotal / AP_PAGE_SIZE)) _apSearch(_apPage + 1); }
    );
    WikiPagination.attachSwipe(document.body,
        function () { if (_apPage > 0) _apSearch(_apPage - 1); },
        function () { if (_apPage + 1 < Math.ceil(_apTotal / AP_PAGE_SIZE)) _apSearch(_apPage + 1); }
    );
<% } else { %>
    WikiPagination.attachKeyboard(
        function () { if (window._apModalOpen && _apPage > 0) _apSearch(_apPage - 1); },
        function () { var tp = Math.ceil(_apTotal / AP_PAGE_SIZE); if (window._apModalOpen && _apPage + 1 < tp) _apSearch(_apPage + 1); }
    );
    WikiPagination.attachSwipe(
        document.getElementById('assetPickerModal') || document.body,
        function () { if (window._apModalOpen && _apPage > 0) _apSearch(_apPage - 1); },
        function () { var tp = Math.ceil(_apTotal / AP_PAGE_SIZE); if (window._apModalOpen && _apPage + 1 < tp) _apSearch(_apPage + 1); }
    );
<% } %>

    // ------------------------------------------------------------------ utils

    function _esc(str) {
        return String(str == null ? '' : str)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // Pre-populate from caller (e.g. /search passing its URL params as init state)
    <% if (_apInitQuery) { %>
    qEl.value = <%- JSON.stringify(_apInitQuery) %>;
    <% } %>
    <% if (_apInitSource) { %>
    srcEl.value = <%- JSON.stringify(_apInitSource) %>;
    _apUpdateControls();
    <% } %>
    <% if (_apInitMime) { %>
    if (mimeEl) mimeEl.value = <%- JSON.stringify(_apInitMime) %>;
    <% } %>
    // #696: hidden filters — no UI control today (#691). Read once on init
    // and re-attached to every search URL in _apSearch.
    var _apHiddenFilters = <%- JSON.stringify(_apInitFilters) %>;

    // #739: reflect a bookmarked full-text page search in the checkbox so the
    // UI matches the URL (e.g. /search?types=page&searchIn=content).
    if (srcEl.value === 'page' && fulltextEl && Array.isArray(_apHiddenFilters.searchIn) &&
        _apHiddenFilters.searchIn.some(function (s) { return s === 'all' || s === 'content'; })) {
        fulltextEl.checked = true;
    }

    // #731: reflect the persisted view on the toggle buttons before first
    // fetch (render is a no-op until results arrive; _apSearch then renders
    // through _apRenderResults honouring _apView).
    _apSetView(_apView);
    _apSyncSortBtn();

    // Auto-load on init
    _apSearch(0);
})();
</script>

<!-- Toast for copy confirmation -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:1100;">
    <div id="ap-copy-toast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body"><i class="fas fa-check me-1"></i> Copied to clipboard</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>
