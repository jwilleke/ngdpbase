<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-body">
<%# #1388: a link to an encrypted vault. The server sends only this viewer and
    locked copies; the key is the part of the address after #, which the
    browser never sends, and this page opens the copies with it. %>
<div class="container mt-4 mb-5" id="shareViewer" data-token="<%= token %>">
    <h1 class="h3 mb-1"><i class="fas fa-lock"></i> <span id="sharedBy">Shared with you</span></h1>
    <p class="text-muted small">Opened in your browser: the key in the link never left it.</p>
    <div id="viewerStatus" class="alert alert-info">Opening…</div>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="list-group" id="pageList"></div>
        </div>
        <div class="col-md-8">
            <div id="pageTools" class="d-none mb-2 d-flex gap-2 align-items-center">
                <h2 class="h5 mb-0 me-auto" id="pageTitle"></h2>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="printPage"><i class="fas fa-print"></i> Print</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="downloadPage"><i class="fas fa-download"></i> Download</button>
            </div>
            <%# No scripts run inside the frame: sandbox without allow-scripts. %>
            <iframe id="pageFrame" class="w-100 border rounded d-none" style="min-height: 70vh;" sandbox="allow-same-origin allow-modals" title="Shared page"></iframe>
        </div>
    </div>
</div>
<script src="/js/share-viewer.js"></script>
</body>
</html>
