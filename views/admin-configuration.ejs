<%- include('header', { pageName: '' }) %>

<div class="container mt-4">
    <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <%# #1145 / #1159 / #1162 — the security posture: the settings that decide
        what this instance guarantees, gathered as one subject instead of
        scattered through five hundred keys. Moved here from the dashboard by
        #1162, where an operator deciding what to change is already looking.

        Rendered only when securityPosture is present. It is resolved server-
        side ONLY for admin-system (D18), separately from this page's own gate,
        which admits admin-read — the section is a map of the instance's
        defences, and demo-admin exists so a public demo can expose every admin
        screen to visitors. %>
    <% if (typeof securityPosture !== 'undefined' && securityPosture && securityPosture.length > 0) { %>
        <details class="card mb-4" id="security-posture">
            <summary class="card-header" style="cursor: pointer;">
                <i class="fas fa-shield-halved me-2" aria-hidden="true"></i>
                <strong>Security Posture</strong>
                <span class="text-muted small ms-2">
                    what this instance is set to &mdash;
                    <%= securityPosture.reduce(function (n, g) { return n + g.items.length; }, 0) %> settings
                </span>
            </summary>
            <div class="card-body">
                <p class="small text-muted">
                    These are ordinary configuration keys, gathered here because together they decide what this
                    instance guarantees. Changing one here is the same as changing it anywhere else, and every
                    change is recorded in the audit log.
                </p>

                <% securityPosture.forEach(function (group) { %>
                    <h6 class="mt-3"><%= group.group %></h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Setting</th>
                                    <th scope="col">Value</th>
                                    <th scope="col">Takes effect</th>
                                    <th scope="col" class="text-end">In view</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% group.items.forEach(function (item) { %>
                                    <tr>
                                        <td><code class="small"><%= item.key %></code></td>
                                        <td class="small">
                                            <% if (item.secret) { %>
                                                <span class="text-muted"><em>set, not shown</em></span>
                                            <% } else { %>
                                                <code><%= JSON.stringify(item.value) %></code>
                                            <% } %>
                                        </td>
                                        <td class="small">
                                            <% if (item.restart) { %>
                                                <span class="text-muted">after a restart</span>
                                            <% } else { %>
                                                <span class="text-muted">immediately</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <%# Removing changes NO value — the key keeps what it is set
                                                to and the code keeps reading it. Said on the button so an
                                                operator does not read "remove" as "turn off". %>
                                            <form method="POST" action="/admin/configuration/posture" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="action" value="remove">
                                                <input type="hidden" name="key" value="<%= item.key %>">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary"<%- lockedUnless('admin-system') %>
                                                        title="Stop showing this setting here. Its value does not change.">
                                                    Stop watching
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% }); %>

                <hr>
                <form method="POST" action="/admin/configuration/posture" class="row g-2 align-items-end">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="action" value="add">
                    <div class="col-md-6">
                        <label class="form-label small mb-0" for="posture-key">Watch another setting</label>
                        <input type="text" class="form-control form-control-sm" id="posture-key" name="key"
                               placeholder="ngdpbase.some.setting" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="posture-group">Group</label>
                        <input type="text" class="form-control form-control-sm" id="posture-group" name="group"
                               placeholder="Other">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-primary w-100"<%- lockedUnless('admin-system') %>>Add</button>
                    </div>
                    <div class="col-12">
                        <p class="form-text small mb-0">
                            Adding a setting here only decides what is shown. It does not change any value,
                            and it does not turn anything on.
                        </p>
                    </div>
                </form>
            </div>
        </details>
    <% } %>

    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="fas fa-cogs"></i> Configuration Management</h1>
                    <p class="lead">Manage ngdpbase configuration properties</p>
                </div>
                <a href="/admin" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <!-- #1162: collapsible, matching Security Posture above, so every top-level
         entry on this page opens and closes the same way. Open by default —
         "collapsible" is not "collapsed", and this is the page's main content. -->
    <details class="card mb-4" id="configuration-management" open>
        <summary class="card-header" style="cursor: pointer;">
            <i class="fas fa-sliders me-2" aria-hidden="true"></i>
            <strong>Configuration Management</strong>
            <span class="text-muted small ms-2">
                current values, custom overrides, shipped defaults, and adding a property
            </span>
        </summary>
        <div class="card-body">
    <div class="row mt-4">
        <div class="col-12">
            <nav>
                <div class="nav nav-tabs" id="nav-tab" role="tablist">
                    <button class="nav-link active" id="nav-current-tab" data-bs-toggle="tab" data-bs-target="#nav-current" type="button" role="tab">
                        <i class="fas fa-eye"></i> Current Configuration
                    </button>
                    <button class="nav-link" id="nav-custom-tab" data-bs-toggle="tab" data-bs-target="#nav-custom" type="button" role="tab">
                        <i class="fas fa-edit"></i> Custom Overrides
                    </button>
                    <button class="nav-link" id="nav-defaults-tab" data-bs-toggle="tab" data-bs-target="#nav-defaults" type="button" role="tab">
                        <i class="fas fa-list"></i> Default Values
                    </button>
                    <button class="nav-link" id="nav-add-tab" data-bs-toggle="tab" data-bs-target="#nav-add" type="button" role="tab">
                        <i class="fas fa-plus"></i> Add Property
                    </button>
                </div>
            </nav>

            <div class="tab-content" id="nav-tabContent">
                <!-- Current Configuration Tab -->
                <div class="tab-pane fade show active" id="nav-current" role="tabpanel">
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5><i class="fas fa-cogs"></i> Current Active Configuration</h5>
                            <small class="text-muted">Shows merged configuration (defaults + custom overrides)</small>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th style="width: 40%;">Property</th>
                                            <th style="width: 45%;">Value</th>
                                            <th style="width: 15%;">Source</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% Object.entries(mergedProperties).sort().forEach(([key, value]) => { %>
                                            <tr>
                                                <td>
                                                    <code><%= key %></code>
                                                </td>
                                                <td>
                                                    <%# Secrets are stripped server-side, so there is no value here to hide —
                                                        view-source shows nothing. Reveal fetches the single key on demand and
                                                        the button only renders for admins who may call that endpoint. %>
                                                    <% if (secretKeys.includes(key)) { %>
                                                        <%# "Is it configured?" is answerable without revealing anything —
                                                            otherwise checking whether SMTP is set up means unmasking a
                                                            live credential. %>
                                                        <% if (!secretIsSet[key]) { %>
                                                            <code class="text-muted">(not set)</code>
                                                        <% } else { %>
                                                        <code class="secret-value" data-key="<%= key %>">••••••••</code>
                                                        <% if (canRevealSecrets) { %>
                                                            <button type="button"
                                                                    class="btn btn-link btn-sm p-0 ms-2 reveal-secret"
                                                                    data-key="<%= key %>"
                                                                    title="Reveal this value">
                                                                <i class="fas fa-eye"></i>
                                                            </button>
                                                        <% } else { %>
                                                            <span class="badge bg-secondary ms-2">hidden</span>
                                                        <% } %>
                                                        <% } %>
                                                    <% } else { %>
                                                        <%# #1089: for an environment-owned key the merged config value is
                                                            NOT what is in force — getProperty consults the environment
                                                            first. Showing the raw JSON here made the read side wrong
                                                            before anyone edited anything. %>
                                                        <% const envInfo = (typeof envControlled !== 'undefined' && envControlled) ? envControlled[key] : null; %>
                                                        <% const shown = envInfo ? envInfo.effective : value; %>
                                                        <% if (typeof shown === 'object' && shown !== null) { %>
                                                            <code><%= JSON.stringify(shown) %></code>
                                                        <% } else { %>
                                                            <code><%= shown %></code>
                                                        <% } %>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% const envSrc = (typeof envControlled !== 'undefined' && envControlled) ? envControlled[key] : null; %>
                                                    <% if (envSrc) { %>
                                                        <%# #1089: env-owned. Read-only wherever it appears; the variable
                                                            is named so an operator knows where to change it. %>
                                                        <span class="badge bg-dark" title="Set <%= envSrc.envVar %> in .env and restart">
                                                            <i class="fas fa-lock"></i> Environment
                                                        </span>
                                                        <div class="small text-muted mt-1"><code><%= envSrc.envVar %></code></div>
                                                    <% } else if (customProperties[key] !== undefined) { %>
                                                        <span class="badge bg-warning text-dark">Custom</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary">Default</span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Custom Overrides Tab -->
                <div class="tab-pane fade" id="nav-custom" role="tabpanel">
                    <div class="card mt-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div>
                                <h5><i class="fas fa-edit"></i> Custom Configuration Overrides</h5>
                                <small class="text-muted">Properties in app-custom-config.json</small>
                            </div>
                            <form method="POST" action="/admin/configuration/reset" style="display: inline;" onsubmit="return confirm('Are you sure you want to reset all custom configurations to defaults?');">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger"<%- lockedUnless('admin-system') %>>
                                    <i class="fas fa-undo"></i> Reset All to Defaults
                                </button>
                            </form>
                        </div>
                        <div class="card-body">
                            <% if (Object.keys(customProperties).length === 0) { %>
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle"></i> No custom configuration overrides are currently set.
                                    All values are using defaults from app-default-config.json.
                                </div>
                            <% } else { %>
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th style="width: 40%;">Property</th>
                                                <th style="width: 45%;">Custom Value</th>
                                                <th style="width: 15%;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <%# #1089: a key the environment owns is ALWAYS read-only —
                                                not "read-only while the variable happens to be set". The
                                                shipped value is a boot fallback, not a setting, so an
                                                editable field here would be a write that cannot take
                                                effect. Nothing in ngdpbase writes .env, by design. %>
                                            <% Object.entries(customProperties).sort().forEach(([key, value]) => { %>
                                                <% const envInfo = (typeof envControlled !== 'undefined' && envControlled) ? envControlled[key] : null; %>
                                                <tr>
                                                    <td>
                                                        <code><%= key %></code>
                                                        <% if (envInfo) { %>
                                                            <span class="badge bg-secondary ms-1" title="Owned by the environment">
                                                                <i class="fas fa-lock"></i> env
                                                            </span>
                                                        <% } %>
                                                    </td>
                                                    <% if (envInfo) { %>
                                                        <td>
                                                            <input type="text" class="form-control form-control-sm" readonly disabled
                                                                   value="<%= envInfo.effective === null ? '(hidden)' : (typeof envInfo.effective === 'object' ? JSON.stringify(envInfo.effective) : envInfo.effective) %>">
                                                            <div class="form-text small">
                                                                Controlled by <code><%= envInfo.envVar %></code>
                                                                <% if (envInfo.source === 'env') { %>
                                                                    &mdash; currently supplied by that variable.
                                                                <% } else { %>
                                                                    &mdash; not currently set, so the value above is the configured fallback.
                                                                <% } %>
                                                                <br>
                                                                <% if (key === 'ngdpbase.application.base-url') { %>
                                                                    To change it, set <code><%= envInfo.envVar %></code> in <code>.env</code>
                                                                    (root or <code>&lt;FAST_STORAGE&gt;/.env</code>), or set this key in
                                                                    <code>app-custom-config.json</code>, then restart.
                                                                <% } else { %>
                                                                    To change it, set <code><%= envInfo.envVar %></code> in <code>.env</code>
                                                                    (root or <code>&lt;FAST_STORAGE&gt;/.env</code>) and restart.
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <button type="button" class="btn btn-sm btn-secondary" disabled title="Set this in .env and restart">
                                                                <i class="fas fa-lock"></i>
                                                            </button>
                                                        </td>
                                                    <% } else { %>
                                                    <td>
                                                        <form method="POST" action="/admin/configuration" class="d-inline">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <input type="hidden" name="property" value="<%= key %>">
                                                            <input type="text" name="value" value="<%= typeof value === 'object' ? JSON.stringify(value) : value %>" class="form-control form-control-sm">
                                                        </td>
                                                        <td>
                                                            <button type="submit" class="btn btn-sm btn-primary"<%- lockedUnless('admin-system') %>>
                                                                <i class="fas fa-save"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                    <% } %>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Default Values Tab -->
                <div class="tab-pane fade" id="nav-defaults" role="tabpanel">
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5><i class="fas fa-list"></i> Default Configuration Values</h5>
                            <small class="text-muted">Values from app-default-config.json (read-only)</small>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th style="width: 40%;">Property</th>
                                            <th style="width: 60%;">Default Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% Object.entries(defaultProperties).sort().forEach(([key, value]) => { %>
                                            <tr>
                                                <td>
                                                    <code><%= key %></code>
                                                </td>
                                                <td>
                                                    <% if (typeof value === 'object') { %>
                                                        <code class="text-muted"><%= JSON.stringify(value) %></code>
                                                    <% } else { %>
                                                        <code class="text-muted"><%= value %></code>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add Property Tab -->
                <div class="tab-pane fade" id="nav-add" role="tabpanel">
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5><i class="fas fa-plus"></i> Add New Configuration Property</h5>
                            <small class="text-muted">Add custom ngdpbase configuration</small>
                        </div>
                        <div class="card-body">
                            <form method="POST" action="/admin/configuration">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                <div class="mb-3">
                                    <label for="newProperty" class="form-label">Property Name</label>
                                    <input type="text" class="form-control" id="newProperty" name="property" placeholder="ngdpbase.property.name" required>
                                    <div class="form-text">Property name must start with 'ngdpbase.' or 'log4j.'</div>
                                </div>

                                <div class="mb-3">
                                    <label for="newValue" class="form-label">Property Value</label>
                                    <input type="text" class="form-control" id="newValue" name="value" placeholder="property value" required>
                                </div>

                                <button type="submit" class="btn btn-primary"<%- lockedUnless('admin-system') %>>
                                    <i class="fas fa-plus"></i> Add Property
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
        </div>
    </details>

    <!-- Back to Admin -->
    <div class="row mt-4">
        <div class="col-12">
            <a href="/admin" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Admin Dashboard
            </a>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Handle all configuration save forms via AJAX
    document.querySelectorAll('form[action="/admin/configuration"]').forEach(function(form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            var formData = new FormData(form);
            var btn = form.querySelector('button[type="submit"]');
            var originalHtml = btn ? btn.innerHTML : '';

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            }

            csrfFetch('/admin/configuration', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams(formData).toString()
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data.success) {
                    showConfigAlert('success', data.message || 'Configuration updated successfully');
                } else {
                    showConfigAlert('danger', data.error || 'Failed to update configuration');
                }
            })
            .catch(function() {
                showConfigAlert('danger', 'Failed to update configuration');
            })
            .finally(function() {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            });
        });
    });

    function showConfigAlert(type, message) {
        // Remove any existing config alerts
        document.querySelectorAll('.config-alert').forEach(function(el) { el.remove(); });

        var icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle';
        var alertDiv = document.createElement('div');
        alertDiv.className = 'alert alert-' + type + ' alert-dismissible fade show config-alert';
        alertDiv.setAttribute('role', 'alert');
        alertDiv.innerHTML = '<i class="fas ' + icon + '"></i> ' + message +
            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';

        var container = document.querySelector('.container.mt-4');
        container.insertBefore(alertDiv, container.firstChild);

        // Auto-dismiss after 3 seconds
        setTimeout(function() {
            if (alertDiv.parentNode) {
                alertDiv.classList.remove('show');
                setTimeout(function() { alertDiv.remove(); }, 150);
            }
        }, 3000);
    }

    // Reveal a masked config value. The value is NOT on the page — this fetches
    // the one key, so nothing is exposed until an admin asks for it, and the
    // server re-checks the permission on every call.
    document.querySelectorAll('.reveal-secret').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var key = btn.getAttribute('data-key');
            var cell = document.querySelector('.secret-value[data-key="' + CSS.escape(key) + '"]');
            if (!cell) return;

            // Second click re-masks, so a revealed value does not linger on a
            // screen someone walks away from.
            if (cell.dataset.revealed === '1') {
                cell.textContent = '••••••••';
                cell.dataset.revealed = '0';
                btn.innerHTML = '<i class="fas fa-eye"></i>';
                return;
            }

            fetch('/api/admin/config/secret/' + encodeURIComponent(key))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (!data.success) {
                        showAlert(data.error || 'Could not reveal value', 'danger');
                        return;
                    }
                    cell.textContent = data.value === '' ? '(empty)' : data.value;
                    cell.dataset.revealed = '1';
                    btn.innerHTML = '<i class="fas fa-eye-slash"></i>';
                })
                .catch(function() { showAlert('Could not reveal value', 'danger'); });
        });
    });
});
</script>

<%- include('footer') %>