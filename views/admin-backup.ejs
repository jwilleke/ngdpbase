<%- include('header', { pageName: 'Backup Management' }) %>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-database"></i> Backup Management</h1>
        <a href="/admin" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- ================================================================ -->
    <!-- Manual Backup                                                     -->
    <!-- ================================================================ -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-download"></i> Manual Backup</h5>
        </div>
        <div class="card-body">
            <p>Creates a backup and downloads it to your browser immediately, as one <code>.tar</code> file: the backup document (<code>.json.gz</code>) and, when the site keeps databases, an encrypted copy of each.</p>

            <h6 class="mt-3">What is included</h6>
            <ul>
                <li>Configuration settings</li>
                <li>User accounts and roles</li>
                <li>Access control lists (ACLs)</li>
                <li>Attachment metadata (filenames, page links, hashes)</li>
                <li>Search index</li>
                <li>Page files and their version history</li>
            </ul>

            <h6 class="mt-3">What is <strong>not</strong> included</h6>
            <ul class="text-warning-emphasis">
                <li><strong>Page version history of private stores</strong> — back up <code>$SLOW_STORAGE/pages/vaults/</code> separately</li>
                <li><strong>Attachment binary files</strong> — back up <code>$SLOW_STORAGE/attachments/</code> separately</li>
                <li><strong>Media files</strong> — back up your media source folders independently</li>
            </ul>

            <div class="alert alert-warning mt-3 mb-3" role="alert">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>This is not a complete backup.</strong>
                See the <a href="/view/Backup" class="alert-link">Backup wiki page</a> for the full recommended backup process.
            </div>

            <div class="d-flex flex-wrap align-items-center gap-3">
                <form method="POST" action="/admin/backup/create">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-primary"<%- lockedUnless('config-manage') %>>
                        <i class="fas fa-database"></i> Create &amp; Download Backup
                    </button>
                </form>
                <% if (databasesEnabled) { %>
                <p class="small text-muted mb-0" id="backup-key-note">
                    <i class="fas fa-key"></i> The databases in the download are encrypted with the backup key (<code>NGDPBASE_BACKUP_KEY</code>), which is <strong>not</strong> in the file. Keep a copy of the key somewhere other than this server: without it the databases cannot be restored.
                </p>
                <% } %>
            </div>

            <% if (recentBackups && recentBackups.length > 0) { %>
            <h6 class="mt-4">Backups stored on the server</h6>
            <table class="table table-sm table-striped mt-2" id="stored-backups">
                <thead><tr><th>Backup</th><th>Created</th><th>Size</th><th>Databases</th><th></th></tr></thead>
                <tbody>
                <% recentBackups.forEach(function(b) { %>
                    <tr data-backup="<%= b.filename %>">
                        <td><code style="font-size:0.8em;"><%= b.filename %></code></td>
                        <td><%= new Date(b.created).toLocaleString() %></td>
                        <td><%= Math.max(1, Math.round(b.totalSize / 1024)) %> KB</td>
                        <td><%= b.databases.length > 0 ? b.databases.join(', ') : '—' %></td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="/admin/backup/download/<%= encodeURIComponent(b.filename) %>"><i class="fas fa-download"></i> Download</a>
                        </td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
            <% } %>
        </div>
    </div>

    <!-- ================================================================ -->
    <!-- Restore databases                                                -->
    <!-- ================================================================ -->
    <% if (databasesEnabled || locals.databaseUnavailable) { %>
    <div class="card mb-4" id="restore-card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-undo"></i> Restore Databases</h5>
        </div>
        <div class="card-body">
            <p class="fw-bold" id="restore-scope">Restores the databases only. Pages, users and settings are not changed.</p>
            <p>Puts the site's databases back as they were in a backup stored on this server.</p>
            <ul>
                <li>A fresh backup of the current data is taken first.</li>
                <li>The backup's databases are then prepared beside the current ones. Nothing changes until the site is <strong>restarted</strong>, which you do yourself: the site never restarts on its own.</li>
                <li>At the restart the prepared databases take the place of the current ones, which are kept beside them.</li>
            </ul>

            <% if (locals.databaseUnavailable) { %>
            <div class="alert alert-danger" id="restore-database-unavailable">
                <h6 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> The application database can't be opened</h6>
                <p class="mb-2">A restore still works, with one difference: <strong>the fresh backup taken first leaves the databases out</strong>, because they can't be read. The current database files are not lost: at the restart they are kept beside the restored ones as <code>*.pre-restore</code>.</p>
                <p class="mb-0 small">The restore needs <code>NGDPBASE_DATABASE_KEY</code> to be set. If the problem is a missing or wrong key, set or correct the key and restart instead: no restore is needed.</p>
            </div>
            <% } %>

            <% if (restoreRunning) { %>
            <div class="alert alert-info" id="restore-running"><i class="fas fa-spinner"></i> A restore is being prepared. You will get a notification when it is ready, or if it fails.</div>
            <% } %>

            <% if (stagedRestore) { %>
            <div class="alert alert-warning" id="staged-restore">
                <h6 class="alert-heading"><i class="fas fa-hourglass-half"></i> A restore is staged and waits for the restart</h6>
                <table class="table table-sm mb-2" style="max-width:640px;">
                    <tr><th>Backup</th><td><code><%= stagedRestore.source || stagedRestore.backup %></code></td></tr>
                    <tr><th>Backup taken</th><td><%= stagedRestore.backup ? new Date(stagedRestore.backup).toLocaleString() : '—' %></td></tr>
                    <tr><th>Staged</th><td><%= new Date(stagedRestore.stagedAt).toLocaleString() %></td></tr>
                    <tr><th>Staged by</th><td><%= stagedRestore.stagedBy || '—' %></td></tr>
                    <% if (stagedRestore.safetyBackup) { const safety = (recentBackups || []).find(function(b) { return b.filename === stagedRestore.safetyBackup; }); %>
                    <tr id="safety-backup"><th>Safety backup</th><td>Your data as it was before this restore was saved as <code><%= stagedRestore.safetyBackup %></code><%= safety ? ' (' + new Date(safety.created).toLocaleString() + ')' : '' %>. It is in the list above<% if (safety && safety.databases.length === 0) { %>. <span id="safety-backup-no-databases">It holds no databases: they could not be opened when it was taken, so the current database files are kept as <code>*.pre-restore</code> at the restart instead. To undo this restore, put those files back with the server stopped.</span><% } else { %>; restore it to undo this restore.<% } %></td></tr>
                    <% } %>
                    <tr><th>Databases</th><td><%= stagedRestore.databases.map(function(d) { return d.name; }).join(', ') %></td></tr>
                </table>
                <p class="mb-2">Restart the site to apply it, or cancel it. To restore a different backup instead, use <strong>Replace it</strong> below.</p>
                <form method="POST" action="/admin/backup/restore/cancel" id="cancel-staged-restore">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger"<%- lockedUnless('config-manage') %>>
                        <i class="fas fa-times"></i> Cancel staged restore
                    </button>
                </form>
            </div>
            <% } %>

            <% const restorable = (recentBackups || []).filter(function(b) { return b.databases.length > 0; }); %>
            <% if (restorable.length === 0) { %>
            <p class="text-muted mb-0"><em>No backup on this server holds databases yet.</em></p>
            <% } else { %>
            <form method="POST" action="/admin/backup/restore" id="restore-form" class="border rounded p-3" style="max-width:640px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (stagedRestore) { %><input type="hidden" name="replace" value="true"><% } %>
                <div class="mb-3">
                    <label for="restoreBackup" class="form-label">Backup to restore</label>
                    <select class="form-select" id="restoreBackup" name="backup">
                        <% restorable.forEach(function(b) { %>
                        <option value="<%= b.filename %>"><%= new Date(b.created).toLocaleString() %> — <%= b.databases.join(', ') %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="restoreConfirm" class="form-label">Type the site name, <strong><%= siteName %></strong>, to confirm</label>
                    <input type="text" class="form-control" id="restoreConfirm" name="confirm" autocomplete="off" required data-expected="<%= siteName %>">
                </div>
                <button type="submit" class="btn btn-danger" id="restore-submit"<%- lockedUnless('config-manage') || ' disabled' %>>
                    <i class="fas fa-undo"></i> <%= stagedRestore ? 'Replace it' : 'Restore' %>
                </button>
            </form>
            <% } %>
        </div>
    </div>
    <% } %>

    <!-- ================================================================ -->
    <!-- Auto Backup                                                       -->
    <!-- ================================================================ -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-clock"></i> Auto Backup</h5>
            <span class="badge <%= status.config.enabled ? 'bg-success' : 'bg-secondary' %>">
                <%= status.config.enabled ? 'Enabled' : 'Disabled' %>
            </span>
        </div>
        <div class="card-body">
            <table class="table table-sm mb-3" style="max-width:400px;">
                <tr><th>Status</th><td><%= status.config.enabled ? 'Enabled' : 'Disabled' %></td></tr>
                <tr><th>Time</th><td><%= status.config.time %></td></tr>
                <tr><th>Days</th><td><%= status.config.days %></td></tr>
                <tr><th>Max backups kept</th><td><%= status.config.maxBackups %></td></tr>
                <tr><th>Backup directory</th><td><code style="font-size:0.8em;"><%= status.config.directory %></code></td></tr>
                <tr>
                    <th>Last backup</th>
                    <td>
                        <% if (status.lastBackup) { %>
                            <%= new Date(status.lastBackup).toLocaleString() %>
                        <% } else { %>
                            <em class="text-muted">None recorded</em>
                        <% } %>
                    </td>
                </tr>
            </table>

            <!-- Configure Auto Backup (collapsible) -->
            <button class="btn btn-sm btn-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#autoBackupConfig" aria-expanded="false">
                <i class="fas fa-cog"></i> Configure Auto Backup
            </button>

            <div class="collapse mt-3" id="autoBackupConfig">
                <div class="card card-body border-secondary">
                    <form method="POST" action="/admin/backup/config">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="autoBackupEnabled"
                                       name="autoBackup" value="true"
                                       <%= status.config.enabled ? 'checked' : '' %>>
                                <label class="form-check-label" for="autoBackupEnabled">Enable Auto Backup</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="autoBackupTime" class="form-label">Time of day (24-hour HH:MM)</label>
                            <input type="time" class="form-control" id="autoBackupTime"
                                   name="autoBackupTime" value="<%= status.config.time %>" style="max-width:140px;">
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-block">Days</label>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <% const dayOpts = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']; %>
                                <% const selectedDays = status.config.days; %>
                                <% dayOpts.forEach(function(d) { %>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input day-checkbox" type="checkbox"
                                               id="day_<%= d %>" value="<%= d %>"
                                               <%= (selectedDays !== 'daily' && selectedDays !== 'monthly' && selectedDays.toLowerCase().includes(d.toLowerCase())) ? 'checked' : '' %>>
                                        <label class="form-check-label" for="day_<%= d %>"><%= d %></label>
                                    </div>
                                <% }); %>
                            </div>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="autoBackupDays"
                                           id="days_daily" value="daily"
                                           <%= selectedDays === 'daily' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="days_daily">Daily</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="autoBackupDays"
                                           id="days_monthly" value="monthly"
                                           <%= selectedDays === 'monthly' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="days_monthly">Monthly (1st of month)</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="autoBackupDays"
                                           id="days_custom" value=""
                                           <%= (selectedDays !== 'daily' && selectedDays !== 'monthly') ? 'checked' : '' %>>
                                    <label class="form-check-label" for="days_custom">Custom (use checkboxes above)</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="maxBackups" class="form-label">Max backups to keep</label>
                            <input type="number" class="form-control" id="maxBackups"
                                   name="maxBackups" value="<%= status.config.maxBackups %>"
                                   min="1" max="100" style="max-width:100px;">
                        </div>

                        <div class="mb-3">
                            <label for="directory" class="form-label">Backup directory</label>
                            <input type="text" class="form-control" id="directory"
                                   name="directory" value="<%= status.config.directory %>">
                            <div class="form-text">Absolute path. Leave unchanged to keep current location.</div>
                        </div>

                        <button type="submit" class="btn btn-primary"<%- lockedUnless('config-manage') %>>
                            <i class="fas fa-save"></i> Save Configuration
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

<script nonce="<%= locals.cspNonce %>">
// #1723: the restore button waits for the site name; the server checks it again.
(function () {
    const input = document.getElementById('restoreConfirm');
    const button = document.getElementById('restore-submit');
    if (!input || !button || button.getAttribute('aria-disabled') === 'true') return;
    const update = function () { button.disabled = input.value.trim() !== input.dataset.expected; };
    input.addEventListener('input', update);
    update();
})();
// When "Custom" radio is selected, build the autoBackupDays value from checked day checkboxes on submit
document.querySelector('form[action="/admin/backup/config"]').addEventListener('submit', function(e) {
    const customRadio = document.getElementById('days_custom');
    if (customRadio && customRadio.checked) {
        const checked = Array.from(document.querySelectorAll('.day-checkbox:checked')).map(cb => cb.value);
        customRadio.value = checked.join(',') || 'daily';
    }
});
</script>

<%- include('footer') %>
