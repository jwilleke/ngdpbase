<%- include('header', { pageName: '' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Roles and Permissions</h1>
    <a href="/admin" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
</div>

<%# #1216: read-only. Its Save, Delete and create buttons called UserManager methods that
    only threw; roles are edited in Configuration, where the change is audited and read live.

    This page used to say it defined each role's permissions, and that page-level

    ACLs restrict but cannot grant. Neither was true: permissions come from the access

    policies, and page-body ACL markup (removed in #1431) could only ever grant. %>

<div class="alert alert-info">

    <p class="mb-2">

        <strong>Roles</strong> name a group of people. What a role may <em>do</em> is decided by the

        <strong>access policies</strong> (<code>ngdpbase.access.policies</code>), which you edit in

        <a href="/admin/configuration">Configuration</a>. The roles themselves are edited there too, as
        <code>ngdpbase.roles.definitions</code>. Changes there are recorded in the audit log and take
        effect at once.

    </p>

    <p class="mb-0">

        This page is read-only. The <strong>Security Policy Summary</strong> below shows the result
        for each role, and always matches the policies. A single page can be narrowed further

        with its own <code>audience</code> or <code>access</code> settings.

    </p>

</div>

<!-- Role Management -->
<div class="row">
    <% roles.forEach(role => { %>
    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <span class="badge <%= role.issystem ? 'bg-primary' : 'bg-secondary' %> me-2">
                        <%= role.issystem ? 'System' : 'Custom' %>
                    </span>
                    <%= role.displayname %>
                </h5>
                <small class="text-muted"><%= role.name %></small>
            </div>
            <div class="card-body">
                <p class="mb-0"><%= role.description || '' %></p>
            </div>
        <div class="card-footer">
            <small class="text-muted">
                <% if (role.issystem) { %>
                    System Role
                <% } else { %>
                    Custom Role
                <% } %>
                <% if (role.lastmodified) { %>
                | Last modified: <%= new Date(role.lastmodified).toLocaleDateString() %>
                <% } %>
            </small>
        </div>
    </div>
</div>
<% }); %>
</div>

<!-- Security Policy Summary -->
<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Security Policy Summary</h5>
    </div>
    <div class="card-body">
        <% if (permissions && permissions.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm">
                <thead>
                    <tr>
                        <th style="width: 300px;">Permission</th>
                        <% roles.forEach(role => { %>
                        <th class="text-center"><%= role.displayname %></th>
                        <% }); %>
                    </tr>
                </thead>
                <tbody>
                    <% permissions.forEach(perm => { %>
                    <tr>
                        <td>
                            <code class="text-primary"><%= perm.key %></code>
                            <br><small class="text-muted" title="<%= perm.description %>"><%= perm.label || perm.description %></small>
                        </td>
                        <% roles.forEach(role => { %>
                        <td class="text-center">
                            <% if (role.permissions && role.permissions.includes(perm.key) && role.limited && role.limited[perm.key]) { %>
                            <%# #1539: granted only somewhere — vault-owner's grants apply in the holder's own vaults. %>
                            <i class="fas fa-adjust text-info" title="Only <%= role.limited[perm.key].includes('vault') ? 'in the holder\'s own vaults' : 'on some pages' %>"></i>
                            <% } else if (role.permissions && role.permissions.includes(perm.key)) { %>
                            <i class="fas fa-check text-success"></i>
                            <% } else { %>
                            <i class="fas fa-times text-muted"></i>
                            <% } %>
                        </td>
                        <% }); %>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            No permissions defined in the system. Permissions are configured through Access Policies.
        </div>
        <% } %>
    </div>
</div>

<%# #2067: scheduled jobs. A job an access policy names acts as itself (#1999) and may do only
    what those policies give it; a job no policy names runs with the system roles. %>
<div class="card mt-4" id="jobs">
    <div class="card-header">
        <h5 class="mb-0">Jobs</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">
            A scheduled job that an access policy names may do only what those policies give it.
            A job no policy names runs with the system roles.
        </p>
        <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-bordered table-sm" data-testid="roles-jobs">
                <thead>
                    <tr>
                        <th style="width: 300px;">Job</th>
                        <th>What it may do</th>
                    </tr>
                </thead>
                <tbody>
                    <% jobs.forEach(job => { %>
                    <tr data-job="<%= job.id %>">
                        <td>
                            <%= job.displayName %>
                            <br><small class="text-muted"><code><%= job.id %></code></small>
                            <% if (!job.scheduled) { %>
                            <br><small class="text-muted">Not scheduled on this site</small>
                            <% } %>
                        </td>
                        <td>
                            <% if (!job.ownPermissions) { %>
                            Runs with the system roles<% if (job.systemRoles.length > 0) { %> (<%= job.systemRoles.join(', ') %>)<% } %>
                            <% } else if (job.grants.length === 0) { %>
                            Holds no permissions
                            <% } else { %>
                            <ul class="list-unstyled mb-0">
                                <% job.grants.forEach(g => { %>
                                <li>
                                    <i class="fas <%= g.limited ? 'fa-adjust text-info' : 'fa-check text-success' %>"<% if (g.limited) { %> title="Only on some pages"<% } %>></i>
                                    <code class="text-primary"><%= g.key %></code>
                                    <small class="text-muted"><%= g.label %></small>
                                    <small>— granted by <%= g.policies.join(', ') %></small>
                                </li>
                                <% }); %>
                            </ul>
                            <% } %>
                            <% if (job.denies.length > 0) { %>
                            <div class="mt-1"><small class="text-muted">Refused by a policy: <%= job.denies.map(d => d.label).join(', ') %></small></div>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <p class="mb-0">No scheduled jobs on this site.</p>
        <% } %>
    </div>
</div>


<%- include('footer') %>
