<%- include('header', { pageName: '' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Security Policy Management</h1>
    <a href="/admin" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
</div>

<div class="alert alert-info">
    <strong>Wiki-Wide Security Policy:</strong> Define what permissions each role has across the entire wiki.
    Page-level ACLs can further restrict access but cannot grant more permissions than defined here.
</div>

<!-- Role Management -->
<div class="row">
    <% roles.forEach(role => { %>
    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <span class="badge <%= role.issystem ? 'bg-primary' : 'bg-secondary' %> me-2">
                        <%= role.issystem ? 'System' : 'Custom' %>
                    </span>
                    <%= role.displayname %>
                </h5>
                <small class="text-muted"><%= role.name %></small>
            </div>
            <div class="card-body">
                            <form class="role-form" data-role="<%= role.name %>">
                                <div class="mb-3">
                                    <label class="form-label">Display Name</label>
                                    <input type="text" class="form-control" name="displayName"
                                           value="<%= role.displayname %>" <%= role.issystem ? 'readonly' : '' %>
                                           style="<%= role.issystem ? 'background-color: #ffffff !important; color: #212529 !important;' : '' %>">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" name="description" rows="2"
                                              <%= role.issystem ? 'readonly' : '' %>
                                              style="<%= role.issystem ? 'background-color: #ffffff !important; color: #212529 !important;' : '' %>"><%= role.description %></textarea>
                                </div>
                                
                                <div class="alert alert-info">
                                    <small>
                                        <i class="fas fa-info-circle"></i>
                                        Permissions are managed through Access Policies, not directly on roles.
                                        Visit the Policies page to configure role-based permissions.
                                    </small>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save"></i> Update Role
                                    </button>
                                    <% if (!role.issystem) { %>
                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                            onclick="deleteRole('<%= role.name %>')">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                    <% } %>
                                </div>
            </form>
        </div>
        <div class="card-footer">
            <small class="text-muted">
                <% if (role.issystem) { %>
                    System Role
                <% } else { %>
                    Custom Role
                <% } %>
                <% if (role.lastmodified) { %>
                | Last modified: <%= new Date(role.lastmodified).toLocaleDateString() %>
                <% } %>
            </small>
        </div>
    </div>
</div>
<% }); %>
</div>

<!-- Security Policy Summary -->
<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Security Policy Summary</h5>
    </div>
    <div class="card-body">
        <% if (permissions && permissions.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm">
                <thead>
                    <tr>
                        <th style="width: 300px;">Permission</th>
                        <% roles.forEach(role => { %>
                        <th class="text-center"><%= role.displayname %></th>
                        <% }); %>
                    </tr>
                </thead>
                <tbody>
                    <% permissions.forEach(perm => { %>
                    <tr>
                        <td>
                            <code class="text-primary"><%= perm.key %></code>
                            <br><small class="text-muted"><%= perm.description %></small>
                        </td>
                        <% roles.forEach(role => { %>
                        <td class="text-center">
                            <% if (role.permissions && role.permissions.includes(perm.key)) { %>
                            <i class="fas fa-check text-success"></i>
                            <% } else { %>
                            <i class="fas fa-times text-muted"></i>
                            <% } %>
                        </td>
                        <% }); %>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            No permissions defined in the system. Permissions are configured through Access Policies.
        </div>
        <% } %>
    </div>
</div>

<script>
// Handle role form submissions
document.querySelectorAll('.role-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const roleName = form.dataset.role;
        const formData = new FormData(form);
        
        // Get all checked permissions
        const permissions = Array.from(form.querySelectorAll('input[name="permissions"]:checked'))
            .map(cb => cb.value);
        
        const data = {
            permissions: permissions,
            displayName: formData.get('displayName'),
            description: formData.get('description')
        };
        
        try {
            // #727: state-changing request needs the CSRF token (#663).
            const response = await (window.csrfFetch || fetch)(`/admin/roles/${roleName}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Show success message
                showAlert('success', `Role "${roleName}" updated successfully`);
            } else {
                showAlert('danger', result.message || 'Failed to update role');
            }
        } catch (err) {
            console.error('Error updating role:', err);
            showAlert('danger', 'Error updating role');
        }
    });
});

function showAlert(type, message) {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
    alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    const container = document.querySelector('.container-fluid');
    container.insertBefore(alertDiv, container.firstChild);
    
    // Auto-dismiss after 3 seconds
    setTimeout(() => {
        alertDiv.remove();
    }, 3000);
}

function deleteRole(roleName) {
    if (confirm(`Are you sure you want to delete the role "${roleName}"?`)) {
        // Implement delete functionality
        console.log('Delete role:', roleName);
    }
}
</script>

<%- include('footer') %>
