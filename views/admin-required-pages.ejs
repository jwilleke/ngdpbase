<%- include('header', { pageName: '' }) %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/diff2html@3.4.56/bundles/css/diff2html.min.css" />

<div class="container mt-4">
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> <%= successMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> <%= errorMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/admin">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active">Required Pages Sync</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="fas fa-sync-alt"></i> Required Pages Sync</h1>
                    <p class="lead">Compare the <code>required-pages/</code> source files against the live wiki pages and sync any that are new or out of date.</p>
                </div>
                <a href="/admin" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Product update / protection info banner -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card border-secondary">
                <div class="card-header bg-transparent d-flex align-items-center gap-2" style="cursor:pointer;"
                     data-bs-toggle="collapse" data-bs-target="#updateProtectionInfo" aria-expanded="false">
                    <i class="fas fa-shield-alt text-secondary"></i>
                    <strong class="text-secondary">What happens during a product update?</strong>
                    <i class="fas fa-chevron-down ms-auto text-secondary small"></i>
                </div>
                <div class="collapse" id="updateProtectionInfo">
                    <div class="card-body small">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="text-success"><i class="fas fa-lock me-1"></i>Protected from overwrite</h6>
                                <ul class="mb-0">
                                    <li>Live pages in <code>data/pages/</code> that have been edited in the wiki UI are flagged <code>user-modified: true</code>. A sync will show them as <strong>Modified</strong> and will not auto-overwrite them — an admin must sync them manually.</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>At risk of overwrite</h6>
                                <ul class="mb-0">
                                    <li>Files written via <strong>Push to Source</strong> exist only in the local <code>required-pages/</code> directory. A <code>git pull</code> or product upgrade will overwrite them. They are not in the repository unless manually committed and pushed by a contributor.</li>
                                    <li>Live pages that were never edited in the wiki UI (no <code>user-modified</code> flag) will be silently replaced when a new product version ships updated source content and an admin syncs.</li>
                                </ul>
                            </div>
                        </div>
                        <div class="alert alert-warning mt-3 mb-0 py-2">
                            <i class="fas fa-info-circle me-1"></i>
                            <strong>Best practice:</strong> Customize required pages in the wiki UI (sets <code>user-modified</code>) rather than via Push to Source. Push to Source is only durable if someone with repository access subsequently commits and pushes the file.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Summary -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="d-flex gap-3 align-items-center flex-wrap mb-3">
                <% if (counts.uuidMismatch > 0) { %>
                <span class="badge bg-danger fs-6 px-3 py-2"
                      title="A different page with the same name already exists on this site">
                    <i class="fas fa-exclamation-triangle me-1"></i> <%= counts.uuidMismatch %> UUID Mismatch
                </span>
                <% } %>
                <% if (counts.titleDrift > 0) { %>
                <span class="badge bg-info fs-6 px-3 py-2"
                      title="Source title differs from live page title">
                    <i class="fas fa-tag me-1"></i> <%= counts.titleDrift %> Title Drift
                </span>
                <% } %>
                <span class="badge bg-primary fs-6 px-3 py-2">
                    <i class="fas fa-plus-circle me-1"></i> <%= counts.new %> New
                </span>
                <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                    <i class="fas fa-edit me-1"></i> <%= counts.modified %> Modified
                </span>
                <span class="badge bg-success fs-6 px-3 py-2">
                    <i class="fas fa-check me-1"></i> <%= counts.current %> Current
                </span>
                <span class="text-muted"><%= comparison.length %> total source pages</span>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <% if (counts.uuidMismatch > 0 || counts.new > 0 || counts.modified > 0) { %>
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex gap-2 flex-wrap">
                <% if (counts.uuidMismatch > 0) { %>
                <button class="btn btn-warning" onclick="adoptUuidAll()"
                        title="For every mismatched page: keep the page already here and make it the shipped page">
                    <i class="fas fa-id-card me-1"></i> Adopt UUID for All (<%= counts.uuidMismatch %>)
                </button>
                <button class="btn btn-outline-danger" onclick="reconcileAllMismatches()"
                        title="For every mismatched page: move the page already here to the trash and add the shipped page">
                    <i class="fas fa-exchange-alt me-1"></i> Replace with Source (<%= counts.uuidMismatch %>)
                </button>
                <% } %>
                <% if (counts.new > 0) { %>
                <button class="btn btn-primary" onclick="syncByStatus('new')">
                    <i class="fas fa-plus-circle me-1"></i> Sync All New (<%= counts.new %>)
                </button>
                <% } %>
                <% if (counts.outdatedSyncable > 0) { %>
                <button class="btn btn-warning" onclick="syncByStatus('outdated')" data-testid="sync-all-outdated"
                        title="<%= counts.outdatedUserEdited > 0 ? `${counts.outdatedUserEdited} user-edited page${counts.outdatedUserEdited !== 1 ? 's are' : ' is'} skipped` : 'Sync all new and modified pages' %>">
                    <i class="fas fa-sync me-1"></i> Sync All Outdated (<%= counts.outdatedSyncable %>)
                </button>
                <% } else if (counts.outdatedUserEdited > 0) { %>
                <button class="btn btn-warning" disabled data-testid="sync-all-outdated">
                    <i class="fas fa-sync me-1"></i> Sync All Outdated — <%= counts.outdatedUserEdited %> user-edited: use <%= counts.outdatedUserEdited !== 1 ? "their rows'" : "its row's" %> Sync or diff
                </button>
                <% } %>
                <button class="btn btn-outline-secondary" onclick="syncSelected()">
                    <i class="fas fa-check-square me-1"></i> Sync Selected
                </button>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Comparison Table -->
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-file-alt"></i> Source Pages</h5>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary me-1" onclick="selectAll(true)">Select All</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="selectAll(false)">Deselect All</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <% if (comparison.length === 0) { %>
                        <div class="p-4 text-muted">No required-pages source files found.</div>
                    <% } else { %>
                    <% if (counts.uuidMismatch > 0) { %>
                    <div class="px-3 pt-3">
                        <%- include('_uuid-mismatch-help', { mismatchHelp: { actions: ['diff', 'adopt', 'replace', 'decline', 'all'] } }) %>
                    </div>
                    <% } %>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="pagesTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40px;">
                                        <input type="checkbox" id="selectAllCheck" onchange="selectAll(this.checked)" title="Select all">
                                    </th>
                                    <th>Title</th>
                                    <th>Slug</th>
                                    <th>Status</th>
                                    <th>Source Modified</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% comparison.forEach(page => { %>
                                <tr data-uuid="<%= page.uuid %>" data-status="<%= page.status %>" data-live-uuid="<%= page.liveUuid || '' %>" data-user-modified="<%= page.userModified ? 'true' : 'false' %>" data-bulk-outdated="<%= page.bulkOutdated ? 'true' : 'false' %>">
                                    <td>
                                        <% if (page.status !== 'current') { %>
                                        <input type="checkbox" class="page-checkbox" value="<%= page.uuid %>">
                                        <% } %>
                                    </td>
                                    <td>
                                        <strong><%= page.title %></strong>
                                        <% if (page.titleDrift) { %>
                                        <br><span class="badge bg-info text-dark"
                                                  title="Live page title: <%= page.liveTitle %>">
                                            <i class="fas fa-tag me-1"></i>Live: "<%= page.liveTitle %>"
                                        </span>
                                        <% if (page.affectedLinks > 0) { %>
                                        <br><small class="text-warning">
                                            <i class="fas fa-link me-1"></i><%= page.affectedLinks %> required-page<%= page.affectedLinks !== 1 ? 's' : '' %> link to live title
                                        </small>
                                        <% } %>
                                        <% } %>
                                        <br><small class="text-muted font-monospace"><%= page.uuid %></small>
                                    </td>
                                    <td><code><%= page.slug || '—' %></code></td>
                                    <td>
                                        <% if (page.status === 'uuid-mismatch') { %>
                                            <span class="badge bg-danger"
                                                  title="Source UUID: <%= page.uuid %> | Live UUID: <%= page.liveUuid %>">
                                                UUID Mismatch
                                            </span>
                                            <br><small class="text-muted font-monospace">live: <%= page.liveUuid %></small>
                                        <% } else { %>
                                            <%- include('_sync-status', { syncItem: { status: page.status, userModified: page.userModified } }) %>
                                        <% } %>
                                    </td>
                                    <td><small class="text-muted"><%= page.lastModified || '—' %></small></td>
                                    <td>
                                        <% if (page.status === 'modified') { %>
                                        <button class="btn btn-sm btn-outline-info"
                                                onclick="showDiff('<%= page.uuid %>', '<%= page.title.replace(/'/g, '\\\'') %>')">
                                            <i class="fas fa-code-branch"></i> Diff
                                        </button>
                                        <% } %>
                                        <% if (page.status === 'uuid-mismatch') { %>
                                        <button class="btn btn-sm btn-outline-info"
                                                onclick="showDiff('<%= page.uuid %>', '<%= page.title.replace(/'/g, '\\\'') %>', '<%= page.liveUuid %>')"
                                                title="Compare the shipped page with the page already here">
                                            <i class="fas fa-code-branch"></i> Diff
                                        </button>
                                        <button class="btn btn-sm btn-warning"
                                                onclick="adoptUuidOne('<%= page.uuid %>', '<%= page.liveUuid %>', '<%= page.title.replace(/'/g, '\\\'') %>')"
                                                title="Keep the page already here and make it this shipped page">
                                            <i class="fas fa-id-card"></i> Adopt UUID
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="reconcileOne('<%= page.uuid %>', '<%= page.liveUuid %>', '<%= page.title.replace(/'/g, '\\\'') %>')"
                                                title="Move the page already here to the trash and add the shipped page">
                                            <i class="fas fa-exchange-alt"></i> Replace
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                onclick="declineOne('<%= page.source %>', '<%= page.uuid %>', '<%= page.title.replace(/'/g, '\\\'') %>', 'A page with slug or title already exists under UUID <%= page.liveUuid %>')"
                                                title="Keep the live page. This site stops being offered this shipped page.">
                                            <i class="fas fa-ban"></i> Don't Seed Here
                                        </button>
                                        <% } %>
                                        <% if (page.status !== 'current' && page.status !== 'uuid-mismatch') { %>
                                        <%- include('_sync-button', { syncItem: { userModified: page.userModified, id: page.uuid, name: page.title, forceNote: 'The edited version stays in the page history.' } }) %>
                                        <% } %>
                                        <% if (page.userModified || page.titleDrift) { %>
                                        <button class="btn btn-sm btn-outline-warning"
                                                onclick="pushToSourceOne('<%= page.uuid %>', '<%= page.title.replace(/'/g, '\\\'') %>')"
                                                title="Push live edits back to required-pages/ source">
                                            <i class="fas fa-upload"></i> Push to Source
                                        </button>
                                        <% } %>
                                        <% if (page.slug) { %>
                                        <a href="/view/<%= encodeURIComponent(page.slug) %>"
                                           class="btn btn-sm btn-outline-secondary" target="_blank"
                                           title="View live page">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Not in GitHub yet (#1377): live pages whose category belongs in the
         required-pages set but whose UUID is not in it. -->
    <% if (typeof notInSource !== 'undefined' && notInSource.length > 0) { %>
    <div class="row mt-2">
        <div class="col-12">
            <div class="card mb-4 border-warning" id="notInSourceCard">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-code-branch me-2 text-warning"></i>Not in GitHub Yet (<%= notInSource.length %>)</h5>
                    <small class="text-muted">These pages have a <strong>system</strong> or <strong>documentation</strong> category, so they belong in the
                        required-pages set every install gets — but they are not in it. For each: push it to the source folder (a person then commits it),
                        change its category if it is not meant to ship, or delete it.</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="notInSourceTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Author</th>
                                    <th>Last modified</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% notInSource.forEach(page => { %>
                                <tr data-uuid="<%= page.uuid %>">
                                    <td>
                                        <a href="/view/<%= encodeURIComponent(page.title) %>" target="_blank"><strong><%= page.title %></strong></a>
                                        <br><small class="text-muted font-monospace"><%= page.uuid %></small>
                                    </td>
                                    <td><span class="badge bg-info text-dark"><%= page.category %></span></td>
                                    <td><%= page.author || '—' %></td>
                                    <td><small><%= page.lastModified ? page.lastModified.slice(0, 10) : '—' %></small></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"
                                                onclick="pushToSourceOne('<%= page.uuid %>', '<%= page.title.replace(/'/g, '\\\'') %>')"
                                                title="Copy the live page into the required-pages source folder (not committed)">
                                            <i class="fas fa-upload"></i> Push to source
                                        </button>
                                        <a href="/edit/<%= encodeURIComponent(page.title) %>" class="btn btn-sm btn-outline-secondary"
                                           title="Change the category, or delete the page">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Addon Pages Section -->
    <% if (typeof addonComparison !== 'undefined' && addonComparison.length > 0) { %>
    <div class="row mt-2">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0"><i class="fas fa-puzzle-piece me-2"></i>Addon Pages</h5>
                        <small class="text-muted">Pages shipped with enabled addons —
                            <%- include('_sync-counts', { syncCounts: addonCounts }) %>
                        </small>
                    </div>
                    <% if (addonCounts.outdatedSyncable > 0) { %>
                    <button class="btn btn-sm btn-warning" onclick="syncAddonOutdated()" data-testid="sync-addon-outdated"
                            title="<%= addonCounts.outdatedUserEdited > 0 ? `${addonCounts.outdatedUserEdited} user-edited addon page${addonCounts.outdatedUserEdited !== 1 ? 's are' : ' is'} skipped` : 'Sync all new and modified addon pages' %>">
                        <i class="fas fa-sync me-1"></i> Sync All Outdated (<%= addonCounts.outdatedSyncable %>)
                    </button>
                    <% } else if (addonCounts.outdatedUserEdited > 0) { %>
                    <button class="btn btn-sm btn-warning" disabled data-testid="sync-addon-outdated">
                        <i class="fas fa-sync me-1"></i> Sync All Outdated — <%= addonCounts.outdatedUserEdited %> user-edited: use <%= addonCounts.outdatedUserEdited !== 1 ? "their rows'" : "its row's" %> Sync or diff
                    </button>
                    <% } %>
                </div>
                <div class="card-body p-0">
                    <% if (addonCounts.uuidMismatch > 0) { %>
                    <div class="px-3 pt-3">
                        <%- include('_uuid-mismatch-help', { mismatchHelp: { actions: ['decline'] } }) %>
                    </div>
                    <% } %>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="addonPagesTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px;">
                                        <input type="checkbox" id="selectAllAddonCheck"
                                               onchange="selectAllAddon(this.checked)" title="Select all addon pages">
                                    </th>
                                    <th>Title</th>
                                    <th>Addon</th>
                                    <th>Slug</th>
                                    <th>Status</th>
                                    <th>Source Modified</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% addonComparison.forEach(page => { %>
                                <tr data-uuid="<%= page.uuid %>" data-status="<%= page.status %>"
                                    data-user-modified="<%= page.userModified ? 'true' : 'false' %>"
                                    data-bulk-outdated="<%= page.bulkOutdated ? 'true' : 'false' %>"
                                    class="addon-row">
                                    <td>
                                        <% if (page.status !== 'current') { %>
                                        <input type="checkbox" class="addon-checkbox" value="<%= page.uuid %>">
                                        <% } %>
                                    </td>
                                    <td>
                                        <strong><%= page.title %></strong>
                                        <br><small class="text-muted font-monospace"><%= page.uuid %></small>
                                    </td>
                                    <td><span class="badge bg-secondary"><%= page.addonName %></span></td>
                                    <td><code><%= page.slug || '—' %></code></td>
                                    <td>
                                        <% if (page.status === 'uuid-mismatch') { %>
                                            <span class="badge bg-danger">UUID Mismatch</span>
                                            <br><small class="text-muted">live: <span class="font-monospace"><%= page.liveUuid %></span></small>
                                        <% } else { %>
                                            <%- include('_sync-status', { syncItem: { status: page.status, userModified: page.userModified } }) %>
                                        <% } %>
                                    </td>
                                    <td><small class="text-muted"><%= page.lastModified || '—' %></small></td>
                                    <td>
                                        <% if (page.status === 'modified') { %>
                                        <button class="btn btn-sm btn-outline-info"
                                                onclick="showDiff('<%= page.uuid %>', '<%= page.title.replace(/'/g, '\\\'') %>')">
                                            <i class="fas fa-code-branch"></i> Diff
                                        </button>
                                        <% } %>
                                        <% if (page.status === 'uuid-mismatch') { %>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                onclick="declineOne('<%= page.source %>', '<%= page.uuid %>', '<%= page.title.replace(/'/g, '\\\'') %>', 'A page with slug or title already exists under UUID <%= page.liveUuid %>')"
                                                title="Keep the live page. This site stops being offered this addon page.">
                                            <i class="fas fa-ban"></i> Don't Seed Here
                                        </button>
                                        <% } %>
                                        <% if (page.status !== 'current' && page.status !== 'uuid-mismatch') { %>
                                        <%- include('_sync-button', { syncItem: { userModified: page.userModified, id: page.uuid, name: page.title, forceNote: 'The edited version stays in the page history.' } }) %>
                                        <% } %>
                                        <% if (page.slug) { %>
                                        <a href="/view/<%= encodeURIComponent(page.slug) %>"
                                           class="btn btn-sm btn-outline-secondary" target="_blank">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Declined Section (#1412: pages this site will not take) -->
    <% if (typeof declined !== 'undefined' && declined.length > 0) { %>
    <div class="row">
        <div class="col-12">
            <div class="card mb-4 border-secondary">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-ban me-2 text-secondary"></i>Not Seeded Here (<%= declined.length %>)</h5>
                    <small class="text-muted">Shipped pages this site was told not to take</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="declinedTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Shipped By</th>
                                    <th>Why</th>
                                    <th>Declined</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% declined.forEach(page => { %>
                                <tr data-uuid="<%= page.uuid %>" data-source="<%= page.source %>" class="declined-row">
                                    <td>
                                        <strong><%= page.title %></strong>
                                        <br><small class="text-muted font-monospace"><%= page.uuid %></small>
                                    </td>
                                    <td><span class="badge bg-secondary"><%= page.source %></span></td>
                                    <td><small class="text-muted"><%= page.reason %></small></td>
                                    <td><small class="text-muted"><%= page.at %> by <%= page.by %></small></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"
                                                onclick="allowOne('<%= page.source %>', '<%= page.uuid %>', '<%= page.title.replace(/'/g, '\\\'') %>')"
                                                title="Offer this page again at the next start-up or sync">
                                            <i class="fas fa-undo"></i> Seed Here
                                        </button>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Orphaned Addon Pages Section (#930: source removed) -->
    <% if (typeof orphanedAddonPages !== 'undefined' && orphanedAddonPages.length > 0) { %>
    <div class="row mt-2">
        <div class="col-12">
            <div class="card mb-4 border-danger">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-unlink me-2 text-danger"></i>Addon Pages — Source Removed</h5>
                    <small class="text-muted">These pages were seeded by an addon that <strong>no longer ships the source page</strong>.
                        They are <strong>left in place</strong> (never auto-deleted). Remove one only if you're sure it's obsolete —
                        removal keeps a revertable version.</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="orphanedAddonPagesTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Addon</th>
                                    <th>Slug</th>
                                    <th>Note</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orphanedAddonPages.forEach(page => { %>
                                <tr data-uuid="<%= page.uuid %>" class="orphan-row">
                                    <td>
                                        <strong><%= page.title %></strong>
                                        <br><small class="text-muted font-monospace"><%= page.uuid %></small>
                                    </td>
                                    <td><span class="badge bg-secondary"><%= page.addonName %></span></td>
                                    <td><code><%= page.slug || '—' %></code></td>
                                    <td>
                                        <span class="badge bg-danger">Source removed</span>
                                        <% if (page.userModified) { %>
                                        <br><span class="badge bg-secondary mt-1"><i class="fas fa-user-edit me-1"></i>User Edited</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (page.slug) { %>
                                        <a href="/view/<%= encodeURIComponent(page.slug) %>"
                                           class="btn btn-sm btn-outline-secondary" target="_blank">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                        <% } %>
                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="removeOrphan('<%= page.uuid %>', '<%= page.title.replace(/'/g, '\\\'') %>')"
                                                title="Delete this orphaned page (a revertable version is kept)">
                                            <i class="fas fa-trash"></i> Remove
                                        </button>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Diff Modal -->
    <div class="modal fade" id="diffModal" tabindex="-1" aria-labelledby="diffModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="diffModalLabel">
                        <i class="fas fa-code-branch me-2"></i>
                        <span id="diffModalTitle"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="d-flex gap-2 px-3 py-2 border-bottom align-items-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active"
                                    id="modalBtnUnified" onclick="renderModalDiff('line-by-line')">
                                <i class="fas fa-align-left me-1"></i>Unified
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                    id="modalBtnSideBySide" onclick="renderModalDiff('side-by-side')">
                                <i class="fas fa-columns me-1"></i>Side-by-side
                            </button>
                        </div>
                        <a id="diffFullPageLink" href="#" target="_blank"
                           class="btn btn-sm btn-outline-primary ms-auto">
                            <i class="fas fa-external-link-alt me-1"></i>Open full page
                        </a>
                    </div>
                    <div id="modalDiffContainer" class="p-3">
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin fa-2x"></i>
                            <p class="mt-2">Loading diff…</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Result Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="syncToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <i class="fas fa-sync-alt me-2 text-primary"></i>
                <strong class="me-auto">Required Pages Sync</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="syncToastBody"></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/diff2html@3.4.56/bundles/js/diff2html.min.js"></script>
<script nonce="<%= locals.cspNonce %>">
const CSRF_TOKEN = '<%= csrfToken %>';
let currentDiffString = null;
let diffModal = null;

async function showDiff(uuid, title, liveUuid = '') {
    document.getElementById('diffModalTitle').textContent = `${title}: source vs live`;
    const fullPageParams = new URLSearchParams({ uuid, source: 'required' });
    if (liveUuid) fullPageParams.set('liveUuid', liveUuid);
    document.getElementById('diffFullPageLink').href = `/admin/diff?${fullPageParams}`;
    document.getElementById('modalDiffContainer').innerHTML =
        '<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin fa-2x"></i><p class="mt-2">Loading diff…</p></div>';

    if (!diffModal) {
        diffModal = new bootstrap.Modal(document.getElementById('diffModal'));
    }
    diffModal.show();

    try {
        const apiParams = new URLSearchParams({ uuid, source: 'required' });
        if (liveUuid) apiParams.set('liveUuid', liveUuid);
        const response = await csrfFetch(`/api/admin/diff?${apiParams}`, {
            headers: { 'X-CSRF-Token': CSRF_TOKEN }
        });
        const result = await response.json();
        if (!result.success) {
            document.getElementById('modalDiffContainer').innerHTML =
                `<div class="alert alert-danger m-3">Error: ${result.error}</div>`;
            return;
        }
        currentDiffString = result.diffString;
        renderModalDiff('line-by-line');
    } catch (err) {
        document.getElementById('modalDiffContainer').innerHTML =
            `<div class="alert alert-danger m-3">Network error: ${err.message}</div>`;
    }
}

function renderModalDiff(format) {
    if (!currentDiffString) return;
    document.getElementById('modalBtnUnified').classList.toggle('active', format === 'line-by-line');
    document.getElementById('modalBtnSideBySide').classList.toggle('active', format === 'side-by-side');

    const container = document.getElementById('modalDiffContainer');
    if (!currentDiffString.trim()) {
        container.innerHTML = '<div class="alert alert-success m-3"><i class="fas fa-check-circle me-2"></i>Files are identical.</div>';
        return;
    }
    const html = Diff2Html.html(currentDiffString, {
        drawFileList: false,
        matching: 'lines',
        outputFormat: format
    });
    container.innerHTML = html;
}

function selectAll(checked) {
    document.querySelectorAll('.page-checkbox').forEach(cb => cb.checked = checked);
    const master = document.getElementById('selectAllCheck');
    if (master) master.checked = checked;
}

function selectAllAddon(checked) {
    document.querySelectorAll('.addon-checkbox').forEach(cb => cb.checked = checked);
    const master = document.getElementById('selectAllAddonCheck');
    if (master) master.checked = checked;
}

async function syncAddonOutdated() {
    // #1871: the server marks the rows the bulk sync takes (user-edited pages
    // are protected) — the same flag the button's count is built from.
    const uuids = Array.from(document.querySelectorAll('.addon-row[data-bulk-outdated="true"]'))
        .map(row => row.dataset.uuid);
    if (uuids.length === 0) { showToast('No addon pages to sync.'); return; }
    await doSync(uuids, `Syncing ${uuids.length} addon page${uuids.length !== 1 ? 's' : ''}…`);
}

function getUuidsByStatus(status) {
    const uuids = [];
    // #1871: required-pages rows only — the add-on table has its own button and
    // count. 'outdated' takes the rows the server marked for the bulk sync
    // (user-edited pages are protected), the same flag the count is built from.
    document.querySelectorAll('#pagesTable tr[data-status]').forEach(row => {
        if (status === 'outdated') {
            if (row.dataset.bulkOutdated === 'true') uuids.push(row.dataset.uuid);
        } else if (row.dataset.status === status) {
            uuids.push(row.dataset.uuid);
        }
    });
    return uuids;
}

function getSelectedUuids() {
    return Array.from(document.querySelectorAll('.page-checkbox:checked, .addon-checkbox:checked')).map(cb => cb.value);
}

async function syncOne(uuid, title, force = false) {
    await doSync([uuid], `Syncing "${title}"…`, force);
}

// #1918: a row's Sync / Force Sync is the shared _sync-button partial; Force
// Sync asks first (data-confirm), as on every screen that syncs shipped content.
document.addEventListener('click', function (e) {
    const button = e.target.closest('button[data-sync-id]');
    if (!button) return;
    if (button.dataset.confirm && !confirm(button.dataset.confirm)) return;
    void syncOne(button.dataset.syncId, button.dataset.syncName, button.dataset.action === 'force-sync');
});

async function syncByStatus(status) {
    const uuids = getUuidsByStatus(status);
    if (uuids.length === 0) {
        showToast('No pages to sync.');
        return;
    }
    await doSync(uuids, `Syncing ${uuids.length} page${uuids.length !== 1 ? 's' : ''}…`);
}

async function syncSelected() {
    const uuids = getSelectedUuids();
    if (uuids.length === 0) {
        showToast('No pages selected. Check the boxes next to pages you want to sync.');
        return;
    }
    await doSync(uuids, `Syncing ${uuids.length} selected page${uuids.length !== 1 ? 's' : ''}…`);
}

// #1412: this site will not take a shipped page whose title or slug belongs to
// a page it would rather keep. Nothing is written to any page.
async function declineOne(source, uuid, title, reason) {
    if (!confirm(`Stop offering "${title}" on this site?\n\nThe live page is untouched. You can undo this from the "Not Seeded Here" list.`)) return;
    await postSync({ decline: [{ source, uuid, reason }] }, `Declining "${title}"…`);
}

async function allowOne(source, uuid, title) {
    await postSync({ allow: [{ source, uuid }] }, `Offering "${title}" again…`);
}

/** POST the sync endpoint, report, and reload so the lists reflect the change. */
async function postSync(body, statusMsg) {
    showToast(statusMsg);
    try {
        const response = await csrfFetch('/admin/required-pages/sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(body)
        });
        const result = await response.json();
        if (result.success) {
            showToast(`✓ ${result.message}`);
            setTimeout(() => location.reload(), 1200);
        } else {
            showToast(`✗ Error: ${result.error}`);
        }
    } catch (err) {
        showToast(`✗ Network error: ${err.message}`);
    }
}

async function doSync(uuids, statusMsg, force = false) {
    showToast(statusMsg);

    try {
        const response = await csrfFetch('/admin/required-pages/sync', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({ uuids, force })
        });

        const result = await response.json();

        if (result.success) {
            showToast(`✓ ${result.message}`);
            // Mark synced rows as current
            (result.uuids || []).forEach(uuid => {
                const row = document.querySelector(`tr[data-uuid="${uuid}"]`);
                if (row) {
                    row.dataset.status = 'current';
                    row.querySelector('td:nth-child(4)').innerHTML =
                        '<span class="badge bg-success">Current</span>';
                    row.querySelectorAll('.page-checkbox').forEach(el => el.remove());
                    row.querySelectorAll('td:last-child button').forEach(el => el.remove());
                }
            });
            // Highlight protected (user-edited) rows that were skipped
            if (result.protected && result.protected.length > 0) {
                result.protected.forEach(uuid => {
                    const row = document.querySelector(`tr[data-uuid="${uuid}"]`);
                    if (row) row.classList.add('table-warning');
                });
            }
            // Reload to update summary badges
            setTimeout(() => location.reload(), 2000);
        } else {
            showToast(`✗ Error: ${result.error}`);
        }
    } catch (err) {
        showToast(`✗ Network error: ${err.message}`);
    }
}

// #930: remove a single orphaned addon page (source removed). Opt-in, per-row,
// server re-verifies it's actually an orphan before deleting; keeps a version.
async function removeOrphan(uuid, title) {
    if (!confirm(`Remove orphaned addon page "${title}"?\n\nIts addon no longer ships this page. A revertable version is kept, so this can be undone.`)) return;
    showToast(`Removing "${title}"…`);
    try {
        const response = await csrfFetch('/admin/required-pages/sync', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({ removeOrphans: [uuid] })
        });
        const result = await response.json();
        if (result.success) {
            showToast(`✓ ${result.message}`);
            const row = document.querySelector(`tr.orphan-row[data-uuid="${uuid}"]`);
            if (row) row.remove();
            setTimeout(() => location.reload(), 1500);
        } else {
            showToast(`✗ Error: ${result.error}`);
        }
    } catch (err) {
        showToast(`✗ Network error: ${err.message}`);
    }
}

async function reconcileOne(sourceUuid, liveUuid, title) {
    await doReconcile([{ sourceUuid, liveUuid }], `Reconciling "${title}"…`);
}

function reconcileAllMismatches() {
    const items = [];
    document.querySelectorAll('tr[data-status="uuid-mismatch"]').forEach(row => {
        items.push({ sourceUuid: row.dataset.uuid, liveUuid: row.dataset.liveUuid });
    });
    if (items.length === 0) {
        showToast('No mismatches to reconcile.');
        return;
    }
    doReconcile(items, `Reconciling ${items.length} mismatch${items.length !== 1 ? 'es' : ''}…`);
}

async function doReconcile(items, statusMsg) {
    showToast(statusMsg);
    try {
        const response = await csrfFetch('/admin/required-pages/sync', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({ reconcile: items })
        });
        const result = await response.json();
        if (result.success) {
            showToast(`✓ ${result.message}`);
            result.uuids.forEach(uuid => {
                const row = document.querySelector(`tr[data-uuid="${uuid}"]`);
                if (row) {
                    row.dataset.status = 'current';
                    row.querySelector('td:nth-child(4)').innerHTML =
                        '<span class="badge bg-success">Current</span>';
                    row.querySelectorAll('.page-checkbox').forEach(el => el.remove());
                    row.querySelectorAll('td:last-child button').forEach(el => el.remove());
                }
            });
            setTimeout(() => location.reload(), 2000);
        } else {
            showToast(`✗ Error: ${result.error}`);
        }
    } catch (err) {
        showToast(`✗ Network error: ${err.message}`);
    }
}

async function adoptUuidOne(sourceUuid, liveUuid, title) {
    await doAdoptUuid([{ sourceUuid, liveUuid }], `Adopting UUID for "${title}"…`);
}

function adoptUuidAll() {
    const items = [];
    document.querySelectorAll('tr[data-status="uuid-mismatch"]').forEach(row => {
        items.push({ sourceUuid: row.dataset.uuid, liveUuid: row.dataset.liveUuid });
    });
    if (items.length === 0) {
        showToast('No mismatches to fix.');
        return;
    }
    doAdoptUuid(items, `Adopting UUID for ${items.length} page${items.length !== 1 ? 's' : ''}…`);
}

async function doAdoptUuid(items, statusMsg) {
    showToast(statusMsg);
    try {
        const response = await csrfFetch('/admin/required-pages/sync', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({ adoptUuid: items })
        });
        const result = await response.json();
        if (result.success) {
            showToast(`✓ ${result.message}`);
            result.uuids.forEach(uuid => {
                const row = document.querySelector(`tr[data-uuid="${uuid}"]`);
                if (row) {
                    row.querySelectorAll('.page-checkbox').forEach(el => el.remove());
                    row.querySelectorAll('td:last-child button').forEach(el => el.remove());
                }
            });
            setTimeout(() => location.reload(), 2000);
        } else {
            showToast(`✗ Error: ${result.error}`);
        }
    } catch (err) {
        showToast(`✗ Network error: ${err.message}`);
    }
}

async function pushToSourceOne(uuid, title) {
    if (!confirm(
        `Push live edits for "${title}" back to required-pages/ source?\n\n` +
        `⚠ This only updates the LOCAL filesystem.\n\n` +
        `It does NOT commit or push to the repository. A git pull or product upgrade will overwrite this file and your changes will be lost unless a contributor manually commits and pushes it.\n\n` +
        `For durable customization, edit the page in the wiki UI instead — that sets user-modified and protects it from auto-sync overwrites.\n\n` +
        `Continue?`
    )) return;
    showToast(`Pushing "${title}" to source…`);
    try {
        const response = await csrfFetch('/admin/required-pages/sync', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': CSRF_TOKEN
            },
            body: JSON.stringify({ pushToSource: [uuid] })
        });
        const result = await response.json();
        if (result.success) {
            showToast(`✓ Pushed "${title}" to source`);
            setTimeout(() => location.reload(), 1500);
        } else {
            showToast(`✗ Error: ${result.error}`);
        }
    } catch (err) {
        showToast(`✗ Network error: ${err.message}`);
    }
}

function showToast(message) {
    const toastBody = document.getElementById('syncToastBody');
    const toastEl = document.getElementById('syncToast');
    toastBody.textContent = message;
    const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
    toast.show();
}
</script>

<%- include('footer') %>
