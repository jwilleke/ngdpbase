<%- include('header', { pageName: '' }) %>
<%# #1525 — step-up: a sensitive action asked for a fresh sign-in. The passkey,
    password or authenticator app's code (#421) proves the person at the keyboard
    is the account holder now, and the browser returns to the page that asked. %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card mt-4">
        <div class="card-header">
          <h4 class="mb-0"><i class="fas fa-user-shield"></i> Confirm it is you</h4>
        </div>
        <div class="card-body">
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>
          <p>This change protects your account, so it needs a fresh sign-in. You are then sent back to finish it.</p>
          <%# #2356: what this account can add or use here (AuthManager.strongerSignInWays), never the site's whole list. %>
          <% const _ways = typeof ways !== 'undefined' && ways ? ways : {};
             const _totp = typeof hasTotp !== 'undefined' && hasTotp; %>
          <% if (needsPasskey) { %>
            <% if (hasPasskey || _ways.addPasskey) { %>
            <p class="small text-muted">Your role needs a passkey<%= _totp ? ', or your password with your authenticator app\'s code,' : '' %> for this; a password alone is not enough.</p>
            <% } else if (_totp || (_ways.addTotp && hasPassword)) { %>
            <p class="small text-muted">Your role needs your password with your authenticator app's code for this; a password alone is not enough.</p>
            <% } else { %>
            <p class="small text-muted">Your role needs a stronger sign-in for this; a password alone is not enough.</p>
            <% } %>
          <% } %>

          <% if (hasPasskey) { %>
            <button type="button" class="btn btn-primary w-100 mb-3 d-none" data-passkey-reauth
                    data-next="<%= next %>"<% if (prompt) { %> data-prompt="<%= prompt %>"<% } %> data-error-target="reauth-passkey-error">
              <i class="fas fa-key"></i> Confirm with a passkey
            </button>
            <div id="reauth-passkey-error" class="alert alert-danger small d-none" role="alert"></div>
            <script src="/js/passkey.js" defer></script>
          <% } %>

          <% if (hasPassword && !needsPasskey) { %>
            <form method="POST" action="/auth/reauth" autocomplete="off">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="next" value="<%= next %>">
              <% if (prompt) { %><input type="hidden" name="prompt" value="<%= prompt %>"><% } %>
              <div class="mb-3">
                <label class="form-label" for="reauthPassword">Password</label>
                <input type="password" class="form-control" id="reauthPassword" name="password" autocomplete="current-password" required autofocus>
              </div>
              <button type="submit" class="btn btn-outline-primary w-100">Confirm with your password</button>
            </form>
          <% } %>

          <% if (typeof hasTotp !== 'undefined' && hasTotp) { %>
            <%# #421 slice 2c: the code the app shows now; at AAL2, with the password, which the two reach together. %>
            <form method="POST" action="/auth/reauth/totp" autocomplete="off" class="mb-3" data-totp-reauth>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="next" value="<%= next %>">
              <% if (prompt) { %><input type="hidden" name="prompt" value="<%= prompt %>"><% } %>
              <% if (needsPasskey) { %>
              <div class="mb-3">
                <label class="form-label" for="reauthTotpPassword">Password</label>
                <input type="password" class="form-control" id="reauthTotpPassword" name="password" autocomplete="current-password" required>
              </div>
              <% } %>
              <div class="mb-3">
                <label class="form-label" for="reauthTotpCode">Code from your authenticator app</label>
                <input type="text" class="form-control" id="reauthTotpCode" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required>
              </div>
              <button type="submit" class="btn btn-outline-primary w-100"><i class="fas fa-mobile-alt"></i> Confirm with <%= needsPasskey ? 'your password and the code' : 'the code' %></button>
            </form>
          <% } %>

          <% if (!hasPasskey && !_totp && (needsPasskey || !hasPassword)) { %>
            <%# A passkey first, as before; the app only where it would confirm (at AAL2 it needs the password). %>
            <% const _add = _ways.addPasskey ? 'a passkey' : (_ways.addTotp && (!needsPasskey || hasPassword)) ? 'an authenticator app' : '';
               const _outside = Array.isArray(_ways.outside) ? _ways.outside : []; %>
            <p class="mb-0">This account has no way to confirm here<%= needsPasskey ? ' that reaches the level your role needs' : '' %>.
            <% if (_add) { %>Add <%= _add %> on your <a href="/profile">profile</a>, or ask an administrator.<% } else if (_outside.length > 0) { %>Sign out, then sign in with <%= _outside.join(' or ') %>, or ask an administrator.<% } else { %>Ask an administrator.<% } %></p>
          <% } %>

          <%# #2193: a script's prompt is cancelled on the server too, so the page
              waiting on it stops, in a popup or a new tab alike. %>
          <% if (prompt) { %>
            <form method="POST" action="/auth/reauth/cancel" class="small mt-3 mb-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="next" value="<%= next %>">
              <input type="hidden" name="prompt" value="<%= prompt %>">
              <button type="submit" class="btn btn-link btn-sm p-0">Cancel</button>
            </form>
          <% } else { %>
            <p class="small mt-3 mb-0"><a href="<%= next %>">Cancel</a></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('footer') %>
