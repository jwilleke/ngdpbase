<%#
  The status of a shipped item's copy on this site (#1918): the words and
  badges of Admin -> Required Pages, shared by every admin screen that syncs
  shipped content (required pages, add-on pages). The words come
  from syncRowState (src/utils/addonPageSync.ts).

  locals: syncItem, one object (an include also sees its parent's data, so a
  loose name could be picked up from the screen by accident), with:
    status        'new' | 'modified' | 'current'
    userModified  edited on this site: Sync does not replace it, Force Sync does
%>
<% if (syncItem.status === 'new') { %>
<span class="badge bg-primary" data-sync-status="new">New</span>
<% } else if (syncItem.status === 'modified') { %>
<span class="badge bg-warning text-dark" data-sync-status="modified">Modified</span>
<% if (syncItem.userModified) { %>
<br><span class="badge bg-secondary mt-1" data-sync-status="user-edited"
      title="Edited on this site. Sync does not replace it; Force Sync replaces those edits.">
    <i class="fas fa-user-edit me-1"></i>User Edited
</span>
<% } %>
<% } else { %>
<% if (syncItem.userModified) { %>
<span class="badge bg-secondary" data-sync-status="user-edited" title="Edited on this site">
    <i class="fas fa-user-edit me-1"></i>User Edited
</span>
<% } %>
<span class="badge bg-success" data-sync-status="current">Current</span>
<% } %>
