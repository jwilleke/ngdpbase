<%- include('header', { pageName: '' }) %>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card mt-5">
                <div class="card-header text-center">
                    <h4>Sign in to <%= typeof applicationName !== 'undefined' ? applicationName : 'ngdpbase' %></h4>
                </div>
                <div class="card-body">
                    <% if (error) { %>
                        <div class="alert alert-danger">
                            <%= error %>
                        </div>
                    <% } %>
                    
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success">
                            <%= success %>
                        </div>
                    <% } %>
                    
                    <%# #1743: an outside identity waiting to be connected. Shown the same whether or not an account has that email. %>
                    <% if (typeof pendingConnection !== 'undefined' && pendingConnection) { %>
                        <div class="alert alert-info" data-pending-connection>
                            <p class="mb-2">Sign in to connect your <%= pendingConnection.displayName %> account<% if (pendingConnection.email) { %> (<%= pendingConnection.email %>)<% } %>.</p>
                            <form action="/login/connect/cancel" method="POST" class="mb-0">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Don't connect it</button>
                            </form>
                        </div>
                    <% } %>

                    <%# #1781: one labelled section per sign-in method that is on; the headings separate them. %>
                    <% const outside = typeof outsideProviders !== 'undefined' ? outsideProviders : []; %>
                    <% const showPassword = passwordAuthEnabled || outside.length === 0; %>
                    <% const showPasskey = typeof passkeyEnabled !== 'undefined' && passkeyEnabled; %>
                    <% if (showPassword) { %>
                    <section class="mb-4" aria-labelledby="signin-password-heading" data-signin-method="password">
                    <h2 class="h6" id="signin-password-heading">Username and password</h2>
                    <form action="/login" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="redirect" value="<%= redirect || '/' %>">
                        <div class="form-group mb-3">
                            <label for="username">Username:</label>
                            <input type="text" class="form-control" id="username" name="username" required autofocus>
                        </div>
                        <div class="form-group mb-3">
                            <label for="password">Password:</label>
                            <input type="password" class="form-control" id="password" name="password" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Login</button>
                    </form>
                    <%# #1452: a forgotten password, reset with the recovery words. %>
                    <p class="text-center small mt-2 mb-0">
                        <a href="/recover-password">Forgot your password? Use your recovery words</a>
                    </p>
                    <% if (magicLinkEnabled) { %>
                    <hr>
                    <p class="text-center text-muted small mb-2">Or sign in without a password</p>
                    <% if (magic === 'sent') { %>
                        <div class="alert alert-success">
                            If that email is registered, a magic link has been sent. Check your inbox.
                        </div>
                    <% } else { %>
                        <form action="/auth/magic-link" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="redirect" value="<%= redirect || '/' %>">
                            <div class="input-group">
                                <input type="email" class="form-control" name="email"
                                       placeholder="your@email.com" required>
                                <button type="submit" class="btn btn-outline-secondary">Email me a link</button>
                            </div>
                        </form>
                    <% } %>
                    <% } %>
                    </section>
                    <% } %>
                    <% if (showPasskey) { %>
                    <%# #448: shown by passkey.js only where the browser supports passkeys. %>
                    <section class="d-none mb-4" aria-labelledby="signin-passkey-heading" data-signin-method="passkey" data-passkey-section>
                    <h2 class="h6" id="signin-passkey-heading">Passkey</h2>
                    <button type="button" class="btn btn-outline-primary w-100 d-none" data-passkey-signin
                            data-redirect="<%= redirect || '/' %>" data-error-target="passkey-error">
                        <i class="fas fa-key" aria-hidden="true"></i> Sign in with a passkey
                    </button>
                    <div id="passkey-error" class="alert alert-danger small mt-2 mb-0 d-none" role="alert"></div>
                    </section>
                    <script src="/js/passkey.js" defer></script>
                    <% } %>
                    <% if (outside.length > 0) { %>
                    <%# #1743: one button per enabled outside sign-in provider. %>
                    <section class="mb-4" aria-labelledby="signin-external-heading" data-signin-method="external">
                    <h2 class="h6" id="signin-external-heading">External provider</h2>
                    <% outside.forEach(function (p) { %>
                    <form action="/auth/oauth/<%= encodeURIComponent(p.name) %>" method="POST" class="mb-2">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="redirect" value="<%= redirect || '/' %>">
                        <%- include('_outside-provider-button', { provider: p, label: p.displayName, buttonClass: 'btn btn-light border w-100' }) %>
                    </form>
                    <% }) %>
                    </section>
                    <% } %>

                    <hr>
                    <div class="text-center">
                        <p class="mb-0"><a href="/">← Back to home</a></p>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
