<%# #1764 — "My tokens and devices": the signed-in person's agent tokens and the apps and
    devices they approved, as one list (AuthManager.listDelegations). Each row says how it
    is renewed, in plain words, and has one Revoke that goes through AuthManager's door.
    Locals: items (Delegation[]), csrfToken. "Can do" shows each scope's plain words (Delegation.can). %>
<%# Times go out as <time datetime data-local-time> with the UTC text as the fallback;
    /js/local-time.js (loaded by header.ejs) shows them in the viewer's own zone. %>
<%
  const utc = function (iso) { return iso.slice(0, 16).replace('T', ' ') + ' UTC'; };
  const typeOf = function (d) { return d.kind === 'token' ? 'Agent token' : (d.device ? 'Device' : 'App'); };
%>
<% if (items.length === 0) { %>
  <p class="text-muted small mb-0">You have no tokens, apps or devices.</p>
<% } else { %>
  <p class="small text-muted mb-2">
    <span class="badge bg-secondary">Fixed</span> stops working on its end date; you make a new one when you need it.
    <span class="badge bg-info text-dark ms-2">Refreshable</span> renews itself automatically, with a new key each time.
  </p>
  <div class="table-responsive">
    <table class="table table-sm align-middle mb-0">
      <thead><tr><th>Name</th><th>What it is</th><th>Kind</th><th>Can do</th><th>Ends or renewed</th><th></th></tr></thead>
      <tbody>
        <% items.forEach(function (d) { %>
        <tr data-delegation="<%= d.kind %>">
          <td><%= d.name %></td>
          <td class="small"><%= typeOf(d) %></td>
          <td>
            <% if (d.renewal === 'refreshable') { %><span class="badge bg-info text-dark">Refreshable</span>
            <% } else { %><span class="badge bg-secondary">Fixed</span><% } %>
          </td>
          <td class="small text-muted">
            <%# #1764: each permission in plain words (the catalog's label); the internal name only as a tooltip. %>
            <% (d.can || d.scopes.map(function (n) { return { name: n, description: n }; })).forEach(function (c, i) { %><%= i ? ', ' : '' %><span data-scope="<%= c.name %>" title="<%= c.name %>"><%= c.description %></span><% }) %>
          </td>
          <td class="small">
            <% if (d.renewal === 'refreshable') { %>
              <% if (d.renewedAt) { %>Last renewed <time datetime="<%= d.renewedAt %>" data-local-time><%= utc(d.renewedAt) %></time><% } else { %>Not renewed yet<% } %>
              <% if (d.expiresAt) { %><div class="text-muted">Ends <time datetime="<%= d.expiresAt %>" data-local-time><%= utc(d.expiresAt) %></time></div><% } %>
            <% } else { %>
              <% if (d.expiresAt) { %>Ends <time datetime="<%= d.expiresAt %>" data-local-time><%= utc(d.expiresAt) %></time><% } else { %>Ends when you revoke it<% } %>
            <% } %>
            <% if (d.kind === 'token') { %>
              <div class="text-muted"><% if (d.lastUsedAt) { %>Last used <time datetime="<%= d.lastUsedAt %>" data-local-time><%= utc(d.lastUsedAt) %></time><% } else { %>Never used<% } %></div>
            <% } %>
          </td>
          <td class="text-end">
            <%# The name rides in a data attribute, HTML-escaped — never built into a script string. %>
            <form action="/profile/tokens/<%= d.kind %>/<%= encodeURIComponent(d.id) %>/revoke" method="POST" class="d-inline"
                  data-confirm="<%= d.kind === 'token' ? 'Revoke ' + d.name + '? Anything using it stops working immediately.' : 'Revoke access for ' + d.name + '? It will need approving again.' %>"
                  onsubmit="return confirm(this.dataset.confirm)">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
