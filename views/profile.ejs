<%- include('header', { pageName: '' }) %>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card mt-4">
                <div class="card-header">
                    <h4><i class="fas fa-user"></i> User Profile</h4>
                </div>
                <div class="card-body">
                    <% if (error) { %>
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i> <%= error %>
                        </div>
                    <% } %>
                    
                    <% if (success) { %>
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i> <%= success %>
                        </div>
                    <% } %>
                    
                    <!-- User Information Display -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-account-information" open>
                                        <%- include('_card-summary', { icon: 'fa-info-circle', title: 'Account Information' }) %>
                                        <div class="mt-3">
                                    <p><strong>Username:</strong> <%= user.username %></p>
                                    <p><strong>Email:</strong> <%= user.email %></p>
                                    <p><strong>Display Name:</strong> <%= user.displayName %></p>
                                    <% if (user.profilePage) { %>
                                    <p><strong>Profile Page:</strong> <a href="/view/<%= encodeURIComponent(user.profilePage) %>"><%= user.profilePage %></a></p>
                                    <% } %>
                                    <p><strong>Account Type:</strong> 
                                        <% if (user.isExternal) { %>
                                            <span class="badge bg-info text-dark">Passwordless</span>
                                        <% } else { %>
                                            <span class="badge bg-primary">Local Account</span>
                                        <% } %>
                                    </p>
                                    <p><strong>Roles:</strong> 
                                        <% user.roles.forEach(role => { %>
                                            <span class="badge bg-secondary me-1"><%= role %></span>
                                        <% }) %>
                                    </p>
                                    <p><strong>Member Since:</strong> <%= new Date(user.createdAt).toLocaleDateString() %></p>
                                    <% if (user.lastLogin) { %>
                                        <p><strong>Last Login:</strong> <%= new Date(user.lastLogin).toLocaleString() %></p>
                                    <% } %>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-permissions" open>
                                        <%- include('_card-summary', { icon: 'fa-shield-alt', title: 'Permissions' }) %>
                                        <div class="mt-3" style="max-height: 200px; overflow-y: auto;">
                                    <% if (permissions && permissions.length > 0) { %>
                                        <%# #1539: a grant that applies only somewhere says where. %>
                                        <% permissions.forEach(grant => { %>
                                            <% const _p = typeof grant === 'string' ? { action: grant, limited: false, where: [] } : grant; %>
                                            <span class="badge <%= _p.limited ? 'bg-info text-dark' : 'bg-success' %> me-1 mb-1"<% if (_p.limited) { %> title="<%= _p.where.includes('vault') ? 'Only in your own vaults' : 'Only on some pages' %>"<% } %>><%= _p.action %><% if (_p.limited) { %> <small>(<%= _p.where.includes('vault') ? 'your vaults' : 'some pages' %>)</small><% } %></span>
                                        <% }) %>
                                    <% } else { %>
                                        <p class="text-muted">No specific permissions assigned</p>
                                    <% } %>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- #2073: the user's own contact details, from their identity record and account. -->
                    <% if (typeof contactDetails !== 'undefined') { %>
                    <%- include('_profile-contact-details', { contactDetails: contactDetails, contactDetailsSaved: typeof contactDetailsSaved !== 'undefined' ? contactDetailsSaved : null, contactDetailsError: typeof contactDetailsError !== 'undefined' ? contactDetailsError : null, pendingEmail: typeof pendingEmail !== 'undefined' ? pendingEmail : null, csrfToken: csrfToken }) %>
                    <% } %>

                    <!-- #640: My Contributions card -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-my-contributions" open>
                                        <%- include('_card-summary', { icon: 'fa-star', title: 'My Contributions' }) %>
                                        <div class="mt-3">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <a href="/my/vaults" class="text-decoration-none">
                                                <i class="fas fa-eye-slash"></i> Private Pages
                                            </a>
                                            <span class="badge bg-secondary">
                                                <%= typeof contributions !== 'undefined' && contributions && contributions['private'] !== undefined ? contributions['private'] : '–' %>
                                            </span>
                                        </li>
                                        <%# #1459: the owner's own private trash, beside their private pages.
                                            Never another user's, and an admin sees nothing extra here. %>
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <a href="/my/trash" class="text-decoration-none">
                                                <i class="fas fa-trash"></i> My Trash
                                            </a>
                                            <span class="badge bg-secondary">
                                                <%= typeof contributions !== 'undefined' && contributions && contributions.trash !== undefined ? contributions.trash : '–' %>
                                            </span>
                                        </li>
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <a href="/my/pages" class="text-decoration-none">
                                                <i class="fas fa-file-alt"></i> Pages I've Authored
                                            </a>
                                            <span class="badge bg-secondary">
                                                <%= typeof contributions !== 'undefined' && contributions && contributions.pages !== undefined ? contributions.pages : '–' %>
                                            </span>
                                        </li>
                                        <%# #1004: Captures row appears only when the capture feature is enabled.
                                            getMyContributionsCounts leaves `captures` undefined when it is off, so the
                                            absence of the count IS the feature gate — no separate flag to keep in sync. %>
                                        <% if (typeof contributions !== 'undefined' && contributions && contributions.captures !== undefined) { %>
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <a href="/my/captures" class="text-decoration-none">
                                                <i class="fas fa-bookmark"></i> My Captures
                                            </a>
                                            <span class="badge bg-secondary">
                                                <%= contributions.captures %>
                                            </span>
                                        </li>
                                        <% } %>
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <a href="/my/journal" class="text-decoration-none">
                                                <i class="fas fa-book"></i> Journal Entries
                                            </a>
                                            <span class="badge bg-secondary">
                                                <%= typeof contributions !== 'undefined' && contributions && contributions.journal !== undefined ? contributions.journal : '–' %>
                                            </span>
                                        </li>
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <a href="/my/links" class="text-decoration-none">
                                                <i class="fas fa-link"></i> My Links
                                            </a>
                                            <span class="badge bg-secondary">
                                                <%= typeof contributions !== 'undefined' && contributions && contributions.links !== undefined ? contributions.links : '–' %>
                                            </span>
                                        </li>
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <a href="/my/edits" class="text-decoration-none">
                                                <i class="fas fa-history"></i> Pages I've Edited
                                            </a>
                                            <span class="badge bg-secondary">
                                                <%= typeof contributions !== 'undefined' && contributions && contributions.edits !== undefined ? contributions.edits : '–' %>
                                            </span>
                                        </li>
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <a href="/my/shared" class="text-decoration-none">
                                                <i class="fas fa-share-alt"></i> Pages Shared With Me
                                            </a>
                                            <span class="badge bg-secondary">
                                                <%= typeof contributions !== 'undefined' && contributions && contributions.shared !== undefined ? contributions.shared : '–' %>
                                            </span>
                                        </li>
                                    </ul>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- #842: Share Links card — only for users who may create shares -->
                    <% if (typeof myShares !== 'undefined' && myShares) { %>
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-share-links" open>
                                        <%- include('_card-summary', { icon: 'fa-share-nodes', title: 'Share Links', helpSlug: 'share-links', helpLabel: 'Share Links' }) %>
                                        <div class="mt-3">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <a href="/shares" class="text-decoration-none">
                                                <i class="fas fa-share-nodes"></i> Manage My Share Links
                                            </a>
                                            <span>
                                                <span class="badge bg-success" title="Active"><%= myShares.active %> active</span>
                                                <span class="badge bg-secondary" title="Including revoked and expired"><%= myShares.total %> total</span>
                                            </span>
                                        </li>
                                    </ul>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- #1603: Your consents — what you accepted (core's terms, each add-on's), plus the
                         per-use permissions you gave, read from their owners (apps you approved, share links). -->
                    <% const yourConsents = typeof consents !== 'undefined' ? consents : null; %>
                    <% if (yourConsents) { %>
                    <div class="row mb-4" id="your-consents">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-your-consents" open>
                                        <%- include('_card-summary', { icon: 'fa-file-signature', title: 'Your consents', helpSlug: 'your-consents', helpLabel: 'Your consents' }) %>
                                        <div class="mt-3">
                                    <% if (yourConsents.length === 0) { %>
                                    <p class="text-muted small mb-2">This site asks you to accept no documents.</p>
                                    <% } %>
                                    <% yourConsents.forEach(function (group) { %>
                                    <h6 class="small text-muted text-uppercase mt-2"><%= group.scope === 'core' ? 'This site' : group.scope %></h6>
                                    <ul class="list-group list-group-flush mb-2">
                                        <% group.statuses.forEach(function (st) { %>
                                        <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between" data-consent-status="<%= st.document.id %>" data-consent-accepted="<%= st.current ? 'yes' : 'no' %>">
                                            <span>
                                                <a href="/view/<%= encodeURIComponent(st.document.id) %>"><%= st.document.title %></a>
                                                <small class="text-muted ms-1">version <%= st.document.version %><% if (st.document.effective) { %>, in effect from <%= st.document.effective %><% } %></small>
                                            </span>
                                            <% if (st.current) { %>
                                            <span class="badge bg-success">Accepted <time datetime="<%= st.current.acceptedAt %>" data-local-time><%= st.current.acceptedAt.slice(0, 16).replace('T', ' ') %> UTC</time></span>
                                            <% } else if (st.latest) { %>
                                            <span class="badge bg-warning text-dark">Changed since you accepted version <%= st.latest.version %>: you will be asked again</span>
                                            <% } else { %>
                                            <span class="badge bg-secondary">Not accepted yet</span>
                                            <% } %>
                                        </li>
                                        <% }) %>
                                    </ul>
                                    <% }) %>
                                    <% const apps = typeof approvedApps !== 'undefined' && approvedApps ? approvedApps : []; %>
                                    <% if (apps.length > 0 || (typeof myShares !== 'undefined' && myShares)) { %>
                                    <h6 class="small text-muted text-uppercase mt-3">Permissions you gave</h6>
                                    <ul class="list-group list-group-flush">
                                        <% apps.forEach(function (a) { %>
                                        <li class="list-group-item small" data-consent-app="<%= a.grantId %>">App or device <strong><%= a.name %></strong> may see <%= a.scopes.join(', ') %><% if (a.approvedAt) { %>, approved <time datetime="<%= a.approvedAt %>" data-local-time><%= a.approvedAt.slice(0, 16).replace('T', ' ') %> UTC</time><% } %> <span class="text-muted">(revoke it under My tokens and devices)</span></li>
                                        <% }) %>
                                        <% if (typeof myShares !== 'undefined' && myShares) { %>
                                        <li class="list-group-item small">Share links: <%= myShares.active %> active <a href="/shares" class="ms-1">Manage</a></li>
                                        <% } %>
                                    </ul>
                                    <% } %>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- #1842: your vault pages whose files, footnotes or comments are still outside the vault -->
                    <% const ownRepairs = typeof vaultRepairs !== 'undefined' ? vaultRepairs : []; %>
                    <% const repairNotice = typeof vaultRepairNotice !== 'undefined' ? vaultRepairNotice : null; %>
                    <% const repairError = typeof vaultRepairError !== 'undefined' ? vaultRepairError : null; %>
                    <% if (ownRepairs.length > 0 || repairNotice || repairError) { %>
                    <div class="row mb-4" id="vault-repairs">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-vault-repairs" open>
                                        <%- include('_card-summary', { icon: 'fa-lock-open', title: 'Vault pages with data outside their vault' }) %>
                                        <div class="mt-3">
                                    <% if (repairNotice) { %><div class="alert alert-success small"><%= repairNotice %></div><% } %>
                                    <% if (repairError) { %><div class="alert alert-danger small"><%= repairError %></div><% } %>
                                    <% if (ownRepairs.length > 0) { %>
                                    <p class="small text-muted">Saved before your vaults kept everything of a page inside them, these are still outside: files in the shared pool, where anyone allowed to see attachments can open them, or footnotes and comments stored unencrypted. "Move into vault" moves them in, sealed when the vault is. A file another public page uses is copied, and stays for that page.</p>
                                    <ul class="list-group list-group-flush">
                                        <% ownRepairs.forEach(function (r) { %>
                                            <li class="list-group-item d-flex align-items-center justify-content-between">
                                                <span>
                                                    <i class="fas fa-lock"></i> <%= r.vault %> &middot;
                                                    <% if (r.page) { %>page <code><%= r.page %></code><% } else { %>pages its shared files name<% } %>
                                                    <small class="text-muted ms-2"><%= [r.files ? r.files + ' file(s)' : null, r.footnotes ? 'footnotes' : null, r.comments ? 'comments' : null].filter(Boolean).join(', ') %></small>
                                                    <%- include('_vault-repair-pages', { repair: r }) %>
                                                </span>
                                                <% if (r.may) { %>
                                                    <form method="POST" action="/vault-repair" class="d-inline">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <input type="hidden" name="return" value="profile">
                                                        <input type="hidden" name="owner" value="<%= r.owner %>">
                                                        <input type="hidden" name="vault" value="<%= r.vault %>">
                                                        <input type="hidden" name="page" value="<%= r.page || '' %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-primary">Move into vault</button>
                                                    </form>
                                                <% } else { %>
                                                    <small class="text-muted"><%= r.refusal %></small>
                                                <% } %>
                                            </li>
                                        <% }); %>
                                    </ul>
                                    <% if (ownRepairs.some(function (r) { return r.may; })) { %>
                                    <form method="POST" action="/vault-repair/all" class="mt-2">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="return" value="profile">
                                        <button type="submit" class="btn btn-sm btn-primary">Move all into my vaults</button>
                                    </form>
                                    <% } %>
                                    <% } %>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- #1517: files in your own vaults that no page there uses -->
                    <% if (typeof unusedVaultFiles !== 'undefined' && unusedVaultFiles.length > 0) { %>
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-unused-vault-files" open>
                                        <%- include('_card-summary', { icon: 'fa-box-open', title: 'Unused files in your vaults' }) %>
                                        <div class="mt-3">
                                    <p class="small text-muted">Files in your vaults that no page in that vault uses — for example a copy left behind when a page moved to another vault. Only you see this.</p>
                                    <% unusedVaultFiles.forEach(function(v) { %>
                                        <h6 class="mt-3"><i class="fas fa-lock"></i> <%= v.vault %></h6>
                                        <% if (v.locked) { %>
                                            <p class="small text-muted mb-0">This vault is locked. Sign in with your password to see its files.</p>
                                        <% } else { %>
                                            <ul class="list-group list-group-flush">
                                                <% v.files.forEach(function(f) { %>
                                                    <li class="list-group-item d-flex align-items-center justify-content-between" data-unused-file="<%= f.id %>">
                                                        <span>
                                                            <a href="/attachments/<%= encodeURIComponent(f.id) %>" target="_blank" rel="noopener"><%= f.name %></a>
                                                            <small class="text-muted ms-2"><%= (f.contentSize / 1024).toFixed(0) %> KB · added <%= new Date(f.dateCreated).toLocaleDateString() %></small>
                                                        </span>
                                                        <% if (v.canDelete) { %>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" data-delete-unused="<%= f.id %>" data-name="<%= f.name %>"><i class="fas fa-trash"></i> Delete</button>
                                                        <% } %>
                                                    </li>
                                                <% }); %>
                                            </ul>
                                        <% } %>
                                    <% }); %>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- #448 / #1524: Sign-in methods — the password and every credential -->
                    <% const signInWithPassword = typeof hasPassword !== 'undefined' && hasPassword; %>
                    <%# #1743: outside identities are listed on their own rows, with the provider's email and Disconnect. %>
                    <% const ownCredentials = typeof credentials !== 'undefined' ? credentials.filter(function (c) { return c.kind !== 'identity'; }) : []; %>
                    <% const identities = typeof connectedIdentities !== 'undefined' ? connectedIdentities : []; %>
                    <% const connectable = typeof connectableProviders !== 'undefined' ? connectableProviders : []; %>
                    <% if ((typeof passkeyHost !== 'undefined' && passkeyHost) || (typeof totpEnrolable !== 'undefined' && totpEnrolable) || signInWithPassword || ownCredentials.length > 0 || identities.length > 0 || connectable.length > 0 || (typeof credentialsUnavailable !== 'undefined' && credentialsUnavailable)) { %>
                    <div class="row mb-4" id="sign-in-methods">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-sign-in-methods" open>
                                        <%- include('_card-summary', { icon: 'fa-key', title: 'Sign-in methods' }) %>
                                        <div class="mt-3">
                                    <% if (typeof credentialsUnavailable !== 'undefined' && credentialsUnavailable) { %>
                                    <%# #1738: never show a list that could not be read as an empty one. %>
                                    <div class="alert alert-warning small" role="alert">Your passkeys and other sign-in methods could not be loaded just now. They have not been removed. Reload the page; if this keeps happening, sign out and back in.</div>
                                    <% } %>
                                    <% if (signInWithPassword || ownCredentials.length > 0 || identities.length > 0) { %>
                                    <table class="table table-sm align-middle mb-3">
                                        <thead><tr><th>Name</th><th>Kind</th><th>Added</th><th>Last used</th><th></th></tr></thead>
                                        <tbody>
                                            <% if (signInWithPassword) { %>
                                            <tr>
                                                <td>Password</td>
                                                <td>password</td>
                                                <td class="small text-muted"></td>
                                                <td class="small text-muted"></td>
                                                <td class="text-end"><a href="#change-password" class="btn btn-sm btn-outline-secondary">Change</a></td>
                                            </tr>
                                            <% } %>
                                            <% ownCredentials.forEach(function (c) { %>
                                            <tr>
                                                <td>
                                                    <form action="/profile/credentials/<%= encodeURIComponent(c.id) %>/rename" method="POST" class="input-group input-group-sm" style="max-width: 18rem;">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <input type="text" name="label" class="form-control" value="<%= c.label %>" maxlength="60" required aria-label="Name">
                                                        <button type="submit" class="btn btn-outline-secondary">Rename</button>
                                                    </form>
                                                </td>
                                                <td><%= c.kind %></td>
                                                <td class="small text-muted"><%= (c.createdAt || '').slice(0, 16).replace('T', ' ') %> UTC</td>
                                                <td class="small text-muted"><%= c.lastUsedAt ? c.lastUsedAt.slice(0, 16).replace('T', ' ') + ' UTC' : 'never' %></td>
                                                <td class="text-end">
                                                    <form action="/profile/credentials/<%= encodeURIComponent(c.id) %>/remove" method="POST" class="d-inline">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }) %>
                                            <% identities.forEach(function (i) { %>
                                            <tr>
                                                <td>
                                                    <%= i.label %><% if (i.email) { %> <span class="small text-muted">(<%= i.email %>)</span><% } %>
                                                    <% if (!i.provider) { %><div class="small text-muted">This provider is turned off here, so it cannot sign you in for now.</div><% } %>
                                                </td>
                                                <td>outside sign-in</td>
                                                <td class="small text-muted"><%= (i.createdAt || '').slice(0, 16).replace('T', ' ') %> UTC</td>
                                                <td class="small text-muted"><%= i.lastUsedAt ? i.lastUsedAt.slice(0, 16).replace('T', ' ') + ' UTC' : 'never' %></td>
                                                <td class="text-end">
                                                    <form action="/profile/credentials/<%= encodeURIComponent(i.id) %>/remove" method="POST" class="d-inline">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Disconnect</button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                    <% } else { %>
                                    <% if (!(typeof credentialsUnavailable !== 'undefined' && credentialsUnavailable)) { %>
                                    <p class="text-muted small">No sign-in methods are set up for this account here.</p>
                                    <% } %>
                                    <% } %>
                                    <% if (connectable.length > 0) { %>
                                    <p class="small text-muted mb-1">Connect an account you have elsewhere, then use it to sign in here.</p>
                                    <div class="mb-3">
                                        <% connectable.forEach(function (p) { %>
                                        <form method="POST" action="/auth/oauth/<%= encodeURIComponent(p.name) %>/connect" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <%- include('_outside-provider-button', { provider: p, label: 'Connect ' + p.displayName, buttonClass: 'btn btn-sm btn-outline-primary' }) %>
                                        </form>
                                        <% }) %>
                                    </div>
                                    <% } %>
                                    <% if (typeof offerEmailSecondFactor !== 'undefined' && offerEmailSecondFactor) { %>
                                    <%# #1523: a second factor for password sign-ins — the email approves each one. %>
                                    <form method="POST" action="/profile/second-factor/email" class="mb-3">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <p class="small text-muted mb-1">Make every password sign-in wait for your approval by email. We send a link to confirm the address first.</p>
                                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-envelope"></i> Approve my sign-ins by email</button>
                                    </form>
                                    <% } %>
                                    <% if (typeof passkeyHost !== 'undefined' && passkeyHost) { %>
                                    <p class="small text-muted mb-2">
                                        A passkey signs you in with your device's fingerprint, face or PIN, with no password. It works only on <strong><%= passkeyHost %></strong>.
                                    </p>
                                    <div class="input-group input-group-sm" style="max-width: 28rem;">
                                        <input type="text" class="form-control" id="passkey-label" maxlength="60" required aria-label="Name for the new passkey" placeholder="Name it, e.g. Chrome on Mac">
                                        <button type="button" class="btn btn-primary d-none" data-passkey-enrol data-label-input="passkey-label" data-error-target="passkey-enrol-error">
                                            <i class="fas fa-plus"></i> Add a passkey
                                        </button>
                                    </div>
                                    <div id="passkey-enrol-error" class="alert alert-danger small mt-2 mb-0 d-none" role="alert"></div>
                                    <script src="/js/passkey.js" defer></script>
                                    <% } %>
                                    <% if (typeof totpEnrolable !== 'undefined' && totpEnrolable) { %>
                                    <p class="small text-muted mb-2 mt-3">
                                        An authenticator app (Google Authenticator, 1Password, Aegis and others) gives a six-digit code that changes every 30 seconds.
                                    </p>
                                    <a class="btn btn-sm btn-outline-primary" href="/profile/totp"><i class="fas fa-mobile-alt"></i> Add an authenticator app</a>
                                    <% } %>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- #1764: My tokens and devices — agent tokens (#946) and the apps and devices
                         approved through this site's own sign-in server (#1601), as one list -->
                    <% if (typeof delegations !== 'undefined') { %>
                    <% const mayMint = typeof agentTokensEnabled !== 'undefined' && agentTokensEnabled; %>
                    <div class="row mb-4" id="tokens-and-devices">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-tokens-and-devices" open>
                                        <%- include('_card-summary', { icon: 'fa-key', title: 'My tokens and devices' }) %>
                                        <div class="mt-3">
                                    <% if (mayMint) { %>
                                    <button type="button" class="btn btn-sm btn-primary mb-2" id="agent-token-new-btn">
                                        <i class="fas fa-plus"></i> New token
                                    </button>
                                    <% } %>
                                    <p class="text-muted small">
                                        Everything you have let act for you: tokens you made for programs, and apps and
                                        devices you approved. None can do anything you cannot already do, and each stops
                                        working the moment you revoke it.
                                    </p>
                                    <% if (mayMint) { %>

                                    <!-- Mint form — hidden until "New token" is pressed -->
                                    <form id="agent-token-form" class="border rounded p-3 mb-3 d-none">
                                        <div class="row g-2 align-items-end">
                                            <div class="col-md-4">
                                                <label class="form-label small mb-1" for="agent-token-name">Name</label>
                                                <input type="text" class="form-control form-control-sm" id="agent-token-name"
                                                       placeholder="claude-laptop" required>
                                                <div class="form-text">So you recognise it later.</div>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small mb-1" for="agent-token-scopes">Permissions</label>
                                                <select class="form-select form-select-sm" id="agent-token-scopes">
                                                    <option value="page-read">Read only</option>
                                                    <option value="page-ingest" selected>Create and edit pages</option>
                                                    <option value="page-ingest,page-rename">Create, edit and rename</option>
                                                    <option value="page-ingest,page-rename,page-delete">Create, edit, rename and delete</option>
                                                </select>
                                                <div class="form-text">
                                                    A token can never exceed your own permissions.
                                                    Deleted pages stay recoverable from the trash.
                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small mb-1" for="agent-token-ttl">Hours</label>
                                                <input type="number" class="form-control form-control-sm" id="agent-token-ttl"
                                                       value="24" min="1" max="24">
                                            </div>
                                            <div class="col-md-2 d-grid">
                                                <button type="submit" class="btn btn-sm btn-success" id="agent-token-create-btn">Create</button>
                                            </div>
                                        </div>
                                        <div class="alert alert-danger mt-2 mb-0 py-2 small d-none" id="agent-token-error"></div>
                                    </form>

                                    <!-- One-time secret display -->
                                    <div class="alert alert-warning d-none" id="agent-token-result">
                                        <div class="fw-bold mb-1">
                                            <i class="fas fa-triangle-exclamation"></i>
                                            Copy this now — it cannot be shown again.
                                        </div>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control font-monospace" id="agent-token-secret" readonly>
                                            <button class="btn btn-outline-secondary" type="button" id="agent-token-copy-btn">
                                                <i class="fas fa-copy"></i> Copy
                                            </button>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-primary mt-2" id="agent-token-done-btn">Done — I have copied it</button>
                                    </div>
                                    <% } %>

                                    <% if (delegations === null) { %>
                                    <p class="text-danger small mb-0">Your tokens and devices could not be read just now. Nothing has been removed; reload the page to try again.</p>
                                    <% } else { %>
                                    <%- include('_delegations', { items: delegations, csrfToken: csrfToken, canExtend: typeof agentTokensCanExtend !== 'undefined' && agentTokensCanExtend === true }) %>
                                    <% } %>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- #1762 slice 7: Proxy access — who may act for me, and whom I may act for.
                         Hidden while proxy access is off (proxyAccess undefined). -->
                    <% if (typeof proxyAccess !== 'undefined' && proxyAccess) { %>
                    <div class="row mb-4" id="proxy-access">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-proxy-access" open>
                                        <%- include('_card-summary', { icon: 'fa-user-friends', title: 'Proxy access' }) %>
                                        <div class="mt-3">
                                    <% if (proxyAccess.given !== null) { %>
                                    <p class="text-muted small">
                                        Let someone you trust, such as a family member or a caregiver, act for you on this site.
                                        They can only do what you tick, never more than you can do yourself, and everything they
                                        do is recorded as done by them for you. You can revoke their access at any time.
                                    </p>
                                    <%- include('_proxy-grants', { grants: proxyAccess.given, owner: proxyAccess.owner, revokeBase: '/profile/proxy-access/', csrfToken: csrfToken, self: true }) %>
                                    <% if (proxyAccess.options !== null) { %>
                                    <div class="mt-3">
                                        <%- include('_proxy-grant-form', { action: '/profile/proxy-access', options: proxyAccess.options, owner: proxyAccess.owner, self: true, csrfToken: csrfToken, vaultBlocked: proxyAccess.vaultBlocked }) %>
                                    </div>
                                    <% } %>
                                    <% } %>
                                    <% if (proxyAccess.actingFor.length > 0) { %>
                                    <div class="<%= proxyAccess.given !== null ? 'mt-3' : '' %>" data-proxy-acting-for>
                                        <h6 class="small fw-semibold mb-1">You can act for</h6>
                                        <ul class="small mb-1">
                                            <% proxyAccess.actingFor.forEach(function (g) { %>
                                            <li><%= g.owner %></li>
                                            <% }) %>
                                        </ul>
                                        <a class="btn btn-sm btn-outline-primary" href="/account/acting-for">Choose whom to act for</a>
                                    </div>
                                    <% } %>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>
                    <script src="/js/audience-typeahead.js" defer></script>
                    <script src="/js/proxy-access.js" defer></script>
                    <% } %>

                    <!-- User Preferences Section -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <details id="profile-user-preferences" open>
                                        <%- include('_card-summary', { icon: 'fa-cogs', title: 'User Preferences' }) %>
                                        <div class="mt-3">
                                    <form action="/preferences" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <h6><i class="fas fa-edit"></i> Editor Settings</h6>
                                                
                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="smartPairs" name="editor.plain.smartpairs" 
                                                           <%= (user.preferences && user.preferences['editor.plain.smartpairs']) ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="smartPairs">
                                                        <strong>Smart Typing Pairs</strong>
                                                        <br><small class="text-muted">Auto pairing of () [] {} &lt;&gt; "" ''</small>
                                                    </label>
                                                </div>
                                                
                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="autoIndent" name="editor.autoindent" 
                                                           <%= (user.preferences && user.preferences['editor.autoindent']) ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="autoIndent">
                                                        <strong>Auto Indent</strong>
                                                        <br><small class="text-muted">Automatically indent new lines</small>
                                                    </label>
                                                </div>
                                                
                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="lineNumbers" name="editor.linenumbers" 
                                                           <%= (user.preferences && user.preferences['editor.linenumbers']) ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="lineNumbers">
                                                        <strong>Show Line Numbers</strong>
                                                        <br><small class="text-muted">Display line numbers in editor</small>
                                                    </label>
                                                </div>
                                                
                                                <div class="form-group mb-3">
                                                    <label for="editorTheme" class="form-label"><strong>Code Editor Style</strong></label>
                                                    <select class="form-control" id="editorTheme" name="editor.theme">
                                                        <option value="default" <%= (user.preferences && user.preferences['editor.theme'] === 'default') ? 'selected' : '' %>>Default</option>
                                                        <option value="dark" <%= (user.preferences && user.preferences['editor.theme'] === 'dark') ? 'selected' : '' %>>Dark</option>
                                                        <option value="monokai" <%= (user.preferences && user.preferences['editor.theme'] === 'monokai') ? 'selected' : '' %>>Monokai</option>
                                                        <option value="solarized" <%= (user.preferences && user.preferences['editor.theme'] === 'solarized') ? 'selected' : '' %>>Solarized</option>
                                                    </select>
                                                    <small class="form-text text-muted">Color style for the page editor textarea only — separate from the site light/dark mode</small>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-6">
                                                <h6><i class="fas fa-eye"></i> Display Settings</h6>
                                                
                                                <div class="form-group mb-3">
                                                    <label for="pageSize" class="form-label"><strong>Pages Per List</strong></label>
                                                    <select class="form-control" id="pageSize" name="display.pagesize">
                                                        <option value="10" <%= (user.preferences && user.preferences['display.pagesize'] === '10') ? 'selected' : '' %>>10</option>
                                                        <option value="25" <%= (user.preferences && user.preferences['display.pagesize'] === '25') ? 'selected' : '' %>>25</option>
                                                        <option value="50" <%= (user.preferences && user.preferences['display.pagesize'] === '50') ? 'selected' : '' %>>50</option>
                                                        <option value="100" <%= (user.preferences && user.preferences['display.pagesize'] === '100') ? 'selected' : '' %>>100</option>
                                                    </select>
                                                </div>
                                                
                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="showToolTips" name="display.tooltips" 
                                                           <%= (user.preferences && user.preferences['display.tooltips']) ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="showToolTips">
                                                        <strong>Show Tooltips</strong>
                                                        <br><small class="text-muted">Display helpful tooltips on hover</small>
                                                    </label>
                                                </div>
                                                
                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="readerMode" name="display.readermode"
                                                           <%= (user.preferences && user.preferences['display.readermode']) ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="readerMode">
                                                        <strong>Default Reader Mode</strong>
                                                        <br><small class="text-muted">Open pages in reader mode by default</small>
                                                    </label>
                                                </div>

                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="sectionEditing" name="display.sectionEditing"
                                                           <%= (user.preferences && user.preferences['display.sectionEditing']) ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="sectionEditing">
                                                        <strong>Section Editing</strong>
                                                        <br><small class="text-muted">Show a pencil icon on each heading to edit that section only</small>
                                                    </label>
                                                </div>

                                                <% if (typeof captureStartsPrivate === 'boolean') { %>
                                                <div class="form-check mb-3">
                                                    <input class="form-check-input" type="checkbox" id="captureDefaultPrivate" name="capture.defaultPrivate"
                                                           <%= captureStartsPrivate ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="captureDefaultPrivate">
                                                        <strong>Start new captures private</strong>
                                                        <br><small class="text-muted">Pages the capture bookmarklet creates start private; you can still change each one</small>
                                                    </label>
                                                </div>
                                                <% } %>

                                                <h6><i class="fas fa-globe"></i> Localization & Date/Time</h6>

                                                <div class="form-group mb-3">
                                                    <label for="locale" class="form-label"><strong>Locale</strong></label>
                                                    <select class="form-control" id="locale" name="preferences.locale">
                                                        <option value="en-US" <%= (user.preferences && user.preferences.locale === 'en-US') ? 'selected' : '' %>>English (United States)</option>
                                                        <option value="en-GB" <%= (user.preferences && user.preferences.locale === 'en-GB') ? 'selected' : '' %>>English (United Kingdom)</option>
                                                        <option value="fr-FR" <%= (user.preferences && user.preferences.locale === 'fr-FR') ? 'selected' : '' %>>Français (France)</option>
                                                        <option value="de-DE" <%= (user.preferences && user.preferences.locale === 'de-DE') ? 'selected' : '' %>>Deutsch (Deutschland)</option>
                                                        <option value="es-ES" <%= (user.preferences && user.preferences.locale === 'es-ES') ? 'selected' : '' %>>Español (España)</option>
                                                        <option value="it-IT" <%= (user.preferences && user.preferences.locale === 'it-IT') ? 'selected' : '' %>>Italiano (Italia)</option>
                                                        <option value="pt-BR" <%= (user.preferences && user.preferences.locale === 'pt-BR') ? 'selected' : '' %>>Português (Brasil)</option>
                                                        <option value="ja-JP" <%= (user.preferences && user.preferences.locale === 'ja-JP') ? 'selected' : '' %>>日本語 (日本)</option>
                                                        <option value="ko-KR" <%= (user.preferences && user.preferences.locale === 'ko-KR') ? 'selected' : '' %>>한국어 (대한민국)</option>
                                                        <option value="zh-CN" <%= (user.preferences && user.preferences.locale === 'zh-CN') ? 'selected' : '' %>>中文 (中国)</option>
                                                        <option value="ru-RU" <%= (user.preferences && user.preferences.locale === 'ru-RU') ? 'selected' : '' %>>Русский (Россия)</option>
                                                        <option value="ar-SA" <%= (user.preferences && user.preferences.locale === 'ar-SA') ? 'selected' : '' %>>العربية (السعودية)</option>
                                                        <option value="hi-IN" <%= (user.preferences && user.preferences.locale === 'hi-IN') ? 'selected' : '' %>>हिन्दी (भारत)</option>
                                                    </select>
                                                    <small class="form-text text-muted">Determines date, time, and number formatting</small>
                                                </div>

                                                <div class="form-group mb-3">
                                                    <label class="form-label"><strong>Time Format</strong></label>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="preferences.timeFormat" id="timeFormat12" value="12h"
                                                               <%= (!user.preferences || !user.preferences.timeFormat || user.preferences.timeFormat === '12h') ? 'checked' : '' %>>
                                                        <label class="form-check-label" for="timeFormat12">
                                                            12-hour (2:30 PM)
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="preferences.timeFormat" id="timeFormat24" value="24h"
                                                               <%= (user.preferences && user.preferences.timeFormat === '24h') ? 'checked' : '' %>>
                                                        <label class="form-check-label" for="timeFormat24">
                                                            24-hour (14:30)
                                                        </label>
                                                    </div>
                                                </div>

                                                <div class="form-group mb-3">
                                                    <label for="timezone" class="form-label"><strong>Timezone</strong></label>
                                                    <select class="form-control" id="timezone" name="preferences.timezone">
                                                        <% if (availableTimezones && availableTimezones.length > 0) { %>
                                                            <% let currentCategory = ''; %>
                                                            <% availableTimezones.forEach(tz => { %>
                                                                <% if (currentCategory !== tz.category) { %>
                                                                    <% if (currentCategory !== '') { %></optgroup><% } %>
                                                                    <% currentCategory = tz.category; %>
                                                                    <optgroup label="<%= tz.category %>">
                                                                <% } %>
                                                                <option value="<%= tz.value %>" <%= (user.preferences && user.preferences.timezone === tz.value) || (!user.preferences?.timezone && tz.value === 'UTC') ? 'selected' : '' %>><%= tz.label %></option>
                                                            <% }); %>
                                                            <% if (currentCategory !== '') { %></optgroup><% } %>
                                                        <% } else { %>
                                                            <option value="UTC" <%= (!user.preferences || !user.preferences.timezone || user.preferences.timezone === 'UTC') ? 'selected' : '' %>>UTC (Coordinated Universal Time)</option>
                                                        <% } %>
                                                    </select>
                                                </div>

                                                <div class="form-group mb-3">
                                                    <label for="dateFormat" class="form-label"><strong>Date Format</strong></label>
                                                    <select class="form-control" id="dateFormat" name="preferences.dateFormat">
                                                        <% if (availableDateFormats && availableDateFormats.length > 0) { %>
                                                            <% availableDateFormats.forEach(fmt => { %>
                                                                <%
                                                                const currentFormat = user.preferences?.dateFormat || 'MM/dd/yyyy';
                                                                const isSelected = (fmt.value === 'auto' && !user.preferences?.dateFormat) ||
                                                                                 (fmt.value !== 'auto' && currentFormat === fmt.value);
                                                                %>
                                                                <option value="<%= fmt.value %>" <%= isSelected ? 'selected' : '' %> data-description="<%= fmt.description %>">
                                                                    <%= fmt.label %>
                                                                </option>
                                                            <% }); %>
                                                        <% } %>
                                                    </select>
                                                    <small class="form-text text-muted">Choose a specific format or use Auto to follow your locale setting</small>
                                                </div>

                                                <div class="card bg-info bg-opacity-10 border-info">
                                                    <div class="card-body p-2">
                                                        <h6 class="card-title mb-1"><i class="fas fa-eye"></i> Live Preview</h6>
                                                        <div class="row">
                                                            <div class="col-6">
                                                                <small class="text-muted">Date:</small><br>
                                                                <span id="datePreview" class="fw-bold">Loading...</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted">Time:</small><br>
                                                                <span id="timePreview" class="fw-bold">Loading...</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <div class="form-group mb-3">
                                                    <label for="siteTheme" class="form-label"><strong>Light / Dark Mode</strong></label>
                                                    <select class="form-control" id="siteTheme" name="display.theme">
                                                        <option value="system" <%= (user.preferences && user.preferences['display.theme'] === 'system') ? 'selected' : '' %>>System Preference</option>
                                                        <option value="light" <%= (user.preferences && user.preferences['display.theme'] === 'light') ? 'selected' : '' %>>Light</option>
                                                        <option value="dark" <%= (user.preferences && user.preferences['display.theme'] === 'dark') ? 'selected' : '' %>>Dark</option>
                                                    </select>
                                                    <small class="form-text text-muted">Also controlled by the <i class="fas fa-adjust"></i> icon in the top navigation bar</small>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <hr>
                                        
                                        <%# ── Addon-contributed profile sections (#534) ─────────────── %>
                                        <%# Rendered inside the preferences form so the addon's input fields  %>
                                        <%# submit with the existing POST /preferences and reach each addon's %>
                                        <%# saveProfileSection() handler. Sections render in registration order. %>
                                        <% if (addonProfileSections && addonProfileSections.length > 0) { %>
                                            <% addonProfileSections.forEach(function(section) { %>
                                                <%# #1541: core draws each section's card and header, so every add-on's section collapses like the rest. %>
                                                <div class="card mt-4" data-addon="<%= section.addonName %>">
                                                    <div class="card-body py-2">
                                                    <details id="profile-addon-<%= section.addonName %>" open>
                                                    <%- include('_card-summary', { icon: section.icon || 'fa-puzzle-piece', title: section.title, hint: section.hint }) %>
                                                    <div class="mt-3"><%- section.html %>
                                                        <%# #1603: what this add-on asks you to accept before it turns on, recorded before its switch flips. %>
                                                        <% const asks = (typeof addonConsentPending !== 'undefined' && addonConsentPending[section.addonName]) || []; %>
                                                        <% if (asks.length > 0) { %>
                                                        <div class="border-top mt-3 pt-2" data-addon-consent="<%= section.addonName %>">
                                                            <% asks.forEach(function (d) { %>
                                                            <input type="hidden" name="consent.<%= section.addonName %>.document" value="<%= d.id %>">
                                                            <input type="hidden" name="consent.<%= section.addonName %>.version" value="<%= d.version %>">
                                                            <% }) %>
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="consent.<%= section.addonName %>.accept" id="consent-<%= section.addonName %>-accept">
                                                                <label class="form-check-label small" for="consent-<%= section.addonName %>-accept">
                                                                    To use <%= section.title %>, I have read and accept its
                                                                    <% asks.forEach(function (d, i) { %><%= i > 0 ? ' and ' : '' %><a href="/view/<%= encodeURIComponent(d.id) %>" target="_blank" rel="noopener"><%= d.title %></a> (version <%= d.version %>)<% }) %>
                                                                </label>
                                                            </div>
                                                        </div>
                                                        <% } %>
                                                    </div>
                                                    </details>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        <% } %>

                                        <div class="d-flex justify-content-between mt-4">
                                            <button type="submit" class="btn btn-success">
                                                <i class="fas fa-save"></i> Save Preferences
                                            </button>

                                            <button type="button" class="btn btn-outline-secondary" onclick="resetPreferences()">
                                                <i class="fas fa-undo"></i> Reset to Defaults
                                            </button>
                                        </div>
                                    </form>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Profile Update Form -->
                    <form action="/profile" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="row">
                            <div class="col-md-6">
                                <h5><i class="fas fa-edit"></i> Update Profile</h5>
                                
                                <%# #2073: the name and email are changed under Contact details. %>
                                <p class="text-muted small">Change your name and email under <a href="#contact-details">Contact details</a>.</p>

                                <input type="hidden" name="originalProfilePage" value="<%= user.profilePage || '' %>">

                                <div class="form-group mb-3">
                                    <label for="profilePage">Profile Page:</label>
                                    <input type="text" class="form-control" id="profilePage" name="profilePage"
                                           value="<%= user.profilePage || '' %>"
                                           placeholder="e.g. Jim Willeke">
                                    <small class="form-text text-muted">Wiki page name for your profile (leave blank to unset)</small>
                                </div>

                                <div id="renameProfilePageSection" class="form-check mb-3" style="display:none;">
                                    <input class="form-check-input" type="checkbox" id="renameProfilePage" name="renameProfilePage">
                                    <label class="form-check-label" for="renameProfilePage">
                                        <strong>Also rename wiki page</strong>
                                        <br><small class="text-muted">Rename "<span id="renameFrom"></span>" to "<span id="renameTo"></span>"</small>
                                    </label>
                                </div>
                            </div>
                            
                            <!-- Password Change Section - Only for Local Users -->
                            <% if (!user.isExternal) { %>
                            <div class="col-md-6" id="change-password">
                                <h5><i class="fas fa-key"></i> Change Password</h5>
                                <p class="text-muted small">Leave blank to keep current password</p>
                                
                                <div class="form-group mb-3">
                                    <label for="currentPassword">Current Password:</label>
                                    <input type="password" class="form-control" id="currentPassword" name="currentPassword"
                                           placeholder="Enter current password">
                                </div>
                                
                                <div class="form-group mb-3">
                                    <label for="newPassword">New Password:</label>
                                    <input type="password" class="form-control" id="newPassword" name="newPassword"
                                           placeholder="Enter new password" minlength="6">
                                </div>
                                
                                <div class="form-group mb-3">
                                    <label for="confirmPassword">Confirm New Password:</label>
                                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                                           placeholder="Confirm new password">
                                </div>
                            </div>
                            <% } else { %>
                            <div class="col-md-6">
                                <%# #1026: isExternal covers every passwordless account, not just
                                    OAuth — magic-link signups are external too, and telling those
                                    users to go change a password at "their OAuth provider" names a
                                    provider that does not exist. Wording now describes the account
                                    accurately without asserting how it was created. %>
                                <div class="alert alert-info">
                                    <h5><i class="fas fa-info-circle"></i> Passwordless account</h5>
                                    <p class="mb-0">This account has no password. You sign in with an email
                                    sign-in link, or through an external identity provider — so there is
                                    nothing to change here.</p>
                                </div>
                            </div>
                            <% } %>
                        </div>
                        
                        <hr>
                        
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Update Profile
                            </button>

                            <a href="/" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to Wiki
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script nonce="<%= locals.cspNonce %>">
// Profile page rename prompt
(function() {
    const profilePageInput = document.getElementById('profilePage');
    const originalProfilePage = document.querySelector('input[name="originalProfilePage"]');
    const renameSection = document.getElementById('renameProfilePageSection');
    const renameCheckbox = document.getElementById('renameProfilePage');
    const renameFrom = document.getElementById('renameFrom');
    const renameTo = document.getElementById('renameTo');

    if (!profilePageInput || !originalProfilePage) return;

    profilePageInput.addEventListener('input', function() {
        const original = (originalProfilePage.value || '').trim();
        const current = this.value.trim();
        if (original && current && original !== current) {
            renameFrom.textContent = original;
            renameTo.textContent = current;
            renameSection.style.display = '';
        } else {
            renameSection.style.display = 'none';
            renameCheckbox.checked = false;
        }
    });
})();

// Client-side password confirmation validation
document.getElementById('confirmPassword')?.addEventListener('input', function() {
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = this.value;
    
    if (newPassword && confirmPassword && newPassword !== confirmPassword) {
        this.setCustomValidity('Passwords do not match');
    } else {
        this.setCustomValidity('');
    }
});

// Clear password fields if one is filled but not the others
document.getElementById('newPassword')?.addEventListener('input', function() {
    const currentPassword = document.getElementById('currentPassword');
    const confirmPassword = document.getElementById('confirmPassword');
    
    if (this.value && !currentPassword.value) {
        currentPassword.setCustomValidity('Current password required when changing password');
    } else {
        currentPassword.setCustomValidity('');
    }
});

document.getElementById('currentPassword')?.addEventListener('input', function() {
    if (this.value) {
        this.setCustomValidity('');
    }
});

// Reset preferences to defaults
function resetPreferences() {
    if (confirm('Are you sure you want to reset all preferences to their default values?')) {
        // Uncheck all checkboxes
        document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
            if (checkbox.name.startsWith('editor.') || checkbox.name.startsWith('display.')) {
                checkbox.checked = false;
            }
        });
        
        // Reset select boxes to default values
        document.getElementById('editorTheme').value = 'default';
        document.getElementById('pageSize').value = '25';
        document.getElementById('dateFormat').value = 'default';
        document.getElementById('siteTheme').value = 'system';
    }
}

// Theme preference integration
document.addEventListener('DOMContentLoaded', function() {
    const siteThemeSelect = document.getElementById('siteTheme');
    
    if (siteThemeSelect && window.themeManager) {
        // Set initial value from theme manager
        const currentTheme = window.themeManager.currentTheme || 'system';
        siteThemeSelect.value = currentTheme;
        
        // Listen for changes and apply immediately
        siteThemeSelect.addEventListener('change', function() {
            if (window.themeManager) {
                window.themeManager.setTheme(this.value);
            }
        });
        
        // Listen for theme changes from other sources (like the toggle button)
        window.addEventListener('themeChanged', function(e) {
            if (e.detail && e.detail.theme !== siteThemeSelect.value) {
                siteThemeSelect.value = e.detail.theme;
            }
        });
    }
});

// Smart pairs demonstration
document.getElementById('smartPairs')?.addEventListener('change', function() {
    const demo = document.getElementById('smartPairsDemo');
    if (demo) {
        demo.textContent = this.checked ? 'Smart pairs enabled!' : 'Smart pairs disabled';
        demo.className = this.checked ? 'text-success' : 'text-muted';
    }
});

// Locale and date/time preview functionality
function updateDateTimePreview() {
    const locale = document.getElementById('locale')?.value || 'en-US';
    const timeFormat = document.querySelector('input[name="preferences.timeFormat"]:checked')?.value || '12h';
    const timezone = document.getElementById('timezone')?.value || 'UTC';
    const dateFormat = document.getElementById('dateFormat')?.value || 'auto';

    const now = new Date();

    // Update date preview
    const datePreview = document.getElementById('datePreview');
    if (datePreview) {
        try {
            if (dateFormat === 'auto') {
                // Use browser's locale formatting
                datePreview.textContent = now.toLocaleDateString(locale);
            } else {
                // Use custom format - simplified formatting for preview
                datePreview.textContent = formatDateWithPattern(now, dateFormat, locale, timeFormat);
            }
        } catch (error) {
            datePreview.textContent = now.toLocaleDateString('en-US');
        }
    }

    // Update time preview
    const timePreview = document.getElementById('timePreview');
    if (timePreview) {
        try {
            const options = {
                hour12: timeFormat === '12h',
                timeZone: timezone === 'UTC' ? 'UTC' : timezone
            };
            timePreview.textContent = now.toLocaleTimeString(locale, options);
        } catch (error) {
            const options = {
                hour12: timeFormat === '12h',
                timeZone: 'UTC'
            };
            timePreview.textContent = now.toLocaleTimeString('en-US', options);
        }
    }
}

// Simple date formatting for preview
function formatDateWithPattern(date, pattern, locale, timeFormat) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');

    switch (pattern) {
        case 'MM/dd/yyyy':
            return `${month}/${day}/${year}`;
        case 'dd/MM/yyyy':
            return `${day}/${month}/${year}`;
        case 'dd.MM.yyyy':
            return `${day}.${month}.${year}`;
        case 'yyyy/MM/dd':
            return `${year}/${month}/${day}`;
        case 'yyyy-MM-dd':
            return `${year}-${month}-${day}`;
        case 'yyyy-MM-dd HH:mm':
            return `${year}-${month}-${day} ${hours}:${minutes}`;
        default:
            return date.toLocaleDateString(locale);
    }
}

// Add event listeners for live preview
document.addEventListener('DOMContentLoaded', function() {
    // Initial preview update
    updateDateTimePreview();

    // Update preview when settings change
    document.getElementById('locale')?.addEventListener('change', updateDateTimePreview);
    document.getElementById('timezone')?.addEventListener('change', updateDateTimePreview);
    document.getElementById('dateFormat')?.addEventListener('change', updateDateTimePreview);
    document.querySelectorAll('input[name="preferences.timeFormat"]').forEach(radio => {
        radio.addEventListener('change', updateDateTimePreview);
    });

    // Update preview every 30 seconds to keep time current
    setInterval(updateDateTimePreview, 30000);
});
</script>

<% if (typeof delegations !== 'undefined' && typeof agentTokensEnabled !== 'undefined' && agentTokensEnabled) { %>
<script nonce="<%= locals.cspNonce %>">
// #946 / #1764: minting an agent token. The secret is only ever in the one-time
// mint response, never rendered server-side into the page; the list itself is
// rendered by the server (_delegations), so Done reloads to show the new row.
(function () {
    const CSRF = '<%= csrfToken %>';
    const form     = document.getElementById('agent-token-form');
    const newBtn   = document.getElementById('agent-token-new-btn');
    const resultEl = document.getElementById('agent-token-result');
    const secretEl = document.getElementById('agent-token-secret');
    const errorEl  = document.getElementById('agent-token-error');
    if (!form) return;

    function showError(message) {
        errorEl.textContent = message;
        errorEl.classList.remove('d-none');
    }

    newBtn?.addEventListener('click', () => {
        form.classList.toggle('d-none');
        errorEl.classList.add('d-none');
        if (!form.classList.contains('d-none')) document.getElementById('agent-token-name').focus();
    });

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('d-none');
        const btn = document.getElementById('agent-token-create-btn');
        btn.disabled = true;
        try {
            const res = await fetch('/api/tokens', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
                body: JSON.stringify({
                    name: document.getElementById('agent-token-name').value,
                    // The picker offers combined options ("page-ingest,page-rename"),
                    // so split rather than sending one comma-joined string as a single scope.
                    scopes: document.getElementById('agent-token-scopes').value.split(','),
                    ttlHours: Number(document.getElementById('agent-token-ttl').value) || undefined
                })
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) {
                showError(data.error || ('Could not create token (HTTP ' + res.status + ')'));
                return;
            }
            secretEl.value = data.token;
            resultEl.classList.remove('d-none');
            form.classList.add('d-none');
            document.getElementById('agent-token-name').value = '';
        } catch (err) {
            showError('Could not create token.');
        } finally {
            btn.disabled = false;
        }
    });

    document.getElementById('agent-token-copy-btn')?.addEventListener('click', async () => {
        secretEl.select();
        try { await navigator.clipboard.writeText(secretEl.value); } catch { document.execCommand('copy'); }
    });

    // The secret leaves the page with the reload; the new token is then in the list.
    document.getElementById('agent-token-done-btn')?.addEventListener('click', () => {
        secretEl.value = '';
        window.location.reload();
    });

    // #1734: Extend keeps the token and its permissions; only the end date moves.
    // Step-up: the route answers with a reauth link, which is followed.
    document.querySelectorAll('[data-extend-token]').forEach((btn) => {
        btn.addEventListener('click', async () => {
            btn.disabled = true;
            try {
                const res = await fetch('/api/tokens/' + encodeURIComponent(btn.dataset.extendToken) + '/extend', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
                    body: '{}'
                });
                const data = await res.json().catch(() => ({}));
                if (data.reauth) { window.location.href = data.reauth; return; }
                if (!res.ok || !data.success) {
                    window.alert(data.error || ('Could not extend the token (HTTP ' + res.status + ')'));
                    btn.disabled = false;
                    return;
                }
                window.location.reload();
            } catch (err) {
                btn.disabled = false;
            }
        });
    });
})();
</script>
<% } %>

<%# #1517: delete an unused vault file, through the attachment door. %>
<script nonce="<%= locals.cspNonce %>">
(function () {
  document.querySelectorAll('[data-delete-unused]').forEach(function (button) {
    button.addEventListener('click', async function () {
      const id = button.getAttribute('data-delete-unused');
      if (!window.confirm('Delete "' + button.getAttribute('data-name') + '" for good? No page in its vault uses it.')) return;
      button.disabled = true;
      const response = await window.csrfFetch('/attachments/' + encodeURIComponent(id), { method: 'DELETE', credentials: 'same-origin' });
      if (response.ok) {
        const row = document.querySelector('[data-unused-file="' + CSS.escape(id) + '"]');
        if (row) row.remove();
      } else {
        button.disabled = false;
        window.alert('The file could not be deleted.');
      }
    });
  });
})();
</script>

