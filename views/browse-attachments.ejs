<%- include('header', { pageName: '' }) %>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="fas fa-search"></i> <%= typeof title !== 'undefined' && title ? title : 'Search' %></h1>
                <button class="btn btn-secondary" onclick="history.back()">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
            </div>

            <%- include('_asset-picker', {
                assetPickerMode:        'page',
                assetPickerInsert:      false,
                assetPickerPageName:    undefined,
                assetPickerInitQuery:   typeof assetPickerInitQuery   !== 'undefined' ? assetPickerInitQuery   : '',
                assetPickerInitSource:  typeof assetPickerInitSource  !== 'undefined' ? assetPickerInitSource  : '',
                assetPickerInitMime:    typeof assetPickerInitMime    !== 'undefined' ? assetPickerInitMime    : '',
                assetPickerInitFilters: typeof assetPickerInitFilters !== 'undefined' ? assetPickerInitFilters : {},
                assetPickerUserKeywords:   typeof assetPickerUserKeywords   !== 'undefined' ? assetPickerUserKeywords   : [],
                assetPickerSystemKeywords: typeof assetPickerSystemKeywords !== 'undefined' ? assetPickerSystemKeywords : [],
                assetPickerYears:          typeof assetPickerYears          !== 'undefined' ? assetPickerYears          : []
            }) %>
        </div>
    </div>
</div>

<%- include('footer') %>
