<%# #1541: the header line of a collapsible card, the one /admin's Share Manager card uses.
    Goes first inside the card's <details>; the card's content follows in a <div class="mt-3">.
    The title is an h6, the heading /profile's cards had before, so the page keeps its outline.
    Locals: icon (a Font Awesome name such as 'fa-key'), title, and optionally hint (muted text),
    badge (text pushed right), badgeClass (default 'bg-secondary'), helpSlug and helpLabel (a help link),
    hintTime (#2470: an ISO time shown after the hint, in the viewer's own time zone by /js/local-time.js),
    chevron (#2470: true puts a chevron after the badge that turns when the card is open; off by default). %>
<summary class="card-summary">
    <i class="fas <%= icon %>" aria-hidden="true"></i>
    <h6 class="mb-0 fw-bold"><%= title %></h6>
    <% if (typeof helpSlug !== 'undefined' && helpSlug) { %><%- include('_help-icon', { slug: helpSlug, label: typeof helpLabel !== 'undefined' && helpLabel ? helpLabel : title }) %><% } %>
    <% const _hasTime = typeof hintTime !== 'undefined' && hintTime; %>
    <% if ((typeof hint !== 'undefined' && hint) || _hasTime) { %><span class="text-muted small"><%= typeof hint !== 'undefined' && hint ? hint : '' %><% if (_hasTime) { %> <time datetime="<%= hintTime %>" data-local-time><%= String(hintTime).slice(0, 16).replace('T', ' ') %> UTC</time><% } %></span><% } %>
    <% if (typeof badge !== 'undefined' && badge !== null && badge !== '') { %><span class="badge <%= typeof badgeClass !== 'undefined' && badgeClass ? badgeClass : 'bg-secondary' %> ms-auto"><%= badge %></span><% } %>
    <% if (typeof chevron !== 'undefined' && chevron) { %><i class="fas fa-chevron-down card-summary-chevron <%= (typeof badge !== 'undefined' && badge !== null && badge !== '') ? 'ms-1' : 'ms-auto' %>" aria-hidden="true"></i><% } %>
</summary>
