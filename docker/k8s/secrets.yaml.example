# ngdpbase Kubernetes Secrets (example)
# IMPORTANT: Do NOT commit this file with real secrets!
#
# Pairs with configmap-env.yaml — mounted via `envFrom: secretRef:` in
# deployment.yaml. Keys here become environment variables inside the pod.
#
# Usage:
#   1. Copy:           cp secrets.yaml.example secrets.yaml
#   2. Generate:       openssl rand -base64 32
#   3. Edit:           paste into NGDPBASE_SESSION_SECRET below
#   4. Apply:          kubectl apply -f secrets.yaml
#
# Or one-liner via kubectl:
#   kubectl create secret generic ngdpbase-secrets \
#     --from-literal=NGDPBASE_SESSION_SECRET=$(openssl rand -base64 32)
#
# For GitOps repos, SOPS-encrypt the file (or use a secretGenerator in
# kustomization.yaml that reads from SOPS-managed source files).
apiVersion: v1
kind: Secret
metadata:
  name: ngdpbase-secrets
  labels:
    app: ngdpbase
    app.kubernetes.io/name: ngdpbase
type: Opaque
# stringData lets you paste raw values; k8s base64-encodes them on apply.
# Use `data:` (base64-encoded values) if your tooling requires it.
stringData:
  # Session signing secret. Generate once: `openssl rand -base64 32`.
  # MUST be stable across pod restarts — without it, ngdpbase generates a
  # fresh secret on each start and every existing cookie's HMAC stops
  # validating, so all logged-in users get bumped to anonymous after
  # any restart. See HEADLESS-DEPLOYMENT-NOTES.md §8.
  #
  # The env-var name MUST be `NGDPBASE_SESSION_SECRET` — that is what
  # ConfigurationManager.ts reads (process.env.NGDPBASE_SESSION_SECRET).
  NGDPBASE_SESSION_SECRET: "change-me-to-a-secure-random-string"

  # Add other sensitive flat env vars here as needed. Examples:
  # OIDC_GOOGLE_CLIENT_SECRET: "..."
  # SMTP_PASSWORD: "..."
  # ELASTICSEARCH_PASSWORD: "..."
